// Копирует только собственный демозаказ. REST должен быть выключен runner-ом.
ИсточникПроверки = ПолучитьСсылкуПоТипуИUUID("Документ", "ЗаказКлиента", "__SOURCE_UUID__");
ФормаПроверки = ПолучитьФорму("Документ.ЗаказКлиента.Форма.ФормаДокумента",
    Новый Структура("ЗначениеКопирования", ИсточникПроверки), , Новый УникальныйИдентификатор);
Если ЗначениеЗаполнено(ФормаПроверки.Объект.Ссылка)
    Или Лев(ФормаПроверки.Объект.Комментарий, 14) <> "STAGE3_NATIVE_"
    Или ФормаПроверки.Объект.Товары.Количество() = 0 Тогда
    ВызватьИсключение "OWN_UNSAVED_COPY_REQUIRED";
КонецЕсли;
ФормаПроверки.Объект.Комментарий = "__MARKER__";
ФормаПроверки.Модифицированность = Истина;
ФормаПроверки.Открыть();
// Штатное копирование очищает обязательную дату отгрузки; заполнить только копию.
ФормаПроверки.Объект.ДатаОтгрузки = НачалоДня(ТекущаяДата());
Для Каждого СтрокаПроверки Из ФормаПроверки.Объект.Товары Цикл
    СтрокаПроверки.ДатаОтгрузки = ФормаПроверки.Объект.ДатаОтгрузки;
КонецЦикла;
ФормаПроверки.Модифицированность = Истина;
Если ФормаПроверки.Расш1_ЗадачаСоздана Или ФормаПроверки.Расш1_НомерЗадачиБ24 <> "" Тогда
    ВызватьИсключение "COPY_INHERITED_LINK";
КонецЕсли;
ФормаПроверки.Расш1_СоздатьЗадачу(Неопределено);
Результат = "STAGE3_NEW_ORDER_COMMAND_RETURNED";
