// Настоящий REST get; собственная демосвязь 10052, занятая задача 10050.
Если Не ПравоДоступа("Администрирование", Метаданные) Или СтрНайти(НРег(СтрокаСоединенияИнформационнойБазы()), "ка демо") = 0 Тогда ВызватьИсключение "DEMO_ONLY"; КонецЕсли;
Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Заказ ИЗ РегистрСведений.Расш1_СвязиЗаказовБ24 ГДЕ ЗадачаId = &ID");
Запрос.УстановитьПараметр("ID", "10052");
Строки = Запрос.Выполнить().Выбрать();
Если Не Строки.Следующий() Тогда ВызватьИсключение "Нет собственной демосвязи10052"; КонецЕсли;
Заказ = Строки.Заказ;
ОбъектПроверки = Заказ.ПолучитьОбъект();
Если Лев(ОбъектПроверки.Комментарий, 14) <> "STAGE3_NATIVE_" Тогда ВызватьИсключение "OWN_ORDER_REQUIRED"; КонецЕсли;
До = Расш1_СервисRESTБ24.СостояниеЗаказа(Заказ);
ВерсияДокумента = Base64Строка(ОбъектПроверки.ВерсияДанных);
Для Каждого ВводПроверки Из СтрРазделить("0,10050", ",") Цикл
    Причина = "";
    Попытка
        Расш1_СервисRESTБ24.ПроверитьКандидата(Заказ, ВводПроверки, До.ВерсияСвязи);
    Исключение
        Причина = Расш1_СервисRESTБ24.БезопаснаяОшибка(ОписаниеОшибки());
    КонецПопытки;
    Если ВводПроверки = "0" Тогда
        Если Причина <> "Неверный ID или ссылка задачи." И Причина <> "Ссылка должна относиться к настроенному порталу Битрикс24." Тогда
            ВызватьИсключение "STAGE3_CANDIDATE_RED: неверный ввод не отклонён";
        КонецЕсли;
    ИначеЕсли Причина <> "Задача уже связана с другим заказом." Тогда
        ВызватьИсключение "STAGE3_CANDIDATE_RED: занятость задачи не отклонена";
    КонецЕсли;
КонецЦикла;
После = Расш1_СервисRESTБ24.СостояниеЗаказа(Заказ);
Если После.ВерсияСвязи <> До.ВерсияСвязи Или После.ЗадачаId <> До.ЗадачаId
    Или После.ОперацияId <> До.ОперацияId Или Base64Строка(Заказ.ПолучитьОбъект().ВерсияДанных) <> ВерсияДокумента Тогда
    ВызватьИсключение "STAGE3_CANDIDATE_RED: отказ изменил заказ или связь";
КонецЕсли;
Результат = "STAGE3_BUSY_CANDIDATE_LIVE_GREEN";
