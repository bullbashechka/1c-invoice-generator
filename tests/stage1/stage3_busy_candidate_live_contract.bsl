// Общий ID разрешён; проверка кандидата не записывает связь или документ.
Если Не ПравоДоступа("Администрирование", Метаданные) Или СтрНайти(НРег(СтрокаСоединенияИнформационнойБазы()), "ка демо") = 0 Тогда ВызватьИсключение "DEMO_ONLY"; КонецЕсли;
Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Заказ ИЗ РегистрСведений.Расш1_СвязиЗаказовБ24 ГДЕ ЗадачаId <> &ID И Заказ.Комментарий ПОДОБНО &Тест");
Запрос.УстановитьПараметр("ID", "10072"); Запрос.УстановитьПараметр("Тест", "STAGE3_%");
Строки = Запрос.Выполнить().Выбрать();
Если Не Строки.Следующий() Тогда ВызватьИсключение "OWN_OTHER_LINK_REQUIRED"; КонецЕсли;
Заказ = Строки.Заказ; До = Расш1_СервисRESTБ24.СостояниеЗаказа(Заказ);
Причина = "";
Попытка Расш1_СервисRESTБ24.ПроверитьКандидата(Заказ, "0", До.ВерсияСвязи);
Исключение Причина = Расш1_СервисRESTБ24.БезопаснаяОшибка(ОписаниеОшибки()); КонецПопытки;
Если Причина <> "Неверный ID или ссылка задачи." И Причина <> "Ссылка должна относиться к настроенному порталу Битрикс24." Тогда
    ВызватьИсключение "STAGE3_CANDIDATE_RED: неверный ввод не отклонён";
КонецЕсли;
Кандидат = Расш1_СервисRESTБ24.ПроверитьКандидата(Заказ, "10072", До.ВерсияСвязи);
Если Кандидат.ЗадачаId <> "10072" Или Не Кандидат.ТребуетсяЗамена Тогда ВызватьИсключение "STAGE3_CANDIDATE_RED: общий ID не принят"; КонецЕсли;
После = Расш1_СервисRESTБ24.СостояниеЗаказа(Заказ);
Если После.ВерсияСвязи <> До.ВерсияСвязи Или После.ЗадачаId <> До.ЗадачаId Или После.ОперацияId <> До.ОперацияId Тогда
    ВызватьИсключение "STAGE3_CANDIDATE_RED: проверка изменила связь";
КонецЕсли;
Результат = "STAGE3_SHARED_CANDIDATE_LIVE_GREEN";
