// Серверный прогон установленного полного модуля, без сети и записи базы.
// Не извлекает тела процедур: первый вызов должен инициализировать весь модуль.
Разбор = Неопределено;
Расш1_RESTБ24Сервер.ПрочитатьОтвет("{""result"":{""task"":{""id"":""10028"",""allowedActions"":{""2"":true}}}}", Разбор);
Если Разбор.Состояние <> "Результат"
    Или Разбор.Данные.Получить("task").Получить("id") <> "10028" Тогда
    ВызватьИсключение "REST_MODULE_RED: полный модуль не разобрал ответ";
КонецЕсли;
Расш1_RESTБ24Сервер.ПрочитатьОтвет("{""result"":[]}", Разбор);
Если Разбор.Состояние <> "Неизвестно" Тогда
    ВызватьИсключение "REST_MODULE_RED: пустой ответ принят как подтверждение";
КонецЕсли;
Расш1_RESTБ24Сервер.ПрочитатьОтвет("{""result"":", Разбор);
Если Разбор.Состояние <> "Неизвестно" Тогда
    ВызватьИсключение "REST_MODULE_RED: поврежденный ответ принят как подтверждение";
КонецЕсли;
Расш1_RESTБ24Сервер.ПрочитатьОтвет("{""error"":""ACCESS_DENIED""}", Разбор);
Если Разбор.Состояние <> "ОшибкаAPI" Или Разбор.КодОшибки <> "ACCESS_DENIED" Тогда
    ВызватьИсключение "REST_MODULE_RED: ошибка API потеряна";
КонецЕсли;
Проверка = Неопределено;
Расш1_RESTБ24Сервер.ПроверитьНастройкиREST(Неопределено, "", Проверка);
Если ПустаяСтрока(Проверка.Ошибка) Или Не ПустаяСтрока(Проверка.Путь) Тогда
    ВызватьИсключение "REST_MODULE_RED: неверная настройка принята";
КонецЕсли;
// Неверный ID должен отклоняться до чтения настройки и обращения к сети.
НеверныйИДОтклонен = Ложь;
Попытка
    Расш1_RESTБ24Сервер.ПрочитатьЗадачуREST(0);
Исключение
    НеверныйИДОтклонен = СтрНайти(ОписаниеОшибки(), "Неверный номер задачи Битрикс24.") > 0;
КонецПопытки;
Если Не НеверныйИДОтклонен Тогда
    ВызватьИсключение "REST_MODULE_RED: неверный ID не отклонен ожидаемой ошибкой";
КонецЕсли;
Результат = "REST_MODULE_CONTRACT_GREEN";
