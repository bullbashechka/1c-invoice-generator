// Параметры заменяет run_order_status_delivery.py. Только авторизованная КА Демо.
// Настройки и синтетическая операция откатываются; документы и Б24 не вызываются.
НачатьТранзакцию();
Попытка
    Настройка = РегистрыСведений.Расш1_НастройкиОбменаБ24.СоздатьМенеджерЗаписи();
    Настройка.Ключ = "enabled"; Настройка.Значение = "true"; Настройка.Записать();
    Настройка = РегистрыСведений.Расш1_НастройкиОбменаБ24.СоздатьМенеджерЗаписи();
    Настройка.Ключ = "baseId"; Настройка.Значение = "__BASE__"; Настройка.Записать();
    Настройка = РегистрыСведений.Расш1_НастройкиОбменаБ24.СоздатьМенеджерЗаписи();
    Настройка.Ключ = "service";
    Настройка.Значение = "{""host"":""127.0.0.1"",""port"":__PORT__,""portal"":""https://demo.example""}";
    Настройка.Секрет = "contract-only-token-0000000000000000"; Настройка.Записать();
    Настройка = РегистрыСведений.Расш1_НастройкиОбменаБ24.СоздатьМенеджерЗаписи();
    Настройка.Ключ = "profile|" + Строка(ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор) + "|STATUS-CONTRACT";
    Настройка.Значение = "{""initiatorId"":""17"",""workplaceId"":""status-contract""}";
    Настройка.Секрет = ""; Настройка.Записать();
    Заказ = Документы.ЗаказКлиента.ПолучитьСсылку(Новый УникальныйИдентификатор("__ORDER__"));
    Операция = РегистрыСведений.Расш1_ОперацииБ24.СоздатьМенеджерЗаписи();
    Операция.Заказ = Заказ; Операция.ОперацияId = "__OPERATION__";
    Операция.ИнициаторId = "17"; Операция.РабочееМестоId = "status-contract"; Операция.Опубликована = "true";
    Для Каждого КодОшибки Из СтрРазделить("link_save_failed,link_conflict,ack_pending", ",") Цикл
        Операция.Состояние = "created"; Операция.Ошибка = КодОшибки; Операция.Записать();
        ДоСбоя = Расш1_ОбменБ24Сервер.ДанныеЗаказа(Заказ).Ошибка;
        Если Расш1_ОбменБ24Сервер.ОбновитьСостояния("STATUS-CONTRACT") <> Операция.ОперацияId Тогда
            ВызватьИсключение "ORDER_DELIVERY_SETUP_FAILED: операция не опрашивается";
        КонецЕсли;
        ПослеСбоя = Расш1_ОбменБ24Сервер.ДанныеЗаказа(Заказ).Ошибка;
        Если ПослеСбоя <> ДоСбоя Тогда
            ВызватьИсключение "ORDER_DELIVERY_RED: сбой чтения затёр локальную причину " + КодОшибки;
        КонецЕсли;
        Расш1_ОбменБ24Сервер.ОбновитьСостояния("STATUS-CONTRACT");
        ПослеВосстановления = Расш1_ОбменБ24Сервер.ДанныеЗаказа(Заказ).Ошибка;
        Если ПослеВосстановления <> ДоСбоя Тогда
            ВызватьИсключение "ORDER_DELIVERY_RED: чтение доставки очистило локальную причину " + КодОшибки;
        КонецЕсли;
    КонецЦикла;
    Связь = РегистрыСведений.Расш1_СвязиЗаказовБ24.СоздатьМенеджерЗаписи();
    Связь.Заказ = Заказ; Связь.ЗадачаId = "2100000102"; Связь.ОперацияId = Операция.ОперацияId; Связь.Записать();
    Операция.Состояние = "acknowledged"; Операция.Ошибка = ""; Операция.Записать();
    ПозднийКонфликт = Расш1_ОбменБ24Сервер.ДанныеЗаказа(Заказ, "STATUS-CONTRACT");
    Если СтрНайти(ПозднийКонфликт.Ошибка, "Найдено несколько задач") = 0 Тогда
        ВызватьИсключение "ORDER_DELIVERY_RED: подтверждённая связь не показывает поздний конфликт";
    КонецЕсли;
    Если ПозднийКонфликт.ЗадачаId <> "2100000102"
        Или ПозднийКонфликт.Ссылка <> "https://demo.example/company/personal/user/17/tasks/task/view/2100000102/" Тогда
        ВызватьИсключение "ORDER_DELIVERY_RED: поздний конфликт скрывает сохранённую связь";
    КонецЕсли;
    ОтменитьТранзакцию();
    Результат = "ORDER_DELIVERY_CONTRACT_GREEN";
Исключение
    ОтменитьТранзакцию(); ВызватьИсключение;
КонецПопытки;
