Данные = Новый Структура("Контрагент,Номер,Дата,Сумма,Валюта", "Тестовый контрагент", "ТД00-000028", "13.07.2017", "117625.00", "KZT");
Название = Расш1_ОперацииRESTБ24.НазваниеНовойЗадачи(Данные);
Если Название <> "Тестовый контрагент. Счета на Оплату №ТД00-000028 от 13.07.2017 на 117 625,00 KZT" Тогда
    ВызватьИсключение "STAGE4_TITLE_RED: нарушен согласованный формат";
КонецЕсли;
Данные.Сумма = "0.00"; Данные.Валюта = "USD";
Если Расш1_ОперацииRESTБ24.НазваниеНовойЗадачи(Данные) <> "Тестовый контрагент. Счета на Оплату №ТД00-000028 от 13.07.2017 на 0,00 USD" Тогда ВызватьИсключение "STAGE4_TITLE_RED: ноль или валюта искажены"; КонецЕсли;
Для Индекс = 1 По 40 Цикл Данные.Контрагент = Данные.Контрагент + " длинное имя"; КонецЦикла;
Полное = Расш1_ОперацииRESTБ24.НазваниеНовойЗадачи(Данные);
Если Лев(Полное, СтрДлина(Данные.Контрагент)) <> Данные.Контрагент Тогда ВызватьИсключение "STAGE4_TITLE_RED: наименование сокращено"; КонецЕсли;
Если Расш1_ОперацииRESTБ24.НазваниеНовойЗадачи(Данные, СтрДлина(Полное)) <> Полное Тогда ВызватьИсключение "STAGE4_TITLE_RED: предел включён неправильно"; КонецЕсли;
Отклонено = Ложь;
Попытка Расш1_ОперацииRESTБ24.НазваниеНовойЗадачи(Данные, СтрДлина(Полное) - 1);
Исключение Отклонено = СтрНайти(ОписаниеОшибки(), "Название задачи превышает проверенный предел") > 0; КонецПопытки;
Если Не Отклонено Тогда ВызватьИсключение "STAGE4_TITLE_RED: проверенный предел проигнорирован"; КонецЕсли;
// Фактически наблюдённая граница сохранения TITLE на целевом портале.
Данные.Контрагент = "";
ДлинаСуффикса = СтрДлина(Расш1_ОперацииRESTБ24.НазваниеНовойЗадачи(Данные));
Для Индекс = 1 По 250 - ДлинаСуффикса Цикл Данные.Контрагент = Данные.Контрагент + "Я"; КонецЦикла;
Если СтрДлина(Расш1_ОперацииRESTБ24.НазваниеНовойЗадачи(Данные, 250)) <> 250 Тогда ВызватьИсключение "STAGE4_TITLE_RED: граница 250 отвергнута"; КонецЕсли;
Данные.Контрагент = Данные.Контрагент + "Я";
Отклонено = Ложь;
Попытка Расш1_ОперацииRESTБ24.НазваниеНовойЗадачи(Данные, 250);
Исключение Отклонено = СтрНайти(ОписаниеОшибки(), "Название задачи превышает проверенный предел") > 0; КонецПопытки;
Если Не Отклонено Тогда ВызватьИсключение "STAGE4_TITLE_RED: 251 символ разрешён"; КонецЕсли;
