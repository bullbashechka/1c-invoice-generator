// Сервер исходного сеанса после slow_start и клиентского ui_contract на том же MCP-порту.
ЧтениеЖурнала = Новый ЧтениеТекста(КаталогИсходников + "/.local/stage-1/rest-background-session.json", КодировкаТекста.UTF8);
ТекстЖурнала = ЧтениеЖурнала.Прочитать(); ЧтениеЖурнала.Закрыть();
ЧтениеJSONЖурнала = Новый ЧтениеJSON; ЧтениеJSONЖурнала.УстановитьСтроку(ТекстЖурнала);
Журнал = ПрочитатьJSON(ЧтениеJSONЖурнала, Истина); ЧтениеJSONЖурнала.Закрыть();
Если Журнал.Получить("Сеанс") <> НомерСеансаИнформационнойБазы() Тогда ВызватьИсключение "REST_SLOW: нужен исходный сеанс."; КонецЕсли;
РезультатФона = ПолучитьИзВременногоХранилища(Журнал.Получить("Адрес"));
Если ТипЗнч(РезультатФона) <> Тип("Структура") Тогда ВызватьИсключение "REST_SLOW: результат пока не получен."; КонецЕсли;
Если РезультатФона.Состояние <> "Результат" Или РезультатФона.ЗадачаID <> "10028"
    Или РезультатФона.Конец - РезультатФона.Начало < 10 Тогда
    ВызватьИсключение "REST_SLOW_RED: длительное фоновое чтение не подтверждено.";
КонецЕсли;
ЧтениеКлиента = Новый ЧтениеТекста(КаталогИсходников + "/.local/stage-1/rest-background-ui.json", КодировкаТекста.UTF8);
ТекстКлиента = ЧтениеКлиента.Прочитать(); ЧтениеКлиента.Закрыть();
ЧтениеJSONКлиента = Новый ЧтениеJSON; ЧтениеJSONКлиента.УстановитьСтроку(ТекстКлиента);
Клиент = ПрочитатьJSON(ЧтениеJSONКлиента, Истина); ЧтениеJSONКлиента.Закрыть();
НачалоКлиента = XMLЗначение(Тип("Дата"), Клиент.Получить("Начало"));
КонецКлиента = XMLЗначение(Тип("Дата"), Клиент.Получить("Конец"));
Если Клиент.Получить("Сеанс") <> НомерСеансаИнформационнойБазы()
    Или Клиент.Получить("Задание") <> Журнал.Получить("Задание")
    Или НачалоКлиента < РезультатФона.Начало Или КонецКлиента >= РезультатФона.Конец
    Или КонецКлиента < НачалоКлиента Или КонецКлиента - НачалоКлиента >= 10 Тогда
    ВызватьИсключение "REST_SLOW_RED: клиентское открытие/закрытие не подтверждено во время задания.";
КонецЕсли;
Результат = Новый Структура("Проверка,ДлительностьФона,ДлительностьКлиента,ЗадачаID",
    "REST_SLOW_BACKGROUND_UI_CONTRACT_GREEN", РезультатФона.Конец - РезультатФона.Начало,
    КонецКлиента - НачалоКлиента, РезультатФона.ЗадачаID);
