// Только КА Демо. Записи регистров откатываются; HTTP и проведение исключены.
Если Не ПравоДоступа("Администрирование", Метаданные) Или СтрНайти(НРег(СтрокаСоединенияИнформационнойБазы()), "ка демо") = 0 Тогда
    ВызватьИсключение "Требуется администратор КА Демо";
КонецЕсли;
Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ.ЗаказКлиента ГДЕ Проведен И НЕ ПометкаУдаления И Ссылка НЕ В (ВЫБРАТЬ Заказ ИЗ РегистрСведений.Расш1_СостояниеЗаказовБ24) И Ссылка НЕ В (ВЫБРАТЬ Заказ ИЗ РегистрСведений.Расш1_СвязиЗаказовБ24)");
Выборка = Запрос.Выполнить().Выбрать();
Если Не Выборка.Следующий() Тогда ВызватьИсключение "Нет проведённого демозаказа для теста"; КонецЕсли;
Заказ = Выборка.Ссылка;
Режим = ПривилегированныйРежим(); УстановитьПривилегированныйРежим(Истина);
НачатьТранзакцию();
Попытка
    Настройка = РегистрыСведений.Расш1_НастройкиОбменаБ24.СоздатьМенеджерЗаписи();
    Настройка.Ключ = "stage2Enabled"; Настройка.Значение = "true"; Настройка.Записать();
    Первая = Расш1_ОперацииRESTБ24.Зарезервировать(Заказ, "test-session");
    Вторая = Расш1_ОперацииRESTБ24.Зарезервировать(Заказ, "other-session");
    Если Первая.Состояние <> "Резерв" Или Первая.ОперацияId <> Вторая.ОперацияId Тогда
        ВызватьИсключение "Повтор не сохранил первую операцию";
    КонецЕсли;
    Журнал = РегистрыСведений.Расш1_ЖурналОперацийБ24.СоздатьМенеджерЗаписи();
    Журнал.ОперацияId = Первая.ОперацияId; Журнал.Прочитать();
    Если Не Журнал.Выбран() Или Журнал.СеансId <> "test-session" Или Журнал.ОтправкаНачата Тогда
        ВызватьИсключение "Нарушен контракт резерва";
    КонецЕсли;
    Снимок = Расш1_RESTБ24Сервер.ДанныеJSON(Журнал.СнимокJSON);
    Поля = Снимок.Получить("fields");
    Если Поля.Получить("XML_ID") <> "KA2:" + Первая.ОперацияId Тогда
        ВызватьИсключение "Маркер не относится к сохранённой операции";
    КонецЕсли;
    Если Не ЗначениеЗаполнено(Поля.Получить("DEADLINE")) Или Журнал.ИнициаторId = "" Тогда
        ВызватьИсключение "Нет сохранённого срока или инициатора";
    КонецЕсли;
    ОтменитьТранзакцию(); УстановитьПривилегированныйРежим(Режим);
Исключение
    ОтменитьТранзакцию(); УстановитьПривилегированныйРежим(Режим);
    ВызватьИсключение;
КонецПопытки;
Результат = Новый Структура("success,cases", Истина, 5);
