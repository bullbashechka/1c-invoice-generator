// Только BSL; синтетические настройки, без сети и записи базы.
Чт = Новый ЧтениеТекста(КаталогИсходников
    + "/src/stage-1-prototype/CommonModules/Расш1_RESTБ24Сервер/Ext/Module.bsl", КодировкаТекста.UTF8);
Исходник = Чт.Прочитать(); Чт.Закрыть();
Нач = СтрНайти(Исходник, "// REST_SETTINGS_BODY_BEGIN");
Кон = СтрНайти(Исходник, "// REST_SETTINGS_BODY_END");
Если Нач = 0 Или Кон <= Нач Тогда ВызватьИсключение "REST_SETTINGS: отсутствует тело процедуры"; КонецЕсли;
Тело = Сред(Исходник, Нач, Кон - Нач);
НоваяОперация = Истина;
Настройки = Новый Соответствие;
Настройки.Вставить("portal", "https://demo.example.invalid");
Настройки.Вставить("groupId", 36);
Настройки.Вставить("creatorId", 26);
Настройки.Вставить("responsibleId", 12);
Наблюдатели = Новый Массив; Наблюдатели.Добавить(28);
Соисполнители = Новый Массив; Соисполнители.Добавить(10);
Настройки.Вставить("accomplices", Соисполнители);
Настройки.Вставить("auditors", Наблюдатели);
Проверка = Неопределено;
Вебхук = "http://demo.example.invalid/rest/30/testkey/";
Выполнить(Тело);
Если ПустаяСтрока(Проверка.Ошибка) Тогда ВызватьИсключение "REST_SETTINGS_RED: принят вебхук без TLS"; КонецЕсли;
Вебхук = "https://other.example.invalid/rest/30/testkey/";
Выполнить(Тело);
Если ПустаяСтрока(Проверка.Ошибка) Тогда ВызватьИсключение "REST_SETTINGS_RED: принят другой портал"; КонецЕсли;
Вебхук = "https://demo.example.invalid/rest/30/testkey/?auth=extra";
Выполнить(Тело);
Если ПустаяСтрока(Проверка.Ошибка) Тогда ВызватьИсключение "REST_SETTINGS_RED: принят вебхук с параметрами"; КонецЕсли;
Вебхук = "https://demo.example.invalid/rest/30/testkey/";
Настройки.Вставить("responsibleId", 0);
Выполнить(Тело);
Если ПустаяСтрока(Проверка.Ошибка) Тогда ВызватьИсключение "REST_SETTINGS_RED: принят нулевой исполнитель"; КонецЕсли;
Настройки.Вставить("responsibleId", 12);
Наблюдатели.Добавить(28);
Выполнить(Тело);
Если ПустаяСтрока(Проверка.Ошибка) Тогда ВызватьИсключение "REST_SETTINGS_RED: приняты повторные наблюдатели"; КонецЕсли;
Наблюдатели[1] = 30;
Выполнить(Тело);
Если Не ПустаяСтрока(Проверка.Ошибка) Или Проверка.Хост <> "demo.example.invalid"
    Или Проверка.Путь <> "/rest/30/testkey/" Тогда
    ВызватьИсключение "REST_SETTINGS_RED: корректные настройки отвергнуты";
КонецЕсли;
Результат = "REST_SETTINGS_CONTRACT_GREEN";
