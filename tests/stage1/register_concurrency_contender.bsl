// Обёртка задаёт Заказ2, ЗадачаIdВторой, Операция2, ПортБарьера, ПутьБарьера.
// Маркер ставится непосредственно перед попыткой записи из второго сеанса.
Соединение = Новый HTTPСоединение("127.0.0.1", ПортБарьера,,,, 5);
Ответ = Соединение.Получить(Новый HTTPЗапрос(ПутьБарьера + "/contender"));
Если Ответ.КодСостояния <> 200 Тогда
    ВызватьИсключение "STAGE1_BARRIER_UNAVAILABLE";
КонецЕсли;
НачатьТранзакцию();
Конфликт = Ложь;
Попытка
    Набор = РегистрыСведений.Расш1_СвязиЗаказовБ24.СоздатьНаборЗаписей();
    Набор.Отбор.Заказ.Установить(Заказ2);
    Связь = Набор.Добавить();
    Связь.Заказ = Заказ2;
    Связь.ЗадачаId = ЗадачаIdВторой;
    Связь.ОперацияId = Операция2;
    Набор.Записать();
    ЗафиксироватьТранзакцию();
Исключение
    ОтменитьТранзакцию();
    Если СтрНайти(ОписаниеОшибки(), "STAGE1_LINK_CONFLICT") = 0 Тогда
        ВызватьИсключение;
    КонецЕсли;
    Конфликт = Истина;
КонецПопытки;
Если Не Конфликт Тогда
    ВызватьИсключение "STAGE1_RED: конкурирующий сеанс принял конфликтующую связь";
КонецЕсли;
Результат = Новый Структура("status,sessionId", "contender_conflict", НомерСеансаИнформационнойБазы());
