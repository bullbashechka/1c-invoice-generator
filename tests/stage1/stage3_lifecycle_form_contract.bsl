// Реальные команды новых форм; ни одна форма не должна записаться.
Для НомерСценария = 1 По 2 Цикл
    ФормаПроверки = ПолучитьФорму("Документ.ЗаказКлиента.Форма.ФормаДокумента", , , Новый УникальныйИдентификатор);
    ФормаПроверки.Открыть();
    ФормаПроверки.Объект.Комментарий = "STAGE3_UNSAVED_LIFECYCLE";
    Если НомерСценария = 1 Тогда
        ФормаПроверки.Объект.ПометкаУдаления = Истина;
    Иначе
        СтрокаПроверки = ФормаПроверки.Объект.Товары.Добавить();
        СтрокаПроверки.Отменено = Истина;
    КонецЕсли;
    ФормаПроверки.Модифицированность = Истина;
    ФормаПроверки.Расш1_СоздатьЗадачу(Неопределено);
    Если ЗначениеЗаполнено(ФормаПроверки.Объект.Ссылка) Или ФормаПроверки.Объект.Проведен Тогда
        ВызватьИсключение "STAGE3_LIFECYCLE_RED: запрещённый заказ записан";
    КонецЕсли;
    Если Не ФормаПроверки.Модифицированность Или ФормаПроверки.Объект.Комментарий <> "STAGE3_UNSAVED_LIFECYCLE" Тогда
        ВызватьИсключение "STAGE3_LIFECYCLE_RED: потеряны правки формы";
    КонецЕсли;
    Если ФормаПроверки.Расш1_ЗадачаСоздана Или ФормаПроверки.Расш1_НомерЗадачиБ24 <> "" Тогда
        ВызватьИсключение "STAGE3_LIFECYCLE_RED: появилась связь";
    КонецЕсли;
    ФормаПроверки.Модифицированность = Ложь;
    ФормаПроверки.Закрыть();
КонецЦикла;
Результат = "STAGE3_LIFECYCLE_GREEN";
