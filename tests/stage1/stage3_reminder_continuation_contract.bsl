// Клиент КА Демо: настоящее штатное проведение/закрытие собственного тестового заказа.
// Проверяет продолжение после ответа, но не физическое нажатие Да/Нет/X/Esc.
Заказ = ПолучитьСсылкуПоТипуИUUID("Документ", "ЗаказКлиента", "__ORDER_UUID__");
До = Расш1_СервисRESTБ24.СостояниеЗаказа(Заказ);
Ответы = Новый Массив; Ответы.Добавить(КодВозвратаДиалога.Да); Ответы.Добавить(КодВозвратаДиалога.Нет);
Для Каждого ОтветПроверки Из Ответы Цикл
    Форма = ПолучитьФорму("Документ.ЗаказКлиента.Форма.ФормаДокумента", Новый Структура("Ключ", Заказ), , Новый УникальныйИдентификатор);
    Если Лев(Форма.Объект.Комментарий, 14) <> "STAGE3_NATIVE_" Тогда ВызватьИсключение "OWN_DEMO_ORDER_REQUIRED"; КонецЕсли;
    Форма.Заголовок = "__FORM_PREFIX__" + Строка(ОтветПроверки);
    Форма.Открыть();
    Форма.Расш1_ОтветНапоминания(ОтветПроверки, Неопределено);
    После = Расш1_СервисRESTБ24.СостояниеЗаказа(Заказ);
    Если После.ЗадачаId <> До.ЗадачаId Или После.ОперацияId <> До.ОперацияId Или После.ВерсияСвязи <> До.ВерсияСвязи Тогда
        ВызватьИсключение "STAGE3_REMINDER_RED: ответ изменил интеграцию";
    КонецЕсли;
КонецЦикла;
Результат = "STAGE3_REMINDER_CONTINUATIONS_REQUESTED";
