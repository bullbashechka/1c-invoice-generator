// Только чтение. UUID подставляет runner после проверки fingerprint демобазы.
// Возвращает хеш всех реквизитов и строк документа, без содержимого документа.
ЗаказПроверки = Документы.ЗаказКлиента.ПолучитьСсылку(Новый УникальныйИдентификатор("__ORDER_UUID__"));
ОбъектПроверки = ЗаказПроверки.ПолучитьОбъект();
Если ОбъектПроверки = Неопределено Тогда ВызватьИсключение "ORDER_NOT_FOUND"; КонецЕсли;
ДанныеСнимка = Новый Массив;
МетаДокумента = ОбъектПроверки.Метаданные();
Для Каждого МетаРеквизита Из МетаДокумента.СтандартныеРеквизиты Цикл
    ДанныеСнимка.Добавить(Новый Структура("Имя,Значение", МетаРеквизита.Имя, ОбъектПроверки[МетаРеквизита.Имя]));
КонецЦикла;
Для Каждого МетаРеквизита Из МетаДокумента.Реквизиты Цикл
    ДанныеСнимка.Добавить(Новый Структура("Имя,Значение", МетаРеквизита.Имя, ОбъектПроверки[МетаРеквизита.Имя]));
КонецЦикла;
Для Каждого МетаТаблицы Из МетаДокумента.ТабличныеЧасти Цикл
    СтрокиСнимка = Новый Массив;
    Для Каждого СтрокаДокумента Из ОбъектПроверки[МетаТаблицы.Имя] Цикл
        РеквизитыСтроки = Новый Массив;
        Для Каждого МетаРеквизита Из МетаТаблицы.Реквизиты Цикл
            РеквизитыСтроки.Добавить(Новый Структура("Имя,Значение", МетаРеквизита.Имя, СтрокаДокумента[МетаРеквизита.Имя]));
        КонецЦикла;
        СтрокиСнимка.Добавить(РеквизитыСтроки);
    КонецЦикла;
    ДанныеСнимка.Добавить(Новый Структура("Имя,Строки", МетаТаблицы.Имя, СтрокиСнимка));
КонецЦикла;
ХешСнимка = Новый ХешированиеДанных(ХешФункция.SHA256);
ХешСнимка.Добавить(ЗначениеВСтрокуВнутр(ДанныеСнимка));
Результат = Новый Структура("dataHash,posted", Строка(ХешСнимка.ХешСумма), ОбъектПроверки.Проведен);
