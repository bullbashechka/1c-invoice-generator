// Клиент исходного сеанса: выполнить сразу после запуска длительного фонового задания.
// Изменяет видимость элемента и закрывает только собственную заранее подготовленную форму.
НачалоКлиента = УниверсальноеВремя(ТекущаяДата());
ЧтениеЖурнала = Новый ЧтениеТекста(КаталогИсходников + "/.local/stage-1/rest-background-session.json", КодировкаТекста.UTF8);
ТекстЖурнала = ЧтениеЖурнала.Прочитать(); ЧтениеЖурнала.Закрыть();
ЧтениеJSONЖурнала = Новый ЧтениеJSON; ЧтениеJSONЖурнала.УстановитьСтроку(ТекстЖурнала);
Журнал = ПрочитатьJSON(ЧтениеJSONЖурнала, Истина); ЧтениеJSONЖурнала.Закрыть();
// Серверный метод существующего Toolkit возвращает номер фактического клиентского сеанса.
ОтветСеанса = ВыполнитьКод("Результат = НомерСеансаИнформационнойБазы();");
Если Не ОтветСеанса.success Тогда ВызватьИсключение "REST_UI: номер сеанса не подтверждён."; КонецЕсли;
Если ОтветСеанса.data <> Журнал.Получить("Сеанс") Тогда ВызватьИсключение "REST_UI: требуется исходный клиентский сеанс."; КонецЕсли;
ЧтениеФормы = Новый ЧтениеТекста(КаталогИсходников + "/.local/stage-1/rest-background-form.json", КодировкаТекста.UTF8);
ТекстФормы = ЧтениеФормы.Прочитать(); ЧтениеФормы.Закрыть();
ЧтениеJSONФормы = Новый ЧтениеJSON; ЧтениеJSONФормы.УстановитьСтроку(ТекстФормы);
ЖурналФормы = ПрочитатьJSON(ЧтениеJSONФормы, Истина); ЧтениеJSONФормы.Закрыть();
Если ЖурналФормы.Получить("Сеанс") <> ОтветСеанса.data Тогда ВызватьИсключение "REST_UI: форма принадлежит другому сеансу."; КонецЕсли;
ФормаТеста = ПолучитьФорму("Документ.ЗаказКлиента.Форма.ФормаДокумента", , , Новый УникальныйИдентификатор(ЖурналФормы.Получить("Форма")));
Если Не ФормаТеста.Открыта() Или ФормаТеста.Модифицированность Тогда ВызватьИсключение "REST_UI: нет подготовленной чистой формы."; КонецЕсли;
Если ЗначениеЗаполнено(ФормаТеста.Объект.Ссылка) Или ФормаТеста.Расш1_СостояниеБ24 <> "Заказ ещё не записан." Тогда
    ВызватьИсключение "REST_UI_RED: новая форма не обработала открытие.";
КонецЕсли;
ВидимостьБлока = ФормаТеста.Элементы.Расш1_БлокЗадачаБ24.Видимость;
ФормаТеста.Элементы.Расш1_БлокЗадачаБ24.Видимость = Не ВидимостьБлока;
Если ФормаТеста.Элементы.Расш1_БлокЗадачаБ24.Видимость = ВидимостьБлока Тогда ВызватьИсключение "REST_UI_RED: элемент не обработал изменение видимости."; КонецЕсли;
ФормаТеста.Элементы.Расш1_БлокЗадачаБ24.Видимость = ВидимостьБлока;
ФормаТеста.Закрыть();
Если ФормаТеста.Открыта() Тогда ВызватьИсключение "REST_UI_RED: собственная тестовая форма не закрылась."; КонецЕсли;
КонецКлиента = УниверсальноеВремя(ТекущаяДата());
Если КонецКлиента - НачалоКлиента >= 10 Тогда ВызватьИсключение "REST_UI_RED: клиентский сценарий занял не менее 10 секунд."; КонецЕсли;
ЗаписьКлиента = Новый ЗаписьJSON;
ЗаписьКлиента.ОткрытьФайл(КаталогИсходников + "/.local/stage-1/rest-background-ui.json");
ЗаписатьJSON(ЗаписьКлиента, Новый Структура("Сеанс,Задание,Начало,Конец", ОтветСеанса.data, Журнал.Получить("Задание"),
    XMLСтрока(НачалоКлиента), XMLСтрока(КонецКлиента))); ЗаписьКлиента.Закрыть();
Результат = "REST_BACKGROUND_UI_RESPONDED";
