// Клиентский контекст КА Демо. Открывает новый заказ без записи и проведения.
Форма = ПолучитьФорму("Документ.ЗаказКлиента.Форма.ФормаДокумента");
Форма.Открыть();
Если Форма.Расш1_СостояниеБ24 <> "Заказ ещё не записан." Тогда
    ВызватьИсключение "ORDER_FORM_RED: состояние нового заказа не заполнено в реквизите формы";
КонецЕсли;
Если Форма.Расш1_НомерЗадачиБ24 <> "" Или Форма.Расш1_СсылкаЗадачиБ24 <> ""
    Или Форма.Расш1_ОшибкаБ24 <> "" Тогда
    ВызватьИсключение "ORDER_FORM_RED: новый заказ содержит чужую связь или ошибку";
КонецЕсли;
Результат = "ORDER_FORM_CONTRACT_GREEN";
