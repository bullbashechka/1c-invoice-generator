// Список берётся из исходника; платформа должна принимать каждое право для регистра.
ФайлМодуля = Новый ЧтениеТекста(КаталогИсходников + "/src/stage-1-prototype/CommonModules/Расш1_RESTБ24Сервер/Ext/Module.bsl", КодировкаТекста.UTF8);
ТекстМодуля = ФайлМодуля.Прочитать(); ФайлМодуля.Закрыть();
Маркер = "Для Каждого ИмяПрава Из СтрРазделить(""";
НачалоСписка = СтрНайти(ТекстМодуля, Маркер);
Если НачалоСписка = 0 Тогда ВызватьИсключение "REST_RIGHT_NAMES: список прав не найден."; КонецЕсли;
Хвост = Сред(ТекстМодуля, НачалоСписка + СтрДлина(Маркер));
СписокПрав = Лев(Хвост, СтрНайти(Хвост, """") - 1);
Для Каждого ИмяПрава Из СтрРазделить(СписокПрав, ",") Цикл
    ЗначениеПрава = ПравоДоступа(ИмяПрава, Метаданные.РегистрыСведений.Расш1_НастройкиОбменаБ24);
    Если ТипЗнч(ЗначениеПрава) <> Тип("Булево") Тогда
        ВызватьИсключение "REST_RIGHT_NAMES: право не вернуло Булево.";
    КонецЕсли;
КонецЦикла;
Результат = "REST_SETTINGS_RIGHT_NAMES_CONTRACT_GREEN";
