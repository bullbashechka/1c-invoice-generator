// Выполнять под обычным сотрудником: старые методы не должны читать закрытый регистр настроек.
СостояниеПрототипа = Расш1_ОбменБ24Сервер.СостояниеПрототипа();
Если СостояниеПрототипа.Включен Тогда
    ВызватьИсключение "LEGACY_DISABLED_RED: прежний поток включен";
КонецЕсли;
Если Расш1_ОбменБ24Сервер.Опрос(ИмяКомпьютера(), "legacy-disabled-contract", Истина) Тогда
    ВызватьИсключение "LEGACY_DISABLED_RED: прежний опрос вернул доставку";
КонецЕсли;
Если Расш1_ОбменБ24Сервер.ОбновитьСостояния(ИмяКомпьютера()) <> "" Тогда
    ВызватьИсключение "LEGACY_DISABLED_RED: прежний опрос вернул курсор";
КонецЕсли;
Если Расш1_ОбменБ24Сервер.ПоставитьВОчередь(Документы.ЗаказКлиента.ПустаяСсылка(),
    ИмяКомпьютера(), "legacy-disabled-contract") <> "disabled" Тогда
    ВызватьИсключение "LEGACY_DISABLED_RED: прежняя очередь не отключена";
КонецЕсли;
Результат = "LEGACY_DISABLED_CONTRACT_GREEN";
