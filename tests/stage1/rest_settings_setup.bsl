// Однократная административная настройка КА Демо. Секрет читается локально, не печатается.
// Выполнять в серверном контексте, с КаталогИсходников. Не является пользовательским потоком.
Если Не ПравоДоступа("Администрирование", Метаданные) Тогда
    ВызватьИсключение "Настройка Битрикс24 доступна только администратору.";
КонецЕсли;
Если Метаданные.Имя <> "КомплекснаяАвтоматизацияДляКазахстана" Или Метаданные.Версия <> "2.4.5.18" Тогда
    ВызватьИсключение "REST_SETUP: требуется проверенная КА Демо.";
КонецЕсли;
Если СтрНайти(НРег(СтрокаСоединенияИнформационнойБазы()), "ка демо") = 0 Тогда
    ВызватьИсключение "REST_SETUP: требуется файловая КА Демо.";
КонецЕсли;
ЧтениеСекрета = Новый ЧтениеТекста(КаталогИсходников + "/.local/bitrix24-webhook.txt", КодировкаТекста.UTF8);
ВебхукНастройки = СокрЛП(ЧтениеСекрета.Прочитать());
ЧтениеСекрета.Закрыть();
ДанныеНастройки = Новый Соответствие;
ДанныеНастройки.Вставить("portal", "https://toofirmagem.bitrix24.kz");
ДанныеНастройки.Вставить("groupId", 36);
ДанныеНастройки.Вставить("creatorId", 26);
ДанныеНастройки.Вставить("responsibleId", 12);
НаблюдателиНастройки = Новый Массив;
НаблюдателиНастройки.Добавить(28);
НаблюдателиНастройки.Добавить(30);
ДанныеНастройки.Вставить("auditors", НаблюдателиНастройки);
СоисполнителиНастройки = Новый Массив; СоисполнителиНастройки.Добавить(10);
ДанныеНастройки.Вставить("accomplices", СоисполнителиНастройки);
ПроверкаНастройки = Неопределено;
Расш1_RESTБ24Сервер.ПроверитьНастройкиREST(ДанныеНастройки, ВебхукНастройки, ПроверкаНастройки);
Если Не ПустаяСтрока(ПроверкаНастройки.Ошибка) Тогда
    ВызватьИсключение ПроверкаНастройки.Ошибка;
КонецЕсли;
ЗаписьНастройкиJSON = Новый ЗаписьJSON;
ЗаписьНастройкиJSON.УстановитьСтроку();
ЗаписатьJSON(ЗаписьНастройкиJSON, ДанныеНастройки);
ТекстНастройкиJSON = ЗаписьНастройкиJSON.Закрыть();
НачатьТранзакцию();
Попытка
    БлокировкаНастройки = Новый БлокировкаДанных;
    ЭлементБлокировкиНастройки = БлокировкаНастройки.Добавить("РегистрСведений.Расш1_НастройкиОбменаБ24");
    ЭлементБлокировкиНастройки.Режим = РежимБлокировкиДанных.Исключительный;
    ЭлементБлокировкиНастройки.УстановитьЗначение("Ключ", "rest");
    БлокировкаНастройки.Заблокировать();
    ЗаписьНастройки = РегистрыСведений.Расш1_НастройкиОбменаБ24.СоздатьМенеджерЗаписи();
    ЗаписьНастройки.Ключ = "rest";
    ЗаписьНастройки.Прочитать();
    Если ЗаписьНастройки.Выбран() Тогда
        ВызватьИсключение "REST_SETUP: настройка rest уже существует; она не перезаписана.";
    КонецЕсли;
    // Прочитать() отсутствующей строки сбрасывает измерения менеджера.
    ЗаписьНастройки.Ключ = "rest";
    ЗаписьНастройки.Значение = ТекстНастройкиJSON;
    ЗаписьНастройки.Секрет = ВебхукНастройки;
    ЗаписьНастройки.Записать();
    ЗафиксироватьТранзакцию();
Исключение
    ОтменитьТранзакцию();
    // Не возвращать диагностические детали, содержащие параметры записи.
    ВызватьИсключение "REST_SETUP: настройка не записана. Проверьте наличие rest и административные права.";
КонецПопытки;
Результат = "REST_SETTINGS_SETUP_COMPLETE";
