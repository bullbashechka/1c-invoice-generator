// Штатная запись/проведение собственных копий в откатываемой транзакции. HTTP нет.
// ИсточникЗаказа и ИсточникРеализации — ссылки только из проверенной КА Демо.
Если Не ПравоДоступа("Администрирование", Метаданные) Или СтрНайти(НРег(СтрокаСоединенияИнформационнойБазы()), "ка демо") = 0 Тогда ВызватьИсключение "DEMO_ONLY"; КонецЕсли;
ВерсияЗаказа = ИсточникЗаказа.ПолучитьОбъект().ВерсияДанных;
ВерсияРеализации = ИсточникРеализации.ПолучитьОбъект().ВерсияДанных;
НачатьТранзакцию();
Попытка
    ЗУ = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Номенклатура ГДЕ НЕ ПометкаУдаления И НЕ ЭтоГруппа И ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)");
    У = ЗУ.Выполнить().Выбрать(); Если Не У.Следующий() Тогда ВызватьИсключение "DEMO_SERVICE_REQUIRED"; КонецЕсли;
    Заказ = ИсточникЗаказа.ПолучитьОбъект().Скопировать(); Заказ.Номер = ""; Заказ.Дата = ИсточникЗаказа.Дата;
    Заказ.Комментарий = "STAGE4_PARTIAL_" + Строка(Новый УникальныйИдентификатор);
    Заказ.Статус = Перечисления.СтатусыЗаказовКлиентов.КОтгрузке; Заказ.ДатаОтгрузки = Заказ.Дата;
    Для Каждого Т Из Заказ.Товары Цикл Т.ДатаОтгрузки = Заказ.Дата; Т.Отменено = Ложь; Т.ПричинаОтмены = Справочники.ПричиныОтменыЗаказовКлиентов.ПустаяСсылка(); КонецЦикла;
    Для Каждого Т Из Заказ.Товары Цикл Т.Номенклатура = У.Ссылка; КонецЦикла;
    Заказ.Записать(РежимЗаписиДокумента.Проведение);
    Реализация = ИсточникРеализации.ПолучитьОбъект().Скопировать(); Реализация.Номер = ""; Реализация.Дата = ИсточникРеализации.Дата;
    Реализация.Комментарий = Заказ.Комментарий;
    Удаляемые = Новый Массив;
    СтрокиИсточника = ИсточникРеализации.ПолучитьОбъект().Товары;
    Для Индекс = 0 По Реализация.Товары.Количество() - 1 Цикл Если СтрокиИсточника[Индекс].ЗаказКлиента <> ИсточникЗаказа Тогда Удаляемые.Добавить(Реализация.Товары[Индекс]); КонецЕсли; КонецЦикла;
    Для Каждого Т Из Удаляемые Цикл Реализация.Товары.Удалить(Т); КонецЦикла;
    Если Реализация.Товары.Количество() = 0 Тогда ВызватьИсключение "MATCHING_REALIZATION_ROWS_REQUIRED"; КонецЕсли;
    Реализация.ЗаказКлиента = Заказ.Ссылка;
    Для Каждого Т Из Реализация.Товары Цикл
        Т.Номенклатура = У.Ссылка; Т.ЗаказКлиента = Заказ.Ссылка; Т.Количество = Т.Количество / 2; Т.КоличествоУпаковок = Т.КоличествоУпаковок / 2;
        Т.Сумма = Т.Сумма / 2; Т.СуммаНДС = Т.СуммаНДС / 2; Т.СуммаСНДС = Т.СуммаСНДС / 2;
    КонецЦикла;
    Реализация.СуммаДокумента = Реализация.Товары.Итог("СуммаСНДС");
    Реализация.Записать(РежимЗаписиДокумента.Проведение);
    Если Не Расш1_ОперацииRESTБ24.ЕстьВыполнениеЗаказа(Заказ.Ссылка) Тогда ВызватьИсключение "PARTIAL_POSTED_FULFILLMENT_REQUIRED"; КонецЕсли;
    Связь = РегистрыСведений.Расш1_СвязиЗаказовБ24.СоздатьМенеджерЗаписи();
    Связь.Заказ = Заказ.Ссылка; Связь.ЗадачаId = "999999993"; Связь.ОперацияId = Строка(Новый УникальныйИдентификатор); Связь.Записать();
    Причины = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.ПричиныОтменыЗаказовКлиентов ГДЕ НЕ ПометкаУдаления");
    В = Причины.Выполнить().Выбрать(); Если Не В.Следующий() Тогда ВызватьИсключение "CANCEL_REASON_REQUIRED"; КонецЕсли;
    Заказ = Заказ.Ссылка.ПолучитьОбъект(); Заказ.Статус = Перечисления.СтатусыЗаказовКлиентов.Закрыт;
    Для Каждого Т Из Заказ.Товары Цикл Т.Отменено = Истина; Т.ПричинаОтмены = В.Ссылка; КонецЦикла;
    Заказ.Записать(РежимЗаписиДокумента.Запись);
    Жизнь = Расш1_ОперацииRESTБ24.ПрочитатьЖизненныйЦикл(Заказ.Ссылка);
    Если Жизнь.Отменен Или Не Жизнь.ЧастичноВыполненСОтменой Тогда ВызватьИсключение "PARTIAL_LIFECYCLE_WRONG"; КонецЕсли;
    З = Новый Запрос("ВЫБРАТЬ СообщениеId, Текст ИЗ РегистрСведений.Расш1_УведомленияБ24 ГДЕ Заказ = &Заказ"); З.УстановитьПараметр("Заказ", Заказ.Ссылка);
    Сообщения = З.Выполнить().Выгрузить();
    Если Сообщения.Количество() <> 1 Или Сообщения[0].Текст <> "Часть позиций отменена. Проверьте связанную задачу №999999993 в Битрикс24" Тогда ВызватьИсключение "PARTIAL_REMINDER_NOT_EXACT"; КонецЕсли;
    Доступно = Ложь;
    Для Каждого С Из Расш1_ОперацииRESTБ24.ПолучитьУведомления() Цикл Если С.СообщениеId = Сообщения[0].СообщениеId Тогда Доступно = Истина; КонецЕсли; КонецЦикла;
    Если Не Доступно Тогда ВызватьИсключение "PARTIAL_REMINDER_NOT_AVAILABLE"; КонецЕсли;
    Расш1_ОперацииRESTБ24.ПодтвердитьПоказ(Сообщения[0].СообщениеId);
    Заказ.Записать(РежимЗаписиДокумента.Запись);
    Если З.Выполнить().Выгрузить().Количество() <> 1 Тогда ВызватьИсключение "PARTIAL_REMINDER_DUPLICATED"; КонецЕсли;
    Если Расш1_ОперацииRESTБ24.ПрочитатьСостояние(Заказ.Ссылка).ЗадачаId <> "999999993" Тогда ВызватьИсключение "PARTIAL_LINK_CHANGED"; КонецЕсли;
    // Без связи повторное закрытие не создаёт напоминания.
    СсылкаКопии = Заказ.Ссылка;
    Связь.Удалить();
    М = РегистрыСведений.Расш1_УведомленияБ24.СоздатьМенеджерЗаписи(); М.СообщениеId = Сообщения[0].СообщениеId; М.Прочитать(); М.Удалить();
    Заказ.Статус = Перечисления.СтатусыЗаказовКлиентов.КОтгрузке; Заказ.Записать(РежимЗаписиДокумента.Запись);
    Заказ.Статус = Перечисления.СтатусыЗаказовКлиентов.Закрыт; Заказ.Записать(РежимЗаписиДокумента.Запись);
    Если З.Выполнить().Выгрузить().Количество() <> 0 Тогда ВызватьИсключение "NO_LINK_PARTIAL_REMINDER"; КонецЕсли;
    ОтменитьТранзакцию();
Исключение ОтменитьТранзакцию(); ВызватьИсключение; КонецПопытки;
// Отклонённая внешняя транзакция не оставляет записанный переход или уведомление.
З.УстановитьПараметр("Заказ", СсылкаКопии);
Если З.Выполнить().Выгрузить().Количество() <> 0 Тогда ВызватьИсключение "ROLLED_BACK_CLOSE_LEFT_REMINDER"; КонецЕсли;
Если ИсточникЗаказа.ПолучитьОбъект().ВерсияДанных <> ВерсияЗаказа Или ИсточникРеализации.ПолучитьОбъект().ВерсияДанных <> ВерсияРеализации Тогда ВызватьИсключение "SOURCE_CHANGED"; КонецЕсли;
Результат = "STAGE4_PARTIAL_LIFECYCLE_GREEN";
