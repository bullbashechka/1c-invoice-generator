// Четыре собственные копии демозаказа, настоящие REST get, все изменения 1С откатываются.
// Не создаёт и не изменяет задачи Б24. Не использовать рабочие объекты как исходную точку.
Если Не ПравоДоступа("Администрирование", Метаданные)
    Или СтрНайти(НРег(СтрокаСоединенияИнформационнойБазы()), "ка демо") = 0 Тогда ВызватьИсключение "DEMO_ONLY"; КонецЕсли;
Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Заказ, ЗадачаId
    |ИЗ РегистрСведений.Расш1_СвязиЗаказовБ24
    |ГДЕ Заказ.Комментарий ПОДОБНО &Тест И ЗадачаId = &ID");
Запрос.УстановитьПараметр("Тест", "STAGE3_%"); Запрос.УстановитьПараметр("ID", "10072"); Пары = Запрос.Выполнить().Выгрузить();
Если Пары.Количество() <> 1 Тогда ВызватьИсключение "OWN_DEMO_TASK_10072_REQUIRED"; КонецЕсли;
Источник = Пары[0].Заказ; ID = Пары[0].ЗадачаId;
ИсходнаяСвязь = Расш1_СервисRESTБ24.СостояниеЗаказа(Источник);
Ответ = Расш1_RESTБ24Сервер.ПрочитатьЗадачуREST(Число(ID));
Если Ответ.Состояние <> "Результат" Тогда ВызватьИсключение "OWN_DEMO_TASK_UNAVAILABLE"; КонецЕсли;
Задача = Ответ.Данные.Получить("task"); СнимокДо = Новый Структура;
Для Каждого Поле Из СтрРазделить("id,title,description,status,deadline,createdBy,responsibleId,groupId,xmlId,accomplices,auditors", ",") Цикл
    СнимокДо.Вставить(Поле, Задача.Получить(Поле));
КонецЦикла;
Заказы = Новый Массив; Операции = Новый Массив; СнимкиЗаказов = Новый Массив;
НачатьТранзакцию();
Попытка
    Для Номер = 1 По 4 Цикл
        Документ = Источник.ПолучитьОбъект().Скопировать();
        Документ.Дата = ТекущаяДата();
        Документ.Комментарий = "SHARED_TASK_" + Строка(Новый УникальныйИдентификатор);
        Документ.Записать(); Заказ = Документ.Ссылка; Заказы.Добавить(Заказ);
        Снимок = Новый Структура;
        Для Каждого Реквизит Из Метаданные.Документы.ЗаказКлиента.СтандартныеРеквизиты Цикл
            Снимок.Вставить(Реквизит.Имя, Документ[Реквизит.Имя]);
        КонецЦикла;
        Для Каждого Реквизит Из Метаданные.Документы.ЗаказКлиента.Реквизиты Цикл
            Снимок.Вставить(Реквизит.Имя, Документ[Реквизит.Имя]);
        КонецЦикла;
        Для Каждого Таблица Из Метаданные.Документы.ЗаказКлиента.ТабличныеЧасти Цикл
            Снимок.Вставить(Таблица.Имя, Документ[Таблица.Имя].Выгрузить());
        КонецЦикла;
        СнимкиЗаказов.Добавить(ЗначениеВСтрокуВнутр(Снимок));
        До = Расш1_СервисRESTБ24.СостояниеЗаказа(Заказ);
        Кандидат = Расш1_СервисRESTБ24.ПроверитьКандидата(Заказ, ID, До.ВерсияСвязи);
        // Без подтверждений завершённого статуса и происхождения.
        Расш1_СервисRESTБ24.ПодтвердитьПривязку(Заказ, Кандидат);
        После = Расш1_СервисRESTБ24.СостояниеЗаказа(Заказ);
        Если После.ЗадачаId <> ID Или После.ВерсияСвязи <> До.ВерсияСвязи + 1 Тогда ВызватьИсключение "SHARED_MANUAL_RED: связь не сохранена"; КонецЕсли;
        Связь = РегистрыСведений.Расш1_СвязиЗаказовБ24.СоздатьМенеджерЗаписи();
        Связь.Заказ = Заказ; Связь.Прочитать();
        Если Операции.Найти(Связь.ОперацияId) <> Неопределено Тогда ВызватьИсключение "SHARED_MANUAL_RED: общая операция"; КонецЕсли;
        Операции.Добавить(Связь.ОперацияId);
    КонецЦикла;
    До = Расш1_СервисRESTБ24.СостояниеЗаказа(Заказы[0]);
    АудитЗапрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ РегистрСведений.Расш1_АудитСвязейБ24 ГДЕ Заказ В (&Заказы)");
    АудитЗапрос.УстановитьПараметр("Заказы", Заказы);
    АудитДо = АудитЗапрос.Выполнить().Выгрузить()[0].Количество;
    Кандидат = Расш1_СервисRESTБ24.ПроверитьКандидата(Заказы[0], ID, До.ВерсияСвязи);
    Расш1_СервисRESTБ24.ПодтвердитьПривязку(Заказы[0], Кандидат);
    После = Расш1_СервисRESTБ24.СостояниеЗаказа(Заказы[0]);
    Если После.ВерсияСвязи <> До.ВерсияСвязи Или АудитЗапрос.Выполнить().Выгрузить()[0].Количество <> АудитДо Тогда
        ВызватьИсключение "SHARED_MANUAL_RED: повтор изменил версию или аудит";
    КонецЕсли;
    Расш1_СервисRESTБ24.ИзменитьСвязь(Заказы[0], "", После.ВерсияСвязи);
    Если Не ПустаяСтрока(Расш1_СервисRESTБ24.СостояниеЗаказа(Заказы[0]).ЗадачаId) Тогда ВызватьИсключение "SHARED_MANUAL_RED: удаление не выполнено"; КонецЕсли;
    Для Номер = 1 По 3 Цикл
        Если Расш1_СервисRESTБ24.СостояниеЗаказа(Заказы[Номер]).ЗадачаId <> ID Тогда ВызватьИсключение "SHARED_MANUAL_RED: удалена соседняя связь"; КонецЕсли;
    КонецЦикла;
    ТекущаяИсходная = Расш1_СервисRESTБ24.СостояниеЗаказа(Источник);
    Если ТекущаяИсходная.ЗадачаId <> ИсходнаяСвязь.ЗадачаId Или ТекущаяИсходная.ВерсияСвязи <> ИсходнаяСвязь.ВерсияСвязи Тогда
        ВызватьИсключение "SHARED_MANUAL_RED: изменена исходная связь";
    КонецЕсли;
    Для Номер = 0 По Заказы.Количество() - 1 Цикл
        Заказ = Заказы[Номер]; Документ = Заказ.ПолучитьОбъект(); Снимок = Новый Структура;
        Для Каждого Реквизит Из Метаданные.Документы.ЗаказКлиента.СтандартныеРеквизиты Цикл
            Снимок.Вставить(Реквизит.Имя, Документ[Реквизит.Имя]);
        КонецЦикла;
        Для Каждого Реквизит Из Метаданные.Документы.ЗаказКлиента.Реквизиты Цикл
            Снимок.Вставить(Реквизит.Имя, Документ[Реквизит.Имя]);
        КонецЦикла;
        Для Каждого Таблица Из Метаданные.Документы.ЗаказКлиента.ТабличныеЧасти Цикл
            Снимок.Вставить(Таблица.Имя, Документ[Таблица.Имя].Выгрузить());
        КонецЦикла;
        Если ЗначениеВСтрокуВнутр(Снимок) <> СнимкиЗаказов[Номер] Тогда ВызватьИсключение "SHARED_MANUAL_RED: привязка изменила документ"; КонецЕсли;
        Если Заказ.Проведен Тогда ВызватьИсключение "SHARED_MANUAL_RED: привязка провела документ"; КонецЕсли;
    КонецЦикла;
    ОтменитьТранзакцию();
Исключение
    Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли; ВызватьИсключение;
КонецПопытки;
Ответ = Расш1_RESTБ24Сервер.ПрочитатьЗадачуREST(Число(ID));
Если Ответ.Состояние <> "Результат" Тогда ВызватьИсключение "OWN_DEMO_TASK_UNAVAILABLE_AFTER"; КонецЕсли;
Задача = Ответ.Данные.Получить("task"); СнимокПосле = Новый Структура;
Для Каждого Поле Из СтрРазделить("id,title,description,status,deadline,createdBy,responsibleId,groupId,xmlId,accomplices,auditors", ",") Цикл
    СнимокПосле.Вставить(Поле, Задача.Получить(Поле));
КонецЦикла;
Если ЗначениеВСтрокуВнутр(СнимокДо) <> ЗначениеВСтрокуВнутр(СнимокПосле) Тогда ВызватьИсключение "SHARED_MANUAL_RED: задача Б24 изменена"; КонецЕсли;
Результат = Новый Структура("status,orders,sourceTaskStatus", "SHARED_TASK_MANUAL_GREEN", 4, СнимокДо.status);
