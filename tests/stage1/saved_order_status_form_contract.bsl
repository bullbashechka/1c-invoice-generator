// Клиент Toolkit КА Демо, UUID подготовлен серверным чтением в .local.
// Открывает форму без записи, проведения и закрытия пользовательских форм.
ЧтениеСсылки = Новый ЧтениеТекста(КаталогИсходников + "/.local/stage-1/saved-order-form-reference.json", КодировкаТекста.UTF8);
ТекстСсылки = ЧтениеСсылки.Прочитать(); ЧтениеСсылки.Закрыть();
ЧтениеJSONСсылки = Новый ЧтениеJSON; ЧтениеJSONСсылки.УстановитьСтроку(ТекстСсылки);
ДанныеСсылки = ПрочитатьJSON(ЧтениеJSONСсылки, Истина); ЧтениеJSONСсылки.Закрыть();
СсылкаЗаказа = ПолучитьСсылкуПоТипуИUUID("Документ", "ЗаказКлиента", ДанныеСсылки.Получить("Ссылка"));
Если ТипЗнч(СсылкаЗаказа) <> Тип("ДокументСсылка.ЗаказКлиента") Или Не ЗначениеЗаполнено(СсылкаЗаказа) Тогда
    ВызватьИсключение "SAVED_ORDER_FORM: требуется сохранённая ссылка заказа.";
КонецЕсли;
Форма = ПолучитьФорму("Документ.ЗаказКлиента.Форма.ФормаДокумента",
    Новый Структура("Ключ", СсылкаЗаказа), , Новый УникальныйИдентификатор);
Форма.Открыть();
Если Форма.Объект.Ссылка <> СсылкаЗаказа Или ПустаяСтрока(Форма.Расш1_СостояниеБ24) Тогда
    ВызватьИсключение "SAVED_ORDER_FORM_RED: форма не содержит состояния исходного заказа.";
КонецЕсли;
// Историческая ошибка операции сохраняется; новая ошибка чтения не должна её подменять.
Если Форма.Расш1_СостояниеБ24 <> ДанныеСсылки.Получить("Состояние")
    Или Форма.Расш1_ОшибкаБ24 <> ДанныеСсылки.Получить("Ошибка")
    Или Форма.Расш1_НомерЗадачиБ24 <> ДанныеСсылки.Получить("Номер") Тогда
    ВызватьИсключение "SAVED_ORDER_FORM_RED: форма не сохранила прочитанное локальное состояние.";
КонецЕсли;
Результат = "SAVED_ORDER_FORM_CONTRACT_GREEN";
