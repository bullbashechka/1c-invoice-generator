// Настоящий резерв на проведённом демозаказе. Все изменения откатываются; HTTP нет.
Если Не ПравоДоступа("Администрирование", Метаданные) Или СтрНайти(НРег(СтрокаСоединенияИнформационнойБазы()), "ка демо") = 0 Тогда ВызватьИсключение "DEMO_ONLY"; КонецЕсли;
Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ.ЗаказКлиента ГДЕ Проведен И НЕ ПометкаУдаления И Ссылка НЕ В (ВЫБРАТЬ Заказ ИЗ РегистрСведений.Расш1_СостояниеЗаказовБ24) И Ссылка НЕ В (ВЫБРАТЬ Заказ ИЗ РегистрСведений.Расш1_СвязиЗаказовБ24)");
В = Запрос.Выполнить().Выбрать(); Если Не В.Следующий() Тогда ВызватьИсключение "Нет проведённого демозаказа"; КонецЕсли;
Режим = ПривилегированныйРежим(); УстановитьПривилегированныйРежим(Истина);
НачатьТранзакцию();
Попытка
    Допуск = РегистрыСведений.Расш1_НастройкиОбменаБ24.СоздатьМенеджерЗаписи();
    Допуск.Ключ = "stage2Enabled"; Допуск.Значение = "true"; Допуск.Записать();
    Итог = Расш1_ОперацииRESTБ24.Зарезервировать(В.Ссылка, "stage4-snapshot");
    Журнал = РегистрыСведений.Расш1_ЖурналОперацийБ24.СоздатьМенеджерЗаписи();
    Журнал.ОперацияId = Итог.ОперацияId; Журнал.Прочитать();
    ИсходныйСнимокJSON = Журнал.СнимокJSON;
    Снимок = Расш1_RESTБ24Сервер.ДанныеJSON(ИсходныйСнимокJSON);
    Заказ = Снимок.Получить("order"); Поля = Снимок.Получить("fields");
    Сумма = СтрЗаменить(Формат(Число(Заказ.Получить("Сумма")), "ЧДЦ=2; ЧРД=,; ЧГ=3; ЧРГ= ; ЧН=0,00"), Символ(160), " ");
    Ожидаемое = Заказ.Получить("Контрагент") + ". Счета на Оплату №" + Заказ.Получить("Номер")
        + " от " + Заказ.Получить("Дата") + " на " + Сумма + " " + Заказ.Получить("Валюта");
    Если Поля.Получить("TITLE") <> Ожидаемое Или Журнал.Название <> Ожидаемое Тогда
        ВызватьИсключение "STAGE4_SNAPSHOT_RED: новое название не сохранено в операции и REST-полях";
    КонецЕсли;
    Если ТипЗнч(Поля.Получить("ACCOMPLICES")) <> Тип("Массив") Или Поля.Получить("ACCOMPLICES").Количество() <> 1
        Или Поля.Получить("AUDITORS").Количество() <> 2 Тогда ВызватьИсключение "STAGE4_SNAPSHOT_RED: неверные роли"; КонецЕсли;
    Повтор = Расш1_ОперацииRESTБ24.Зарезервировать(В.Ссылка, "another-session");
    Если Повтор.ОперацияId <> Итог.ОперацияId Тогда ВызватьИсключение "STAGE4_SNAPSHOT_RED: повтор создал новый снимок"; КонецЕсли;
    Журнал.Прочитать();
    Если Журнал.СнимокJSON <> ИсходныйСнимокJSON Или Журнал.ОтправкаНачата Тогда
        ВызватьИсключение "STAGE4_SNAPSHOT_RED: снимок изменён или запрос отправлен";
    КонецЕсли;
    ОтменитьТранзакцию(); УстановитьПривилегированныйРежим(Режим);
Исключение
    ОтменитьТранзакцию(); УстановитьПривилегированныйРежим(Режим); ВызватьИсключение;
КонецПопытки;
Результат = "STAGE4_TASK_SNAPSHOT_CONTRACT_GREEN";
