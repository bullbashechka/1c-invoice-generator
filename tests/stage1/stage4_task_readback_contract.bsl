// Только чтение собственной задачи, созданной новым прогоном. TaskId, ProjectId — входные параметры.
Если Не ПравоДоступа("Администрирование", Метаданные) Или СтрНайти(НРег(СтрокаСоединенияИнформационнойБазы()), "ка демо") = 0 Тогда ВызватьИсключение "DEMO_ONLY"; КонецЕсли;
Если ProjectId <> 36 И ProjectId <> 6 Тогда ВызватьИсключение "STAGE4_PROJECT_NOT_AUTHORIZED"; КонецЕсли;
Запрос = Новый Запрос("ВЫБРАТЬ ОперацияId, Заказ, СнимокJSON, Состояние ИЗ РегистрСведений.Расш1_ЖурналОперацийБ24 ГДЕ ЗадачаId = &ID И Заказ.Комментарий ПОДОБНО &Тест");
Запрос.УстановитьПараметр("ID", TaskId); Запрос.УстановитьПараметр("Тест", "STAGE3_NATIVE_%");
Строки = Запрос.Выполнить().Выгрузить();
Если Строки.Количество() <> 1 Тогда ВызватьИсключение "OWN_UNIQUE_OPERATION_REQUIRED"; КонецЕсли;
Операция = Строки[0];
Если Операция.Состояние <> "Завершена" Тогда ВызватьИсключение "OPERATION_NOT_COMPLETED"; КонецЕсли;
Поля = Расш1_RESTБ24Сервер.ДанныеJSON(Операция.СнимокJSON).Получить("fields");
Ответ = Расш1_RESTБ24Сервер.ПрочитатьЗадачуREST(Число(TaskId));
Если Ответ.Состояние <> "Результат" Тогда ВызватьИсключение "TASK_READ_NOT_CONFIRMED"; КонецЕсли;
Задача = Ответ.Данные.Получить("task");
Если Задача.Получить("title") <> Поля.Получить("TITLE") Или Задача.Получить("description") <> Поля.Получить("DESCRIPTION")
    Или Задача.Получить("xmlId") <> Поля.Получить("XML_ID") Тогда ВызватьИсключение "STAGE4_READBACK: данные не совпали со снимком"; КонецЕсли;
Если Число(Задача.Получить("createdBy")) <> 26 Или Число(Задача.Получить("responsibleId")) <> 12
    Или Число(Задача.Получить("groupId")) <> ProjectId Тогда ВызватьИсключение "STAGE4_READBACK: роли или проект не совпали"; КонецЕсли;
Наблюдатели = Задача.Получить("auditors"); Соисполнители = Задача.Получить("accomplices");
Если ТипЗнч(Наблюдатели) <> Тип("Массив") Или ТипЗнч(Соисполнители) <> Тип("Массив") Тогда ВызватьИсключение "STAGE4_READBACK: неверный формат участников"; КонецЕсли;
Если Наблюдатели.Количество() <> 2 Или Наблюдатели.Найти("28") = Неопределено Или Наблюдатели.Найти("30") = Неопределено
    Или Соисполнители.Количество() <> 1 Или Соисполнители.Найти("10") = Неопределено Тогда ВызватьИсключение "STAGE4_READBACK: состав участников не совпал"; КонецЕсли;
Срок = Поля.Получить("DEADLINE");
СрокUTC = Дата(Число(Лев(Срок, 4)), Число(Сред(Срок, 6, 2)), Число(Сред(Срок, 9, 2)), 14, 0, 0);
Если Расш1_RESTБ24Сервер.СрокЗадачиИстек(Задача, СрокUTC) Или Не Расш1_RESTБ24Сервер.СрокЗадачиИстек(Задача, СрокUTC + 1) Тогда ВызватьИсключение "STAGE4_READBACK: срок не совпал"; КонецЕсли;
Состояние = Расш1_ОперацииRESTБ24.ПрочитатьСостояние(Операция.Заказ);
Если Состояние.ЗадачаId <> TaskId Или Состояние.Состояние <> "Связана" Тогда ВызватьИсключение "STAGE4_READBACK: связь не совпала"; КонецЕсли;
Результат = "STAGE4_TASK_READBACK_GREEN";
