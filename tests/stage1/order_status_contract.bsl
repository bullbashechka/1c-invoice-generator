// Только КА Демо. Все записи синтетические и откатываются одной транзакцией.
// Не вызывает Б24, не записывает и не проводит документы.
НачатьТранзакцию();
Попытка
    Заказ = Документы.ЗаказКлиента.ПолучитьСсылку(Новый УникальныйИдентификатор);
    Операция = РегистрыСведений.Расш1_ОперацииБ24.СоздатьМенеджерЗаписи();
    Операция.Заказ = Заказ;
    Операция.ОперацияId = Строка(Новый УникальныйИдентификатор);
    Операция.ИнициаторId = "17";
    Операция.Состояние = "unknown";
    Операция.Записать();
    Если СтрНайти(Расш1_ОбменБ24Сервер.СтатусЗаказа(Заказ), "Проверяем, создана ли задача") = 0 Тогда
        ВызватьИсключение "ORDER_STATUS_RED: неизвестный результат показан техническим кодом";
    КонецЕсли;

    Данные = Расш1_ОбменБ24Сервер.ДанныеЗаказа(Заказ);
    Если Не Данные.СозданиеЗаблокировано Или Данные.ЗадачаId <> "" Или Данные.Ссылка <> "" Тогда
        ВызватьИсключение "ORDER_STATUS_RED: неизвестный результат разрешает создание или показывает связь";
    КонецЕсли;
    Операция.Ошибка = "Bearer secret-must-not-be-shown";
    Операция.Записать();
    Данные = Расш1_ОбменБ24Сервер.ДанныеЗаказа(Заказ);
    Если СтрНайти(Данные.Ошибка, "secret") > 0 Или ПустаяСтрока(Данные.Ошибка) Тогда
        ВызватьИсключение "ORDER_STATUS_RED: неизвестная диагностика не очищена";
    КонецЕсли;

    Для Каждого Состояние Из СтрРазделить("queued,claimed,opening,opened,created,acknowledged,cancelled", ",") Цикл
        Операция.Состояние = Состояние; Операция.Ошибка = ""; Операция.Записать();
        Данные = Расш1_ОбменБ24Сервер.ДанныеЗаказа(Заказ);
        Если ПустаяСтрока(Данные.Состояние) Или Данные.Состояние = Состояние Или Данные.Ссылка <> "" Тогда
            ВызватьИсключение "ORDER_STATUS_RED: состояние не переведено либо неточная связь";
        КонецЕсли;
        Если Состояние <> "cancelled" И Не Данные.СозданиеЗаблокировано Тогда
            ВызватьИсключение "ORDER_STATUS_RED: незавершённая операция допускает новое создание";
        КонецЕсли;
    КонецЦикла;

    Настройка = РегистрыСведений.Расш1_НастройкиОбменаБ24.СоздатьМенеджерЗаписи();
    Настройка.Ключ = "service";
    Настройка.Значение = "{""portal"":""https://demo.example""}";
    Настройка.Записать();
    Связь = РегистрыСведений.Расш1_СвязиЗаказовБ24.СоздатьМенеджерЗаписи();
    Связь.Заказ = Заказ; Связь.ЗадачаId = "2100000101"; Связь.ОперацияId = Операция.ОперацияId; Связь.Записать();
    Операция.Состояние = "unknown"; Операция.Ошибка = "task_access_denied"; Операция.Записать();
    Данные = Расш1_ОбменБ24Сервер.ДанныеЗаказа(Заказ);
    Если Данные.ЗадачаId <> "2100000101"
        Или Данные.Ссылка <> "https://demo.example/company/personal/user/17/tasks/task/view/2100000101/"
        Или Не Данные.СозданиеЗаблокировано Или ПустаяСтрока(Данные.Ошибка) Тогда
        ВызватьИсключение "ORDER_STATUS_RED: сохранённая связь скрыта ошибкой или адрес неверен";
    КонецЕсли;
    Настройка.Значение = "{broken"; Настройка.Записать();
    Данные = Расш1_ОбменБ24Сервер.ДанныеЗаказа(Заказ);
    Если Данные.ЗадачаId <> "2100000101" Или Данные.Ссылка <> "" Или ПустаяСтрока(Данные.Ошибка) Тогда
        ВызватьИсключение "ORDER_STATUS_RED: повреждённые настройки скрывают номер или дают опасный адрес";
    КонецЕсли;
    Настройка.Значение = "{""portal"":""https://demo.example@other.example""}"; Настройка.Записать();
    Данные = Расш1_ОбменБ24Сервер.ДанныеЗаказа(Заказ);
    Если Данные.Ссылка <> "" Тогда ВызватьИсключение "ORDER_STATUS_RED: принят адрес с userinfo"; КонецЕсли;
    НовыйЗаказ = Документы.ЗаказКлиента.ПустаяСсылка();
    Данные = Расш1_ОбменБ24Сервер.ДанныеЗаказа(НовыйЗаказ);
    Если Данные.Состояние <> "Заказ ещё не записан." Или Данные.Ссылка <> "" Тогда
        ВызватьИсключение "ORDER_STATUS_RED: новый заказ показывает чужое состояние";
    КонецЕсли;
    ОтменитьТранзакцию();
    Результат = "ORDER_STATUS_CONTRACT_GREEN";
Исключение
    ОтменитьТранзакцию();
    ВызватьИсключение;
КонецПопытки;
