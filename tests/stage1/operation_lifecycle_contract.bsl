// Собственная копия заказа и синтетическая связь в откатываемой транзакции. REST нет.
Если Не ПравоДоступа("Администрирование", Метаданные) Или СтрНайти(НРег(СтрокаСоединенияИнформационнойБазы()), "ка демо") = 0 Тогда ВызватьИсключение "DEMO_ONLY"; КонецЕсли;
Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ.ЗаказКлиента ГДЕ Проведен И НЕ ПометкаУдаления И Ссылка НЕ В (ВЫБРАТЬ Заказ ИЗ РегистрСведений.Расш1_СостояниеЗаказовБ24) И Ссылка НЕ В (ВЫБРАТЬ Заказ ИЗ РегистрСведений.Расш1_СвязиЗаказовБ24)");
Строки = Запрос.Выполнить().Выбрать(); Если Не Строки.Следующий() Тогда ВызватьИсключение "Нет демозаказа"; КонецЕсли;
Исходное = Строки.Ссылка;
// До установки объектного обработчика этот контракт должен обнаружить отсутствие метода.
Расш1_ОперацииRESTБ24.ПрочитатьЖизненныйЦикл(Исходное);
Режим = ПривилегированныйРежим(); УстановитьПривилегированныйРежим(Истина);
НачатьТранзакцию();
Попытка
    Заказ = Исходное.ПолучитьОбъект().Скопировать();
    Заказ.Дата = ТекущаяДата();
    Для Каждого СтрокаТовара Из Заказ.Товары Цикл СтрокаТовара.Отменено = Ложь; КонецЦикла;
    Если Заказ.Товары.Количество() = 0 Тогда ВызватьИсключение "Для теста нужны строки товаров"; КонецЕсли;
    Заказ.Записать();
    Связь = РегистрыСведений.Расш1_СвязиЗаказовБ24.СоздатьМенеджерЗаписи();
    Связь.Заказ = Заказ.Ссылка; Связь.ЗадачаId = "999999992"; Связь.ОперацияId = Строка(Новый УникальныйИдентификатор); Связь.Записать();
    ЗапросПричины = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.ПричиныОтменыЗаказовКлиентов ГДЕ НЕ ПометкаУдаления");
    Причины = ЗапросПричины.Выполнить().Выбрать(); Если Не Причины.Следующий() Тогда ВызватьИсключение "Нет причины отмены для теста"; КонецЕсли;
    Для Каждого СтрокаТовара Из Заказ.Товары Цикл
        СтрокаТовара.Отменено = Истина; СтрокаТовара.ПричинаОтмены = Причины.Ссылка;
    КонецЦикла;
    Заказ.Записать();
    Если Расш1_ОперацииRESTБ24.ПолучитьУведомления().Количество() <> 1 Тогда ВызватьИсключение "Нет сообщения после сохранённой отмены"; КонецЕсли;
    Заказ.Записать();
    Если Расш1_ОперацииRESTБ24.ПолучитьУведомления().Количество() <> 1 Тогда ВызватьИсключение "Повторное сохранение породило сообщение"; КонецЕсли;
    Заказ.УстановитьПометкуУдаления(Истина);
    Если Расш1_ОперацииRESTБ24.ПолучитьУведомления().Количество() <> 2 Тогда ВызватьИсключение "Нет сообщения о пометке удаления"; КонецЕсли;
    Если Расш1_ОперацииRESTБ24.ПрочитатьСостояние(Заказ.Ссылка).ЗадачаId <> "999999992" Тогда ВызватьИсключение "Действие изменило связь"; КонецЕсли;
    ОтменитьТранзакцию(); УстановитьПривилегированныйРежим(Режим);
Исключение
    ОтменитьТранзакцию(); УстановитьПривилегированныйРежим(Режим); ВызватьИсключение;
КонецПопытки;
Результат = Новый Структура("success,cases", Истина, 4);
