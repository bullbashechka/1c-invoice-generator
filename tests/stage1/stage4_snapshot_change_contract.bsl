// На собственной реальной операции с известным ID. Для завершённой операции
// фаза до связи воспроизводится внутри откатываемой транзакции; всё восстанавливается.
// ОперацияIdПроверки, Изменение: none/comment/amount/counterparty. HTTP/add нет.
Если Не ПравоДоступа("Администрирование", Метаданные) Или СтрНайти(НРег(СтрокаСоединенияИнформационнойБазы()), "ка демо") = 0 Тогда ВызватьИсключение "DEMO_ONLY"; КонецЕсли;
Ж = РегистрыСведений.Расш1_ЖурналОперацийБ24.СоздатьМенеджерЗаписи(); Ж.ОперацияId = ОперацияIdПроверки; Ж.Прочитать();
Если Не Ж.Выбран() Или (Ж.Состояние <> "ЗадачаИзвестна" И Ж.Состояние <> "Завершена") Или ПустаяСтрока(Ж.ЗадачаId) Или Лев(Ж.Заказ.Комментарий, 14) <> "STAGE3_NATIVE_" Тогда ВызватьИсключение "OWN_KNOWN_OPERATION_REQUIRED"; КонецЕсли;
Если Изменение <> "none" И Изменение <> "comment" И Изменение <> "amount" И Изменение <> "counterparty" Тогда ВызватьИсключение "KNOWN_CHANGE_CASE_REQUIRED"; КонецЕсли;
СостояниеДо = Ж.Состояние; СвязьДо = Расш1_ОперацииRESTБ24.ПрочитатьСостояние(Ж.Заказ);
СнимокДо = Ж.СнимокJSON; ВерсияДо = Ж.Заказ.ПолучитьОбъект().ВерсияДанных;
НачатьТранзакцию();
Попытка
    Если СостояниеДо = "Завершена" Тогда
        Если СвязьДо.Состояние <> "Связана" Или СвязьДо.ЗадачаId <> Ж.ЗадачаId Тогда ВызватьИсключение "OWN_COMPLETED_LINK_REQUIRED"; КонецЕсли;
        Св = РегистрыСведений.Расш1_СвязиЗаказовБ24.СоздатьМенеджерЗаписи(); Св.Заказ = Ж.Заказ; Св.Прочитать(); Св.Удалить();
        Ж.Состояние = "ЗадачаИзвестна"; Ж.Записать();
        У = РегистрыСведений.Расш1_УведомленияБ24.СоздатьМенеджерЗаписи(); У.СообщениеId = Ж.ОперацияId + ":success"; У.Прочитать(); Если У.Выбран() Тогда У.Удалить(); КонецЕсли;
    КонецЕсли;
    О = Ж.Заказ.ПолучитьОбъект();
    Если Изменение = "comment" Тогда О.Комментарий = О.Комментарий + " UNSENT_FIELD"; О.Записать(РежимЗаписиДокумента.Запись); КонецЕсли;
    Если Изменение = "amount" Тогда
        До = О.СуммаДокумента;
        Если О.Товары.Количество() = 0 Тогда ВызватьИсключение "OWN_GOODS_REQUIRED"; КонецЕсли;
        О.Товары[0].Сумма = О.Товары[0].Сумма + 1; О.Товары[0].СуммаСНДС = О.Товары[0].СуммаСНДС + 1;
        О.СуммаДокумента = До + 1; О.Записать(РежимЗаписиДокумента.Запись);
        Если О.Ссылка.СуммаДокумента = До Тогда ВызватьИсключение "AMOUNT_CHANGE_NOT_PERSISTED"; КонецЕсли;
    КонецЕсли;
    Если Изменение = "counterparty" Тогда
        К = О.Контрагент.ПолучитьОбъект().Скопировать(); К.Наименование = "ТЕСТ ЭТАП 4 — изменённый контрагент"; К.Записать();
        О.Контрагент = К.Ссылка; О.Записать(РежимЗаписиДокумента.Запись);
        Если О.Ссылка.Контрагент <> К.Ссылка Тогда ВызватьИсключение "COUNTERPARTY_CHANGE_NOT_PERSISTED"; КонецЕсли;
    КонецЕсли;
    Расш1_ОперацииRESTБ24.ЗаписатьСвязь(Ж.ОперацияId, Ложь);
    С = Расш1_ОперацииRESTБ24.ПрочитатьСостояние(Ж.Заказ); Ж.Прочитать();
    Если С.Состояние <> "Связана" Или Ж.СнимокJSON <> СнимокДо Тогда ВызватьИсключение "IMMUTABLE_SNAPSHOT_OR_LINK_CHANGED"; КонецЕсли;
    З = Новый Запрос("ВЫБРАТЬ Текст ИЗ РегистрСведений.Расш1_УведомленияБ24 ГДЕ СообщениеId = &ID"); З.УстановитьПараметр("ID", Ж.ОперацияId + ":success");
    В = З.Выполнить().Выбрать(); Если Не В.Следующий() Тогда ВызватьИсключение "ONE_SUCCESS_REQUIRED"; КонецЕсли;
    Ожидаемое = "Данные заказа изменились после начала создания. Проверьте данные задачи №" + Ж.ЗадачаId;
    НужнаПроверка = Изменение = "amount" Или Изменение = "counterparty";
    Если НужнаПроверка И СтрНайти(В.Текст, Ожидаемое) = 0 Тогда ВызватьИсключение "STAGE4_CHANGE_RED: нет согласованного предупреждения с ID"; КонецЕсли;
    Если Не НужнаПроверка И СтрНайти(В.Текст, "Данные заказа измен") > 0 Тогда ВызватьИсключение "STAGE4_CHANGE_RED: непередаваемое поле вызвало предупреждение"; КонецЕсли;
    ОтменитьТранзакцию();
Исключение ОтменитьТранзакцию(); ВызватьИсключение; КонецПопытки;
Ж.ОперацияId = ОперацияIdПроверки; Ж.Прочитать();
Если Ж.Состояние <> СостояниеДо Или Ж.СнимокJSON <> СнимокДо Или Ж.Заказ.ПолучитьОбъект().ВерсияДанных <> ВерсияДо Тогда ВызватьИсключение "ROLLBACK_NOT_PRESERVED"; КонецЕсли;
После = Расш1_ОперацииRESTБ24.ПрочитатьСостояние(Ж.Заказ);
Если После.Состояние <> СвязьДо.Состояние Или После.ЗадачаId <> СвязьДо.ЗадачаId Или После.ВерсияСвязи <> СвязьДо.ВерсияСвязи Тогда ВызватьИсключение "ORIGINAL_LINK_NOT_RESTORED"; КонецЕсли;
Результат = "STAGE4_SNAPSHOT_CHANGE_GREEN:" + Изменение;
