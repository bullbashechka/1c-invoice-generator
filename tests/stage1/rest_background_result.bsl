// Выполнить в том же серверном сеансе после rest_background_start.bsl.
ЧтениеЖурналаREST = Новый ЧтениеТекста(КаталогИсходников + "/.local/stage-1/rest-background-session.json", КодировкаТекста.UTF8);
ТекстЖурналаREST = ЧтениеЖурналаREST.Прочитать(); ЧтениеЖурналаREST.Закрыть();
ЧтениеJSONREST = Новый ЧтениеJSON; ЧтениеJSONREST.УстановитьСтроку(ТекстЖурналаREST);
ЖурналФонаREST = ПрочитатьJSON(ЧтениеJSONREST, Истина); ЧтениеJSONREST.Закрыть();
Если ЖурналФонаREST.Получить("Сеанс") <> НомерСеансаИнформационнойБазы() Тогда
    ВызватьИсключение "REST_BACKGROUND: требуется исходный сеанс.";
КонецЕсли;
ЗаданиеREST = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(
    Новый УникальныйИдентификатор(ЖурналФонаREST.Получить("Задание")));
Если ЗаданиеREST = Неопределено Тогда ВызватьИсключение "REST_BACKGROUND: задание не найдено."; КонецЕсли;
СостояниеФонаREST = Строка(ЗаданиеREST.Состояние);
РезультатФонаREST = ПолучитьИзВременногоХранилища(ЖурналФонаREST.Получить("Адрес"));
Если ТипЗнч(РезультатФонаREST) <> Тип("Структура") Тогда
    // Не выводить подробную информацию об ошибке фонового задания.
    ВызватьИсключение "REST_BACKGROUND: результата нет; состояние: " + СостояниеФонаREST;
КонецЕсли;
Если РезультатФонаREST.Состояние <> "Результат" Или РезультатФонаREST.ЗадачаID <> "10028" Тогда
    ВызватьИсключение "REST_BACKGROUND: чтение не подтвердило исходную задачу.";
КонецЕсли;
Если РезультатФонаREST.Количество() <> 4 Тогда
    ВызватьИсключение "REST_BACKGROUND: неожиданный состав результата.";
КонецЕсли;
Результат = Новый Структура("Проверка,Состояние,ЗадачаID,Начало,Конец",
    "REST_BACKGROUND_CONTRACT_GREEN", СостояниеФонаREST, РезультатФонаREST.ЗадачаID,
    РезультатФонаREST.Начало, РезультатФонаREST.Конец);
