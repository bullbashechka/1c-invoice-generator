// Клиентский контракт двух установленных форм. Только чтение, без открытия окон и REST.
РезультатыФорм = Новый Массив;
Для Каждого ИмяФормыПроверки Из СтрРазделить("ФормаСписка,ФормаСпискаДокументов", ",") Цикл
    ФормаПроверки = ПолучитьФорму("Документ.ЗаказКлиента.Форма." + ИмяФормыПроверки, , , Новый УникальныйИдентификатор);
    КолонкаПроверки = ФормаПроверки.Элементы.Найти("Расш1_ЗадачаБ24");
    Если КолонкаПроверки = Неопределено Тогда
        ВызватьИсключение "LIST_FORMS_RED: " + ИмяФормыПроверки + ": отсутствует колонка Б24";
    КонецЕсли;
    Если Не КолонкаПроверки.Видимость Или Не КолонкаПроверки.ТолькоПросмотр Или КолонкаПроверки.Гиперссылка Тогда
        ВызватьИсключение "LIST_FORMS_RED: " + ИмяФормыПроверки + ": нарушен контракт отображения";
    КонецЕсли;
    ПредыдущееИмя = "";
    КоличествоКолонок = 0;
    Для Каждого ЭлементПроверки Из ФормаПроверки.Элементы.Список.ПодчиненныеЭлементы Цикл
        Если ЭлементПроверки.Имя = "Расш1_ЗадачаБ24" Тогда
            КоличествоКолонок = КоличествоКолонок + 1;
            Если ПредыдущееИмя <> "СписокПартнер" Тогда
                ВызватьИсключение "LIST_FORMS_RED: " + ИмяФормыПроверки + ": колонка не после Клиент";
            КонецЕсли;
        КонецЕсли;
        ПредыдущееИмя = ЭлементПроверки.Имя;
    КонецЦикла;
    Если КоличествоКолонок <> 1 Тогда ВызватьИсключение "LIST_FORMS_RED: число колонок"; КонецЕсли;
    РезультатыФорм.Добавить(ИмяФормыПроверки);
КонецЦикла;
Результат = Новый Структура("status,forms", "LIST_FORMS_COLUMN_GREEN", РезультатыФорм);
