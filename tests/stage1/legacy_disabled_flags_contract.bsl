// Только администратор КА Демо. Прежний enabled=true не должен включать удалённый сервис.
// Временная настройка и её исходное значение откатываются до проверки результата.
Если Не ПравоДоступа("Администрирование", Метаданные)
    Или СтрНайти(НРег(СтрокаСоединенияИнформационнойБазы()), "ка демо") = 0 Тогда
    ВызватьИсключение "LEGACY_FLAGS: требуется администратор КА Демо.";
КонецЕсли;
НачатьТранзакцию();
Попытка
    БлокировкаФлага = Новый БлокировкаДанных;
    ЭлементБлокировкиФлага = БлокировкаФлага.Добавить("РегистрСведений.Расш1_НастройкиОбменаБ24");
    ЭлементБлокировкиФлага.Режим = РежимБлокировкиДанных.Исключительный;
    ЭлементБлокировкиФлага.УстановитьЗначение("Ключ", "enabled");
    БлокировкаФлага.Заблокировать();
    ЗаписьФлага = РегистрыСведений.Расш1_НастройкиОбменаБ24.СоздатьМенеджерЗаписи();
    ЗаписьФлага.Ключ = "enabled"; ЗаписьФлага.Значение = "true"; ЗаписьФлага.Записать();
    СостояниеФлага = Расш1_ОбменБ24Сервер.СостояниеПрототипа();
    ОтменитьТранзакцию();
Исключение
    ОтменитьТранзакцию();
    ВызватьИсключение "LEGACY_FLAGS: диагностическая транзакция не выполнена.";
КонецПопытки;
Если СостояниеФлага.Включен Тогда
    ВызватьИсключение "LEGACY_FLAGS_RED: старый enabled=true включает исключённый поток.";
КонецЕсли;
Результат = "LEGACY_DISABLED_FLAGS_CONTRACT_GREEN";
