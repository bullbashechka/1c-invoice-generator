// Клиент КА Демо. UUID подставляется после проверки fingerprint и собственного маркера.
// Открывает отдельную форму с несохранённой правкой. Не записывает и не проводит заказ.
ЗаказПроверки = ПолучитьСсылкуПоТипуИUUID("Документ", "ЗаказКлиента", "__ORDER_UUID__");
СостояниеПроверки = Расш1_СервисRESTБ24.СостояниеЗаказа(ЗаказПроверки);
Если СостояниеПроверки.Состояние <> "Связана" Тогда ВызватьИсключение "LINK_REQUIRED"; КонецЕсли;
ФормаПроверки = ПолучитьФорму("Документ.ЗаказКлиента.Форма.ФормаДокумента", Новый Структура("Ключ", ЗаказПроверки), , Новый УникальныйИдентификатор);
ФормаПроверки.Заголовок = "Проверка отмены нового создания — №" + СостояниеПроверки.ЗадачаId;
ФормаПроверки.Объект.Комментарий = ФормаПроверки.Объект.Комментарий + " STAGE3_RECREATE_CANCEL";
ФормаПроверки.Модифицированность = Истина;
ФормаПроверки.Открыть();
Результат = "STAGE3_RECREATE_CANCEL_READY";
