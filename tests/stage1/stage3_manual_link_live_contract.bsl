// Сервер КА Демо: настоящий REST get, собственные регистры, все изменения откатываются.
// Демозадача 10050 создана предыдущими проверками; её данные в Б24 не меняются.
Если Не ПравоДоступа("Администрирование", Метаданные) Или СтрНайти(НРег(СтрокаСоединенияИнформационнойБазы()), "ка демо") = 0 Тогда ВызватьИсключение "DEMO_ONLY"; КонецЕсли;
Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Заказ ИЗ РегистрСведений.Расш1_СвязиЗаказовБ24 ГДЕ ЗадачаId = &ID");
Запрос.УстановитьПараметр("ID", "10050");
Строки = Запрос.Выполнить().Выбрать();
Если Не Строки.Следующий() Тогда ВызватьИсключение "Нет собственной демосвязи"; КонецЕсли;
Заказ = Строки.Заказ;
До = Расш1_СервисRESTБ24.СостояниеЗаказа(Заказ);
ВерсияДокумента = Base64Строка(Заказ.ПолучитьОбъект().ВерсияДанных);
НачатьТранзакцию();
Попытка
    Расш1_СервисRESTБ24.ИзменитьСвязь(Заказ, "", До.ВерсияСвязи);
    БезСвязи = Расш1_СервисRESTБ24.СостояниеЗаказа(Заказ);
    Если БезСвязи.Состояние <> "Нет" Или БезСвязи.ПоследняяУдаленнаяЗадача <> "10050" Тогда ВызватьИсключение "Удаление не сохранило историю"; КонецЕсли;
    Кандидат = Расш1_СервисRESTБ24.ПроверитьКандидата(Заказ, "10050", БезСвязи.ВерсияСвязи);
    НомерЗаказа = "";
    Если Не Кандидат.Свойство("НомерЗаказа", НомерЗаказа) Или НомерЗаказа <> Заказ.Номер Тогда ВызватьИсключение "STAGE3_MANUAL_PREVIEW_RED: предпросмотр не содержит сохранённый номер исходного заказа"; КонецЕсли;
    Если Кандидат.ЗадачаId <> "10050" Или ПустаяСтрока(Кандидат.Название) Тогда ВызватьИсключение "Не получен настоящий кандидат"; КонецЕсли;
    ПослеПросмотра = Расш1_СервисRESTБ24.СостояниеЗаказа(Заказ);
    Если ПослеПросмотра.Состояние <> "Нет" Или ПослеПросмотра.ВерсияСвязи <> БезСвязи.ВерсияСвязи Тогда ВызватьИсключение "Предпросмотр записал связь"; КонецЕсли;
    Название = Кандидат.Название; Кандидат.Название = Название + " изменено";
    Отказано = Ложь;
    Попытка Расш1_СервисRESTБ24.ПодтвердитьПривязку(Заказ, Кандидат, Истина); Исключение Отказано = Истина; КонецПопытки;
    Если Не Отказано Тогда ВызватьИсключение "Не перепроверено название перед записью"; КонецЕсли;
    Кандидат.Название = Название;
    Расш1_СервисRESTБ24.ПодтвердитьПривязку(Заказ, Кандидат, Кандидат.Завершена);
    После = Расш1_СервисRESTБ24.СостояниеЗаказа(Заказ);
    Если После.Состояние <> "Связана" Или После.ЗадачаId <> "10050" Или После.Название <> Название
        Или После.ВерсияСвязи <> БезСвязи.ВерсияСвязи + 1 Тогда ВызватьИсключение "Подтверждение не записало проверенную связь"; КонецЕсли;
    Отказано = Ложь;
    Попытка Расш1_СервисRESTБ24.ПодтвердитьПривязку(Заказ, Кандидат, Истина); Исключение Отказано = Истина; КонецПопытки;
    Если Не Отказано Тогда ВызватьИсключение "Устаревший кандидат принят повторно"; КонецЕсли;
    Если Base64Строка(Заказ.ПолучитьОбъект().ВерсияДанных) <> ВерсияДокумента Тогда ВызватьИсключение "Связь записала заказ"; КонецЕсли;
    ОтменитьТранзакцию();
Исключение
    ОтменитьТранзакцию(); ВызватьИсключение;
КонецПопытки;
ПослеОтката = Расш1_СервисRESTБ24.СостояниеЗаказа(Заказ);
Если ПослеОтката.ВерсияСвязи <> До.ВерсияСвязи Или ПослеОтката.ОперацияId <> До.ОперацияId Или ПослеОтката.ЗадачаId <> До.ЗадачаId Тогда ВызватьИсключение "Исходная связь не восстановлена откатом"; КонецЕсли;
Результат = "STAGE3_MANUAL_LINK_LIVE_GREEN";
