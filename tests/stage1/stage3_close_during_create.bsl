// Только собственный тестовый заказ. Runner проверяет базу и отсутствие попытки.
// Закрываем исходную форму лишь после сохранения устойчивой операции,
// когда её результат ещё не завершён. Быстрый успех не доказывает этот сценарий.
ЗаказПроверки = ПолучитьСсылкуПоТипуИUUID("Документ", "ЗаказКлиента", "__ORDER_UUID__");
ФормаПроверки = Неопределено; КоличествоФормПроверки = 0;
Для Каждого ОкноПроверки Из ПолучитьОкна() Цикл
    Для Каждого ОткрытаяФормаПроверки Из ОкноПроверки.Содержимое Цикл
        Если ОткрытаяФормаПроверки.ИмяФормы = "Документ.ЗаказКлиента.Форма.ФормаДокумента" Тогда
            Если ОткрытаяФормаПроверки.Объект.Ссылка = ЗаказПроверки Тогда
                ФормаПроверки = ОткрытаяФормаПроверки; КоличествоФормПроверки = КоличествоФормПроверки + 1;
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
КонецЦикла;
Если КоличествоФормПроверки > 1 Тогда ВызватьИсключение "ONE_TEST_FORM_REQUIRED"; КонецЕсли;
Если ФормаПроверки = Неопределено Тогда
    ФормаПроверки = ПолучитьФорму("Документ.ЗаказКлиента.Форма.ФормаДокумента", Новый Структура("Ключ", ЗаказПроверки), , Новый УникальныйИдентификатор);
КонецЕсли;
Если Лев(ФормаПроверки.Объект.Комментарий, 20) <> "STAGE3_NATIVE_CLOSE_" Тогда ВызватьИсключение "OWN_CLOSE_TEST_REQUIRED"; КонецЕсли;
ФормаПроверки.Заголовок = "Проверка закрытия во время создания";
ФормаПроверки.Открыть();
ФормаПроверки.Расш1_СоздатьЗадачу(Неопределено);
СостояниеПроверки = Расш1_СервисRESTБ24.СостояниеЗаказа(ЗаказПроверки);
ЗакрытаПроверки = Ложь;
Если ЗначениеЗаполнено(СостояниеПроверки.ОперацияId)
    И (СостояниеПроверки.Состояние = "Резерв" Или СостояниеПроверки.Состояние = "ОтправкаНачата" Или СостояниеПроверки.Состояние = "ЗадачаИзвестна")
    И Не ФормаПроверки.Модифицированность Тогда
    ФормаПроверки.Закрыть();
    ЗакрытаПроверки = Истина;
    ДругаяФормаПроверки = ПолучитьФорму("Документ.ЗаказКлиента.Форма.ФормаДокумента", , , Новый УникальныйИдентификатор);
    ДругаяФормаПроверки.Заголовок = "Другая форма — проверка фонового уведомления";
    ДругаяФормаПроверки.Открыть();
КонецЕсли;
Результат = Новый Структура("commandReturned,closedWhilePending,stateAtClose,operationId", Истина, ЗакрытаПроверки, СостояниеПроверки.Состояние, СостояниеПроверки.ОперацияId);
