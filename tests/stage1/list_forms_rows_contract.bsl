// Только существующие демозаказы. Открывает и закрывает собственные экземпляры форм.
ЗаказПроверки = ПолучитьСсылкуПоТипуИUUID("Документ", "ЗаказКлиента", "__LINKED_UUID__");
БезСвязиПроверки = ПолучитьСсылкуПоТипуИUUID("Документ", "ЗаказКлиента", "__UNLINKED_UUID__");
ПроверенныеФормы = Новый Массив;
Для Каждого ИмяФормыПроверки Из СтрРазделить("ФормаСписка,ФормаСпискаДокументов", ",") Цикл
    Для НомерОткрытия = 1 По 2 Цикл
        ФормаПроверки = ПолучитьФорму("Документ.ЗаказКлиента.Форма." + ИмяФормыПроверки, , , Новый УникальныйИдентификатор);
        Попытка
            ФормаПроверки.Открыть();
            Для НомерОбновления = 1 По 2 Цикл
                Если НомерОбновления = 2 Тогда ФормаПроверки.Элементы.Список.Обновить(); КонецЕсли;
                ФормаПроверки.Элементы.Список.ТекущаяСтрока = ЗаказПроверки;
                ДанныеПроверки = ФормаПроверки.Элементы.Список.ТекущиеДанные;
                Если ДанныеПроверки = Неопределено Или ДанныеПроверки.Расш1_ЗадачаId <> "__TASK_ID__" Тогда
                    ВызватьИсключение "LIST_ROWS_RED: " + ИмяФормыПроверки + ": сохраненный ID не отображается";
                КонецЕсли;
                ФормаПроверки.Элементы.Список.ТекущаяСтрока = БезСвязиПроверки;
                ДанныеПроверки = ФормаПроверки.Элементы.Список.ТекущиеДанные;
                Если ДанныеПроверки = Неопределено Или ДанныеПроверки.Расш1_ЗадачаId <> "" Тогда
                    ВызватьИсключение "LIST_ROWS_RED: " + ИмяФормыПроверки + ": ячейка без связи не пустая";
                КонецЕсли;
            КонецЦикла;
            КоличествоКолонок = 0;
            Для Каждого КолонкаПроверки Из ФормаПроверки.Элементы.Список.ПодчиненныеЭлементы Цикл
                Если КолонкаПроверки.Имя = "Расш1_ЗадачаБ24" Тогда КоличествоКолонок = КоличествоКолонок + 1; КонецЕсли;
            КонецЦикла;
            Если КоличествоКолонок <> 1 Тогда ВызватьИсключение "LIST_ROWS_RED: дублирование колонки"; КонецЕсли;
        Исключение
            ФормаПроверки.Закрыть();
            ВызватьИсключение;
        КонецПопытки;
        ФормаПроверки.Закрыть();
    КонецЦикла;
    ПроверенныеФормы.Добавить(ИмяФормыПроверки);
КонецЦикла;
Результат = Новый Структура("status,forms", "LIST_FORMS_ROWS_GREEN", ПроверенныеФормы);
