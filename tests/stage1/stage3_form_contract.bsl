// Клиент КА Демо: новый заказ, без записи, проведения и HTTP.
Форма = ПолучитьФорму("Документ.ЗаказКлиента.Форма.ФормаДокумента", , , Новый УникальныйИдентификатор);
Форма.Открыть();
Если Форма.Элементы.Найти("Расш1_ВерхБ24") = Неопределено Тогда
    ВызватьИсключение "STAGE3_FORM_RED: верхний блок отсутствует";
КонецЕсли;
Если Форма.Элементы.Найти("Расш1_БлокЗадачаБ24") <> Неопределено Тогда
    ВызватьИсключение "STAGE3_FORM_RED: прежний нижний блок сохранён";
КонецЕсли;
Если Форма.Расш1_ЗадачаСоздана Или Форма.Расш1_НомерЗадачиБ24 <> ""
    Или Форма.Расш1_НазваниеБ24 <> "" Или Форма.Расш1_ОшибкаБ24 <> "" Тогда
    ВызватьИсключение "STAGE3_FORM_RED: новый заказ показывает сохранённую задачу";
КонецЕсли;
Если Форма.Элементы.Найти("Расш1_ОткрытьЗадачу") <> Неопределено Тогда
    ВызватьИсключение "STAGE3_FORM_RED: команда открытия должна отсутствовать";
КонецЕсли;
Если Форма.Элементы.Расш1_ПривязатьЗадачу.ПоложениеВКоманднойПанели
    <> ПоложениеКнопкиВКоманднойПанели.ВДополнительномПодменю Тогда
    ВызватьИсключение "STAGE3_FORM_RED: ручная привязка не в меню Ещё";
КонецЕсли;
Если Форма.Модифицированность Тогда
    ВызватьИсключение "STAGE3_FORM_RED: чтение сведений изменило новый заказ";
КонецЕсли;
// Отказ/отмена не должны переходить к штатной записи или резервированию.
Форма.Расш1_ОтветНапоминания(КодВозвратаДиалога.Отмена, Неопределено);
Форма.Расш1_ПослеУспешногоПроведения(Ложь, Новый Структура("Клик", "несостоявшаяся-запись"));
Если ЗначениеЗаполнено(Форма.Объект.Ссылка) Или Форма.Объект.Проведен Тогда
    ВызватьИсключение "STAGE3_FORM_RED: отказ вызвал запись/проведение нового заказа";
КонецЕсли;
Форма.Закрыть();
Результат = "STAGE3_FORM_GREEN";
