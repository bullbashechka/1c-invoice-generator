// Проверка только регистра в КА Демо. Задачи Б24 не создаются.
// Ссылки заказов синтетические; документы не записываются и не проводятся.
Заказ1 = Документы.ЗаказКлиента.ПолучитьСсылку(Новый УникальныйИдентификатор);
Заказ2 = Документы.ЗаказКлиента.ПолучитьСсылку(Новый УникальныйИдентификатор);
Операция1 = Строка(Новый УникальныйИдентификатор);
Операция2 = Строка(Новый УникальныйИдентификатор);
ТекстОшибкиТеста = "";
Попытка
    Для НомерПовтора = 1 По 2 Цикл
        Набор = РегистрыСведений.Расш1_СвязиЗаказовБ24.СоздатьНаборЗаписей();
        Набор.Отбор.Заказ.Установить(Заказ1);
        СтрокаСвязи = Набор.Добавить();
        СтрокаСвязи.Заказ = Заказ1;
        СтрокаСвязи.ЗадачаId = "2100000001";
        СтрокаСвязи.ОперацияId = Операция1;
        Набор.Записать();
    КонецЦикла;

    КонфликтЗадачи = Ложь;
    Попытка
        Набор = РегистрыСведений.Расш1_СвязиЗаказовБ24.СоздатьНаборЗаписей();
        Набор.Отбор.Заказ.Установить(Заказ2);
        СтрокаСвязи = Набор.Добавить();
        СтрокаСвязи.Заказ = Заказ2;
        СтрокаСвязи.ЗадачаId = "2100000001";
        СтрокаСвязи.ОперацияId = Операция2;
        Набор.Записать();
    Исключение
        Если СтрНайти(ОписаниеОшибки(), "STAGE1_LINK_CONFLICT") = 0 Тогда
            ВызватьИсключение;
        КонецЕсли;
        КонфликтЗадачи = Истина;
    КонецПопытки;
    Если Не КонфликтЗадачи Тогда
        ВызватьИсключение "STAGE1_RED: занятая задача привязана к другому заказу";
    КонецЕсли;

    КонфликтОперации = Ложь;
    Попытка
        Набор = РегистрыСведений.Расш1_СвязиЗаказовБ24.СоздатьНаборЗаписей();
        Набор.Отбор.Заказ.Установить(Заказ2);
        СтрокаСвязи = Набор.Добавить();
        СтрокаСвязи.Заказ = Заказ2;
        СтрокаСвязи.ЗадачаId = "2100000002";
        СтрокаСвязи.ОперацияId = Операция1;
        Набор.Записать();
    Исключение
        Если СтрНайти(ОписаниеОшибки(), "STAGE1_LINK_CONFLICT") = 0 Тогда
            ВызватьИсключение;
        КонецЕсли;
        КонфликтОперации = Истина;
    КонецПопытки;
    Если Не КонфликтОперации Тогда
        ВызватьИсключение "STAGE1_RED: операция принята для другого заказа и задачи";
    КонецЕсли;

    Запрос = Новый Запрос("ВЫБРАТЬ Заказ, ЗадачаId, ОперацияId
        |ИЗ РегистрСведений.Расш1_СвязиЗаказовБ24 ГДЕ Заказ = &Заказ");
    Запрос.УстановитьПараметр("Заказ", Заказ1);
    Таблица = Запрос.Выполнить().Выгрузить();
    Если Таблица.Количество() <> 1 Тогда
        ВызватьИсключение "STAGE1_RED: повтор изменил число связей";
    КонецЕсли;
    Если Таблица[0].ЗадачаId <> "2100000001" Или Таблица[0].ОперацияId <> Операция1 Тогда
        ВызватьИсключение "STAGE1_RED: конфликт изменил исходную связь";
    КонецЕсли;
Исключение
    ТекстОшибкиТеста = ОписаниеОшибки();
КонецПопытки;

// Удаляются только две созданные этим прогоном синтетические записи.
ЗаказыТеста = Новый Массив;
ЗаказыТеста.Добавить(Заказ1);
ЗаказыТеста.Добавить(Заказ2);
Для Каждого ЗаказТеста Из ЗаказыТеста Цикл
    Набор = РегистрыСведений.Расш1_СвязиЗаказовБ24.СоздатьНаборЗаписей();
    Набор.Отбор.Заказ.Установить(ЗаказТеста);
    Набор.Записать();
КонецЦикла;
Если ТекстОшибкиТеста <> "" Тогда
    ВызватьИсключение ТекстОшибкиТеста;
КонецЕсли;
Результат = "STAGE1_REGISTER_CONTRACT_GREEN";
