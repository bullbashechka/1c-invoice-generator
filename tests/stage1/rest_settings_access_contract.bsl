// Только КА Демо, обычный сотрудник без административных прав, непривилегированный контекст.
Если ПривилегированныйРежим() Или ПравоДоступа("Администрирование", Метаданные) Тогда
    ВызватьИсключение "REST_ACCESS: требуется обычный сотрудник без привилегированного режима.";
КонецЕсли;
Если Метаданные.Имя <> "КомплекснаяАвтоматизацияДляКазахстана"
    Или СтрНайти(НРег(СтрокаСоединенияИнформационнойБазы()), "ка демо") = 0 Тогда
    ВызватьИсключение "REST_ACCESS: требуется КА Демо.";
КонецЕсли;
Для Каждого ИмяПрава Из СтрРазделить("Чтение,Просмотр,Добавление,Изменение,Удаление", ",") Цикл
    Если ПравоДоступа(ИмяПрава, Метаданные.РегистрыСведений.Расш1_НастройкиОбменаБ24) Тогда
        ВызватьИсключение "REST_ACCESS_RED: доступ к настройкам разрешен: " + ИмяПрава;
    КонецЕсли;
КонецЦикла;
ЧтениеЗапрещено = Ложь;
Попытка
    ЗапросСекрета = Новый Запрос("ВЫБРАТЬ Секрет ИЗ РегистрСведений.Расш1_НастройкиОбменаБ24 ГДЕ Ключ = &Ключ");
    ЗапросСекрета.УстановитьПараметр("Ключ", "rest");
    ЗапросСекрета.Выполнить();
Исключение
    ЧтениеЗапрещено = СтрНайти(НРег(ОписаниеОшибки()), "прав") > 0;
КонецПопытки;
Если Не ЧтениеЗапрещено Тогда
    ВызватьИсключение "REST_ACCESS_RED: прямое чтение секрета не отклонено ошибкой прав.";
КонецЕсли;
ЗаписьЗапрещена = Ложь;
НачатьТранзакцию();
Попытка
    ПробнаяНастройка = РегистрыСведений.Расш1_НастройкиОбменаБ24.СоздатьМенеджерЗаписи();
    ПробнаяНастройка.Ключ = "rest-access-test-" + Строка(Новый УникальныйИдентификатор);
    ПробнаяНастройка.Значение = "synthetic";
    ПробнаяНастройка.Записать();
Исключение
    ЗаписьЗапрещена = СтрНайти(НРег(ОписаниеОшибки()), "прав") > 0;
КонецПопытки;
// Даже при неожиданно разрешенной записи тест не оставляет строку в базе.
ОтменитьТранзакцию();
Если Не ЗаписьЗапрещена Тогда
    ВызватьИсключение "REST_ACCESS_RED: запись настройки не отклонена ошибкой прав.";
КонецЕсли;
Результат = "REST_SETTINGS_ACCESS_CONTRACT_GREEN";
