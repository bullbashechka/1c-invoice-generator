// Только чтение результата физического удаления/привязки собственного заказа10058.
ЗаказПроверки = Документы.ЗаказКлиента.ПолучитьСсылку(Новый УникальныйИдентификатор("1dedddcf-c3de-11f1-87c8-8c86ddf9c7cd"));
ОбъектПроверки = ЗаказПроверки.ПолучитьОбъект();
Если Лев(ОбъектПроверки.Комментарий, 14) <> "STAGE3_NATIVE_" Тогда ВызватьИсключение "OWN_DEMO_ORDER_REQUIRED"; КонецЕсли;
Если Base64Строка(ОбъектПроверки.ВерсияДанных) <> "__DOCUMENT_VERSION__" Тогда ВызватьИсключение "MANUAL_ACTION_SAVED_ORDER"; КонецЕсли;
Состояние = Расш1_СервисRESTБ24.СостояниеЗаказа(ЗаказПроверки);
Если Состояние.Состояние <> "Связана" Или Состояние.ЗадачаId <> "10058"
    Или Состояние.ВерсияСвязи <> __LINK_VERSION__ + 2
    Или Состояние.ПоследняяУдаленнаяЗадача <> "10058" Тогда ВызватьИсключение "MANUAL_LINK_OR_HISTORY_NOT_CONFIRMED"; КонецЕсли;
Запрос = Новый Запрос("ВЫБРАТЬ Действие, ПрежняяЗадача, НоваяЗадача, ИнициаторId, МоментUTC ИЗ РегистрСведений.Расш1_АудитСвязейБ24 ГДЕ Заказ = &Заказ И Действие В (""УдалениеСвязи"", ""РучнаяПривязка"")");
Запрос.УстановитьПараметр("Заказ", ЗаказПроверки);
Строки = Запрос.Выполнить().Выбрать(); Удалений = 0; Привязок = 0;
Пока Строки.Следующий() Цикл
    Если Строки.ИнициаторId <> Расш1_ОперацииRESTБ24.ПользовательId() Или Не ЗначениеЗаполнено(Строки.МоментUTC) Тогда ВызватьИсключение "MANUAL_AUDIT_ACTOR_OR_TIME_MISSING"; КонецЕсли;
    Если Строки.Действие = "УдалениеСвязи" И Строки.ПрежняяЗадача = "10058" И Строки.НоваяЗадача = "" Тогда Удалений = Удалений + 1; КонецЕсли;
    Если Строки.Действие = "РучнаяПривязка" И Строки.ПрежняяЗадача = "" И Строки.НоваяЗадача = "10058" Тогда Привязок = Привязок + 1; КонецЕсли;
КонецЦикла;
Если Удалений <> 1 Или Привязок <> 1 Тогда ВызватьИсключение "MANUAL_AUDIT_ACTIONS_NOT_CONFIRMED"; КонецЕсли;
Результат = "STAGE3_MANUAL_RESULT_GREEN";
