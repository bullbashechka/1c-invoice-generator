// Проверяет настоящие регистры/сервисы 1С. ID синтетический, задача Б24 не создаётся.
// Все данные откатываются; внешнее чтение срока явно исключено.
Если Не ПравоДоступа("Администрирование", Метаданные) Или СтрНайти(НРег(СтрокаСоединенияИнформационнойБазы()), "ка демо") = 0 Тогда ВызватьИсключение "DEMO_ONLY"; КонецЕсли;
Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ.ЗаказКлиента ГДЕ Проведен И НЕ ПометкаУдаления И Ссылка НЕ В (ВЫБРАТЬ Заказ ИЗ РегистрСведений.Расш1_СостояниеЗаказовБ24) И Ссылка НЕ В (ВЫБРАТЬ Заказ ИЗ РегистрСведений.Расш1_СвязиЗаказовБ24)");
Строки = Запрос.Выполнить().Выбрать(); Если Не Строки.Следующий() Тогда ВызватьИсключение "Нет демозаказа"; КонецЕсли;
Заказ = Строки.Ссылка;
Режим = ПривилегированныйРежим(); УстановитьПривилегированныйРежим(Истина);
НачатьТранзакцию();
Попытка
    Настройка = РегистрыСведений.Расш1_НастройкиОбменаБ24.СоздатьМенеджерЗаписи();
    Настройка.Ключ = "stage2Enabled"; Настройка.Значение = "true"; Настройка.Записать();
    Попытка1 = Расш1_ОперацииRESTБ24.Зарезервировать(Заказ, "link-test");
    Расш1_ОперацииRESTБ24.СохранитьОтвет(Попытка1.ОперацияId, Новый Структура("Состояние,ЗадачаId", "ЗадачаИзвестна", "999999991"));
    Состояние = Расш1_ОперацииRESTБ24.ПрочитатьСостояние(Заказ);
    Если Состояние.Состояние <> "ЗадачаИзвестна" Или Состояние.ЗадачаId <> "999999991" Тогда ВызватьИсключение "ID не сохранён отдельно от связи"; КонецЕсли;
    Отказано = Ложь;
    Попытка Расш1_ОперацииRESTБ24.ИзменитьСвязь(Заказ, "", Состояние.ВерсияСвязи); Исключение Отказано = Истина; КонецПопытки;
    Если Не Отказано Тогда ВызватьИсключение "Разрешено изменение незавершённой связи"; КонецЕсли;
    Расш1_ОперацииRESTБ24.ЗаписатьСвязь(Попытка1.ОперацияId, Ложь);
    Состояние = Расш1_ОперацииRESTБ24.ПрочитатьСостояние(Заказ);
    Если Состояние.Состояние <> "Связана" Или Состояние.ЗадачаId <> "999999991" Или Состояние.ВерсияСвязи <> 1 Тогда ВызватьИсключение "Связь не завершена атомарно"; КонецЕсли;
    Уведомления = Расш1_ОперацииRESTБ24.ПолучитьУведомления();
    Если Уведомления.Количество() <> 1 Тогда ВызватьИсключение "Нет сообщения об успехе или остался промежуточный результат"; КонецЕсли;
    Если Расш1_ОперацииRESTБ24.ПолучитьУведомления().Количество() <> 1 Тогда ВызватьИсключение "Чтение подтвердило показ"; КонецЕсли;
    Расш1_ОперацииRESTБ24.ИзменитьСвязь(Заказ, "", Состояние.ВерсияСвязи);
    Состояние = Расш1_ОперацииRESTБ24.ПрочитатьСостояние(Заказ);
    Если Состояние.Состояние <> "Нет" Или Состояние.ЗадачаId <> "" Тогда ВызватьИсключение "После удаления показана старая связь"; КонецЕсли;
    Расш1_ОперацииRESTБ24.ЗаписатьСвязь(Попытка1.ОперацияId, Ложь);
    Если Расш1_ОперацииRESTБ24.ПрочитатьСостояние(Заказ).Состояние <> "Нет" Тогда ВызватьИсключение "Завершённая операция воскресила связь"; КонецЕсли;
    Сообщения = Расш1_ОперацииRESTБ24.ПолучитьУведомления();
    Если СтрНайти(Сообщения[0].Текст, "связь изменили или удалили") = 0 Тогда ВызватьИсключение "Устаревший успех не уточнён"; КонецЕсли;
    Расш1_ОперацииRESTБ24.ПодтвердитьПоказ(Сообщения[0].СообщениеId);
    Если Расш1_ОперацииRESTБ24.ПолучитьУведомления().Количество() <> 0 Тогда ВызватьИсключение "Показ не подтверждён"; КонецЕсли;
    Если Не Заказ.Проведен Тогда ВызватьИсключение "Связь изменила проведение заказа"; КонецЕсли;
    ОтменитьТранзакцию(); УстановитьПривилегированныйРежим(Режим);
Исключение
    ОтменитьТранзакцию(); УстановитьПривилегированныйРежим(Режим); ВызватьИсключение;
КонецПопытки;
Результат = Новый Структура("success,cases", Истина, 9);
