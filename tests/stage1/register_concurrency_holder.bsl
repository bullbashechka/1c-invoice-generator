// Обёртка задаёт Заказ1, ЗадачаIdТеста, Операция1, ПортБарьера, ПутьБарьера.
// Первая запись остаётся в открытой транзакции до ответа локального барьера.
НачатьТранзакцию();
Попытка
    Набор = РегистрыСведений.Расш1_СвязиЗаказовБ24.СоздатьНаборЗаписей();
    Набор.Отбор.Заказ.Установить(Заказ1);
    Связь = Набор.Добавить();
    Связь.Заказ = Заказ1;
    Связь.ЗадачаId = ЗадачаIdТеста;
    Связь.ОперацияId = Операция1;
    Набор.Записать();
    Соединение = Новый HTTPСоединение("127.0.0.1", ПортБарьера,,,, 30);
    Ответ = Соединение.Получить(Новый HTTPЗапрос(ПутьБарьера + "/holder"));
    Если Ответ.КодСостояния <> 200 Тогда
        ВызватьИсключение "STAGE1_BARRIER_TIMEOUT";
    КонецЕсли;
    ЗафиксироватьТранзакцию();
Исключение
    ОтменитьТранзакцию();
    ВызватьИсключение;
КонецПопытки;
Результат = Новый Структура("status,sessionId", "holder_committed", НомерСеансаИнформационнойБазы());
