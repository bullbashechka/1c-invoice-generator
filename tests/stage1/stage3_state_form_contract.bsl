// Только отдельный заказ теста интерфейса с искусственной сохранённой операцией.
// Runner держит REST выключенным, восстановление отложено; реальной отправки нет.
ЗаказПроверкиСостояния = ПолучитьСсылкуПоТипуИUUID("Документ", "ЗаказКлиента", "__ORDER_UUID__");
Для НомерОткрытияПроверки = 1 По 2 Цикл
    ФормаПроверкиСостояния = ПолучитьФорму("Документ.ЗаказКлиента.Форма.ФормаДокумента", Новый Структура("Ключ", ЗаказПроверкиСостояния), , Новый УникальныйИдентификатор);
    Если ФормаПроверкиСостояния.Объект.Комментарий <> "__TOKEN__" Тогда ВызватьИсключение "UI_FIXTURE_REQUIRED"; КонецЕсли;
    ФормаПроверкиСостояния.Заголовок = "Проверка состояния интерфейса — __STATE__";
    ФормаПроверкиСостояния.Открыть();
    ПрежнийКомментарийПроверки = ФормаПроверкиСостояния.Объект.Комментарий;
    Попытка
        Если ФормаПроверкиСостояния.Расш1_СостояниеБ24 <> "__STATE__"
            Или ФормаПроверкиСостояния.Расш1_ОперацияБ24 <> "__OPERATION__"
            Или ФормаПроверкиСостояния.Расш1_ТекстБ24 <> "__TEXT__"
            Или Не ФормаПроверкиСостояния.Элементы.Расш1_ТекстБ24.Видимость Тогда
            ВызватьИсключение "UI_STATE_RED: сохранённое состояние не показано";
        КонецЕсли;
        Если ФормаПроверкиСостояния.Расш1_ЗадачаСоздана
            Или ФормаПроверкиСостояния.Расш1_НомерЗадачиБ24 <> ""
            Или ФормаПроверкиСостояния.Расш1_НазваниеБ24 <> "" Тогда
            ВызватьИсключение "UI_STATE_RED: показана несуществующая сохранённая связь";
        КонецЕсли;
        Если Не ФормаПроверкиСостояния.Элементы.Расш1_ЗадачаСоздана.ТолькоПросмотр
            Или Не ФормаПроверкиСостояния.Элементы.Расш1_НомерЗадачиБ24.ТолькоПросмотр Тогда
            ВызватьИсключение "UI_STATE_RED: поля связи редактируемы";
        КонецЕсли;
        ФормаПроверкиСостояния.Объект.Комментарий = ПрежнийКомментарийПроверки + " UNSAVED";
        ФормаПроверкиСостояния.Модифицированность = Истина;
        ФормаПроверкиСостояния.Расш1_ОбновитьБ24(Неопределено);
        ФормаПроверкиСостояния.Расш1_СоздатьЗадачу(Неопределено);
        Если Не ФормаПроверкиСостояния.Модифицированность
            Или ФормаПроверкиСостояния.Объект.Комментарий <> ПрежнийКомментарийПроверки + " UNSAVED"
            Или ФормаПроверкиСостояния.Расш1_ТекстБ24 <> "__TEXT__" Тогда
            ВызватьИсключение "UI_STATE_RED: повтор/обновление изменили форму";
        КонецЕсли;
    Исключение
        ФормаПроверкиСостояния.Объект.Комментарий = ПрежнийКомментарийПроверки;
        ФормаПроверкиСостояния.Модифицированность = Ложь; ФормаПроверкиСостояния.Закрыть(); ВызватьИсключение;
    КонецПопытки;
    ФормаПроверкиСостояния.Объект.Комментарий = ПрежнийКомментарийПроверки;
    ФормаПроверкиСостояния.Модифицированность = Ложь;
    Если НомерОткрытияПроверки <> 2 Или "__STATE__" <> "Неизвестно" Тогда ФормаПроверкиСостояния.Закрыть(); КонецЕсли;
КонецЦикла;
Результат = "STAGE3_STATE_FORM_GREEN:__STATE__";
