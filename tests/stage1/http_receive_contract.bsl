// Компонентный прогон через execute_code/server в КА Демо.
// Оболочка задаёт ПортПрототипа и КлючПрототипа перед этим фрагментом.
// Сервис содержит только синтетические base-a/order-1/op-1/taskId=42.
// Документы, регистр связи и задачи Б24 не записываются.
Соединение = Новый HTTPСоединение("127.0.0.1", ПортПрототипа, , , , 5);
ЗапросHTTP = Новый HTTPЗапрос("/v1/results");
ЗапросHTTP.Заголовки.Вставить("Authorization", "Bearer " + КлючПрототипа);
ОтветHTTP = Соединение.Получить(ЗапросHTTP);
Если ОтветHTTP.КодСостояния <> 200 Тогда
    ВызватьИсключение "STAGE1_HTTP_RECEIVE: HTTP-отказ";
КонецЕсли;
Чтение = Новый ЧтениеJSON;
Чтение.УстановитьСтроку(ОтветHTTP.ПолучитьТелоКакСтроку());
Данные = ПрочитатьJSON(Чтение, Истина);
Чтение.Закрыть();
Строки = Данные.Получить("results");
Если Строки.Количество() <> 1 Тогда
    ВызватьИсключение "STAGE1_HTTP_RECEIVE: ожидался один результат";
КонецЕсли;
СтрокаРезультата = Строки[0];
Если СтрокаРезультата.Получить("baseId") <> "base-a"
    Или СтрокаРезультата.Получить("orderId") <> "order-1"
    Или СтрокаРезультата.Получить("operationId") <> "op-1"
    Или СтрокаРезультата.Получить("taskId") <> 42
    Или СтрокаРезультата.Получить("state") <> "created"
    Или СтрокаРезультата.Получить("linkAcknowledged") <> Ложь Тогда
    ВызватьИсключение "STAGE1_HTTP_RECEIVE: нарушен контракт результата";
КонецЕсли;
Результат = "STAGE1_HTTP_RECEIVE_GREEN";
