// Настоящая команда создания на новой копии собственного демозаказа.
// Runner сверяет fingerprint, выключенный REST и количество операций до/после.
// Не закрывать форму до независимого чтения результата штатной проверки.
ИсточникПроверки = ПолучитьСсылкуПоТипуИUUID("Документ", "ЗаказКлиента", "cbbf15da-c47c-11f1-9797-7ef9832e8e54");
ФормаПроверки = ПолучитьФорму("Документ.ЗаказКлиента.Форма.ФормаДокумента",
    Новый Структура("ЗначениеКопирования", ИсточникПроверки), , Новый УникальныйИдентификатор);
Если ЗначениеЗаполнено(ФормаПроверки.Объект.Ссылка) Тогда ВызватьИсключение "UNSAVED_COPY_REQUIRED"; КонецЕсли;
Если Лев(ФормаПроверки.Объект.Комментарий, 20) <> "STAGE3_NATIVE_CLOSE_" Тогда
    ВызватьИсключение "OWN_DEMO_SOURCE_REQUIRED";
КонецЕсли;
ФормаПроверки.Объект.Комментарий = "STAGE3_REQUIRED_DATE_REFUSAL_FINAL";
ФормаПроверки.Объект.ДатаОтгрузки = Дата(1, 1, 1);
Для Каждого СтрокаПроверки Из ФормаПроверки.Объект.Товары Цикл
    СтрокаПроверки.ДатаОтгрузки = Дата(1, 1, 1);
КонецЦикла;
ФормаПроверки.Модифицированность = Истина;
ФормаПроверки.Заголовок = "Последняя проверка этапа 3 — отказ без даты отгрузки";
ФормаПроверки.Открыть();
ФормаПроверки.Расш1_СоздатьЗадачу(Неопределено);
Результат = "REQUIRED_DATE_COMMAND_RETURNED_PENDING_READ";
