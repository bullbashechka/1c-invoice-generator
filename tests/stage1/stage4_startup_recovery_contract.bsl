// Только чтение. ОперацияIdПроверки — собственная тестовая операция в КА Демо.
// Последняя запись аудита должна относиться к текущему запуску, не прежнему клиенту.
Если Не ПравоДоступа("Администрирование", Метаданные) Или СтрНайти(НРег(СтрокаСоединенияИнформационнойБазы()), "ка демо") = 0 Тогда ВызватьИсключение "DEMO_ONLY"; КонецЕсли;
Ж = РегистрыСведений.Расш1_ЖурналОперацийБ24.СоздатьМенеджерЗаписи(); Ж.ОперацияId = ОперацияIdПроверки; Ж.Прочитать();
Если Не Ж.Выбран() Или Лев(Ж.Заказ.Комментарий, 14) <> "STAGE3_NATIVE_" Тогда ВызватьИсключение "OWN_OPERATION_REQUIRED"; КонецЕсли;
С = Расш1_ОперацииRESTБ24.ПрочитатьСостояние(Ж.Заказ);
Если Ж.Состояние <> "Завершена" Или С.Состояние <> "Связана" Или С.ЗадачаId <> Ж.ЗадачаId Тогда ВызватьИсключение "AUTOMATIC_RECOVERY_NOT_COMPLETED"; КонецЕсли;
Начало = Неопределено;
Для Каждого Сеанс Из ПолучитьСеансыИнформационнойБазы() Цикл
    Если Сеанс.НомерСеанса = НомерСеансаИнформационнойБазы() Тогда Начало = Сеанс.НачалоСеанса; КонецЕсли;
КонецЦикла;
Если Начало = Неопределено Тогда ВызватьИсключение "SESSION_START_REQUIRED"; КонецЕсли;
НачалоUTC = Начало - (ТекущаяДата() - ТекущаяУниверсальнаяДата());
З = Новый Запрос("ВЫБРАТЬ МАКСИМУМ(МоментUTC) КАК Последняя ИЗ РегистрСведений.Расш1_АудитСвязейБ24 ГДЕ ОперацияId = &ID И Действие = &Действие");
З.УстановитьПараметр("ID", Ж.ОперацияId); З.УстановитьПараметр("Действие", "Создание"); В = З.Выполнить().Выбрать();
Если Не В.Следующий() Или ТипЗнч(В.Последняя) = Тип("Null") Тогда ВызватьИсключение "LINK_AUDIT_REQUIRED"; КонецЕсли;
Секунды = В.Последняя - НачалоUTC;
Если Секунды < 0 Или Секунды > 60 Тогда ВызватьИсключение "RECOVERY_NOT_WITHIN_60_SECONDS"; КонецЕсли;
У = РегистрыСведений.Расш1_УведомленияБ24.СоздатьМенеджерЗаписи(); У.СообщениеId = Ж.ОперацияId + ":success"; У.Прочитать();
Результат = Новый Структура("passed,sessionId,taskId,recoverySeconds,successDelivered", Истина, НомерСеансаИнформационнойБазы(), Ж.ЗадачаId, Секунды, У.Выбран() И У.Доставлено);
