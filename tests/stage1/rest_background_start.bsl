// Только чтение существующей демозадачи. Выполнять в серверном контексте КА Демо.
// Результат привязан к сеансу, не к форме. Файл содержит только диагностические идентификаторы.
Если Метаданные.Имя <> "КомплекснаяАвтоматизацияДляКазахстана"
    Или СтрНайти(НРег(СтрокаСоединенияИнформационнойБазы()), "ка демо") = 0 Тогда
    ВызватьИсключение "REST_BACKGROUND: требуется КА Демо.";
КонецЕсли;
АдресРезультатаREST = ПоместитьВоВременноеХранилище(Неопределено, Новый УникальныйИдентификатор);
ПараметрыФонаREST = Новый Массив;
ПараметрыФонаREST.Добавить(10028);
ПараметрыФонаREST.Добавить(АдресРезультатаREST);
КлючФонаREST = "rest-read-contract-" + Строка(Новый УникальныйИдентификатор);
НачалоЗапускаREST = ТекущаяУниверсальнаяДата();
ЗаданиеREST = ФоновыеЗадания.Выполнить("Расш1_RESTБ24Сервер.ПроверитьФоновоеЧтение",
    ПараметрыФонаREST, КлючФонаREST, "Проверка фонового чтения Б24 в КА Демо");
КонецЗапускаREST = ТекущаяУниверсальнаяДата();
ЖурналФонаREST = Новый Структура("Сеанс,Задание,Адрес,НачалоЗапуска,КонецЗапуска",
    НомерСеансаИнформационнойБазы(), Строка(ЗаданиеREST.УникальныйИдентификатор),
    АдресРезультатаREST, НачалоЗапускаREST, КонецЗапускаREST);
ЗаписьЖурналаREST = Новый ЗаписьJSON;
ЗаписьЖурналаREST.ОткрытьФайл(КаталогИсходников + "/.local/stage-1/rest-background-session.json");
ЗаписатьJSON(ЗаписьЖурналаREST, ЖурналФонаREST);
ЗаписьЖурналаREST.Закрыть();
Результат = Новый Структура("Проверка,Сеанс,Состояние,ДлительностьЗапуска",
    "REST_BACKGROUND_STARTED", НомерСеансаИнформационнойБазы(), Строка(ЗаданиеREST.Состояние),
    КонецЗапускаREST - НачалоЗапускаREST);
