// Проверка первой связи и очистка только точных синтетических строк этого прогона.
НачатьТранзакцию();
Попытка
Блокировка = Новый БлокировкаДанных;
Область = Блокировка.Добавить("РегистрСведений.Расш1_СвязиЗаказовБ24");
Область.Режим = РежимБлокировкиДанных.Исключительный;
Блокировка.Заблокировать();
Запрос = Новый Запрос("ВЫБРАТЬ Заказ, ЗадачаId, ОперацияId
    |ИЗ РегистрСведений.Расш1_СвязиЗаказовБ24
    |ГДЕ Заказ = &Заказ1 ИЛИ Заказ = &Заказ2
    |ИЛИ ЗадачаId = &ЗадачаId ИЛИ ЗадачаId = &ЗадачаIdВторой
    |ИЛИ ОперацияId = &Операция1 ИЛИ ОперацияId = &Операция2");
Запрос.УстановитьПараметр("Заказ1", Заказ1);
Запрос.УстановитьПараметр("Заказ2", Заказ2);
Запрос.УстановитьПараметр("ЗадачаId", ЗадачаIdТеста);
Запрос.УстановитьПараметр("ЗадачаIdВторой", ЗадачаIdВторой);
Запрос.УстановитьПараметр("Операция1", Операция1);
Запрос.УстановитьПараметр("Операция2", Операция2);
Таблица = Запрос.Выполнить().Выгрузить();
ПерваяСохранена = Таблица.Количество() = 1;
Для Каждого Связь Из Таблица Цикл
    Если Связь.Заказ = Заказ1 И Связь.ЗадачаId = ЗадачаIdТеста
        И Связь.ОперацияId = Операция1 Тогда
        // Точная первая связь. Общий заказ/операция сами по себе недостаточны.
    ИначеЕсли Связь.Заказ = Заказ2 И Связь.ЗадачаId = ЗадачаIdВторой
        И Связь.ОперацияId = Операция2 Тогда
        ПерваяСохранена = Ложь;
    Иначе
        ВызватьИсключение "STAGE1_CLEANUP_REFUSED: строка не принадлежит прогону";
    КонецЕсли;
КонецЦикла;
    Для Каждого Связь Из Таблица Цикл
        Набор = РегистрыСведений.Расш1_СвязиЗаказовБ24.СоздатьНаборЗаписей();
        Набор.Отбор.Заказ.Установить(Связь.Заказ);
        Набор.Записать();
    КонецЦикла;
    Если Не Запрос.Выполнить().Пустой() Тогда
        ВызватьИсключение "STAGE1_CLEANUP_FAILED";
    КонецЕсли;
    ЗафиксироватьТранзакцию();
Исключение
    ОтменитьТранзакцию();
    ВызватьИсключение;
КонецПопытки;
Результат = Новый Структура("firstLinkPreserved,testRowsRemaining", ПерваяСохранена, 0);
