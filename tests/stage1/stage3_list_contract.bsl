// Клиент КА Демо. Чтение реально сохранённой связи в динамическом списке, без запуска Б24.
Заказ = ПолучитьСсылкуПоТипуИUUID("Документ", "ЗаказКлиента", "__ORDER_UUID__");
Состояние = Расш1_СервисRESTБ24.СостояниеЗаказа(Заказ);
Если Состояние.Состояние <> "Связана" Тогда ВызватьИсключение "Нет связи для проверки списка"; КонецЕсли;
ФормаПроверки = ПолучитьФорму("Документ.ЗаказКлиента.Форма.ФормаСписка");
ФормаПроверки.Открыть();
Если ФормаПроверки.Элементы.Расш1_ЗадачаБ24.Гиперссылка Тогда ВызватьИсключение "STAGE3_LIST_RED: колонка задачи должна быть обычным текстом"; КонецЕсли;
Если Не ФормаПроверки.Элементы.Расш1_ЗадачаБ24.Видимость Или Не ФормаПроверки.Элементы.Расш1_ЗадачаБ24.ТолькоПросмотр Тогда ВызватьИсключение "Колонка ID должна быть видимой и только для чтения"; КонецЕсли;
ПредыдущееИмя = "";
Для Каждого КолонкаПроверки Из ФормаПроверки.Элементы.Список.ПодчиненныеЭлементы Цикл
    Если КолонкаПроверки.Имя = "Расш1_ЗадачаБ24" И ПредыдущееИмя <> "СписокПартнер" Тогда ВызватьИсключение "Колонка ID не следует сразу после Клиент"; КонецЕсли;
    ПредыдущееИмя = КолонкаПроверки.Имя;
КонецЦикла;
ФормаПроверки.Элементы.Список.ТекущаяСтрока = Заказ;
ДанныеСтроки = ФормаПроверки.Элементы.Список.ТекущиеДанные;
Если ДанныеСтроки = Неопределено Тогда ВызватьИсключение "Связанный заказ не выбран в списке"; КонецЕсли;
Ожидаемое = Состояние.ЗадачаId;
Если ДанныеСтроки.Расш1_ЗадачаId <> Ожидаемое Тогда
    ВызватьИсключение "Отображаемая строка не содержит сохранённый ID задачи";
КонецЕсли;
БезСвязи = ПолучитьСсылкуПоТипуИUUID("Документ", "ЗаказКлиента", "__UNLINKED_UUID__");
ФормаПроверки.Элементы.Список.ТекущаяСтрока = БезСвязи;
СтрокаБезСвязи = ФормаПроверки.Элементы.Список.ТекущиеДанные;
Если СтрокаБезСвязи = Неопределено Или СтрокаБезСвязи.Расш1_ЗадачаId <> "" Тогда ВызватьИсключение "Заказ без связи должен иметь пустую ячейку ID"; КонецЕсли;
ФормаПроверки.Элементы.Список.ТекущаяСтрока = Заказ;
Результат = "STAGE3_LIST_GREEN";
