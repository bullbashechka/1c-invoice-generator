// Только чтение Б24. Предварительно созданная демозадача должна существовать.
// КаталогИсходников задаётся абсолютным путём. Секрет и журнал остаются в .local.
ЧтениеТекста = Новый ЧтениеТекста(КаталогИсходников
    + "/.local/stage-1/rest-recovery-smoke.json", КодировкаТекста.UTF8);
ТекстЖурнала = ЧтениеТекста.Прочитать(); ЧтениеТекста.Закрыть();
Чтение = Новый ЧтениеJSON; Чтение.УстановитьСтроку(ТекстЖурнала);
Журнал = ПрочитатьJSON(Чтение, Истина); Чтение.Закрыть();
Поля = Журнал.Получить("fields");
МеткаОперации = Поля.Получить("XML_ID");
Если ТипЗнч(МеткаОперации) <> Тип("Строка") Или ПустаяСтрока(МеткаОперации) Тогда
    ВызватьИсключение "REST_RECOVERY_RED: отсутствует сохранённая метка операции";
КонецЕсли;

ЧтениеТекста = Новый ЧтениеТекста(КаталогИсходников
    + "/.local/bitrix24-webhook.txt", КодировкаТекста.UTF8);
Вебхук = СокрЛП(ЧтениеТекста.Прочитать()); ЧтениеТекста.Закрыть();
Хост = "toofirmagem.bitrix24.kz";
Если Лев(Вебхук, СтрДлина("https://" + Хост + "/rest/")) <> "https://" + Хост + "/rest/" Тогда
    ВызватьИсключение "REST_RECOVERY_RED: вебхук не относится к проверяемому порталу";
КонецЕсли;
Фильтр = Новый Соответствие;
Фильтр.Вставить("=XML_ID", МеткаОперации);
Фильтр.Вставить("GROUP_ID", 36);
Выборка = СтрРазделить("ID,TITLE,XML_ID,CREATED_BY,RESPONSIBLE_ID,AUDITORS,ACCOMPLICES,GROUP_ID,DEADLINE", ",");
Запись = Новый ЗаписьJSON; Запись.УстановитьСтроку();
ЗаписатьJSON(Запись, Новый Структура("filter,select", Фильтр, Выборка));
ТелоЗапроса = Запись.Закрыть();
Соединение = Новый HTTPСоединение(Хост, 443, , , , 20,
    Новый ЗащищенноеСоединениеOpenSSL(Неопределено, Новый СертификатыУдостоверяющихЦентровОС));
ЗапросHTTP = Новый HTTPЗапрос(Сред(Вебхук, 9 + СтрДлина(Хост)) + "tasks.task.list.json");
ЗапросHTTP.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
ЗапросHTTP.УстановитьТелоИзСтроки(ТелоЗапроса, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
Ответ = Соединение.ОтправитьДляОбработки(ЗапросHTTP);
Если Ответ.КодСостояния <> 200 Тогда
    ВызватьИсключение "REST_RECOVERY_RED: отказ HTTP при чтении";
КонецЕсли;
ТекстОтвета = Ответ.ПолучитьТелоКакСтроку();
ЧтениеТекста = Новый ЧтениеТекста(КаталогИсходников
    + "/src/stage-1-prototype/CommonModules/Расш1_RESTБ24Сервер/Ext/Module.bsl", КодировкаТекста.UTF8);
Исходник = ЧтениеТекста.Прочитать(); ЧтениеТекста.Закрыть();
НачалоТела = СтрНайти(Исходник, "// REST_JSON_BODY_BEGIN");
КонецТела = СтрНайти(Исходник, "// REST_JSON_BODY_END");
Если НачалоТела = 0 Или КонецТела <= НачалоТела Тогда
    ВызватьИсключение "REST_RECOVERY_RED: не найдено тело процедуры";
КонецЕсли;
Разбор = Неопределено;
Выполнить(Сред(Исходник, НачалоТела, КонецТела - НачалоТела));
Если Разбор.Состояние <> "Результат" Тогда
    ВызватьИсключение "REST_RECOVERY_RED: результат поиска недоступен";
КонецЕсли;
НайденныеЗадачи = Разбор.Данные.Получить("tasks");
Если ТипЗнч(НайденныеЗадачи) <> Тип("Массив") Или НайденныеЗадачи.Количество() <> 1 Тогда
    ВызватьИсключение "REST_RECOVERY_RED: не найдена единственная задача операции";
КонецЕсли;
Задача = НайденныеЗадачи[0];
Если Задача.Получить("xmlId") <> МеткаОперации
    Или Строка(Задача.Получить("id")) <> Строка(Журнал.Получить("taskId"))
    Или Задача.Получить("title") <> Поля.Получить("TITLE")
    Или Число(Задача.Получить("createdBy")) <> 26
    Или Число(Задача.Получить("responsibleId")) <> 12
    Или Число(Задача.Получить("groupId")) <> 36
    Или Задача.Получить("deadline") <> Поля.Получить("DEADLINE") Тогда
    ВызватьИсключение "REST_RECOVERY_RED: метка, ID или поля задачи не совпали";
КонецЕсли;
Наблюдатели = Задача.Получить("auditors");
Если Наблюдатели.Количество() <> 2
    Или Наблюдатели.Найти("10") = Неопределено
    Или Наблюдатели.Найти("30") = Неопределено
    Или Задача.Получить("accomplices").Количество() <> 0 Тогда
    ВызватьИсключение "REST_RECOVERY_RED: неверные участники";
КонецЕсли;
Результат = Новый Структура("Проверка,ЗадачаID", "REST_RECOVERY_CONTRACT_GREEN", Задача.Получить("id"));
