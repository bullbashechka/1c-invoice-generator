// Только реальный обычный сотрудник КА Демо. Новых задач и изменений заказа нет.
// Проверяет текущий доступ к секрету и новому контракту на собственной10076.
Если ПривилегированныйРежим() Или ПравоДоступа("Администрирование", Метаданные) Тогда ВызватьИсключение "ORDINARY_EMPLOYEE_REQUIRED"; КонецЕсли;
Если Метаданные.Имя <> "КомплекснаяАвтоматизацияДляКазахстана" Или СтрНайти(НРег(СтрокаСоединенияИнформационнойБазы()), "ка демо") = 0 Тогда ВызватьИсключение "DEMO_ONLY"; КонецЕсли;
// Установленный контракт фактически проверяет запрет чтения/записи настройки
// и восстанавливает непривилегированный режим после разрешённого серверного REST.
Этап = "";
Расш1_RESTБ24Сервер.ПроверитьДоступСотрудникаДемо(Этап, 10076);
Заказ = Документы.ЗаказКлиента.ПолучитьСсылку(Новый УникальныйИдентификатор("238b75ec-c495-11f1-9a07-7ef9832e8e54"));
Если Лев(Заказ.Комментарий,14) <> "STAGE3_NATIVE_" Тогда ВызватьИсключение "OWN_ORDER_REQUIRED"; КонецЕсли;
С = Расш1_СервисRESTБ24.СостояниеЗаказа(Заказ);
Если С.ЗадачаId <> "10076" Или С.Состояние <> "Связана" Тогда ВызватьИсключение "SAVED_TARGET_LINK_REQUIRED"; КонецЕсли;
Ответ = Расш1_RESTБ24Сервер.ПрочитатьЗадачуREST(10076);
Если Ответ.Состояние <> "Результат" Тогда ВызватьИсключение "NEW_TASK_READ_NOT_CONFIRMED"; КонецЕсли;
Т = Ответ.Данные.Получить("task");
Если Число(Т.Получить("groupId")) <> 6 Или Число(Т.Получить("createdBy")) <> 26 Или Число(Т.Получить("responsibleId")) <> 12 Тогда ВызватьИсключение "TARGET_ROLES_CHANGED"; КонецЕсли;
Н = Т.Получить("auditors"); И = Т.Получить("accomplices");
Если ТипЗнч(Н) <> Тип("Массив") Или ТипЗнч(И) <> Тип("Массив") Тогда ВызватьИсключение "PARTICIPANTS_FORMAT"; КонецЕсли;
Если Н.Количество() <> 2 Или Н.Найти("28") = Неопределено Или Н.Найти("30") = Неопределено Или И.Количество() <> 1 Или И.Найти("10") = Неопределено Тогда ВызватьИсключение "PARTICIPANTS_CHANGED"; КонецЕсли;
Если ПривилегированныйРежим() Тогда ВызватьИсключение "PRIVILEGED_MODE_NOT_RESTORED"; КонецЕсли;
Результат = "STAGE4_EMPLOYEE_READ_AND_SECRET_GREEN";
