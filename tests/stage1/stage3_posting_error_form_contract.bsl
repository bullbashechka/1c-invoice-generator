// Клиент КА Демо. Источник — демозаказ с предоплатой, копия не оплачена.
// Runner обязан проверить демобазу и выключенный REST. Исходник не записывается.
ИсточникПроверки = ПолучитьСсылкуПоТипуИUUID("Документ", "ЗаказКлиента", "__SOURCE_UUID__");
ФормаПроверки = ПолучитьФорму("Документ.ЗаказКлиента.Форма.ФормаДокумента",
    Новый Структура("ЗначениеКопирования", ИсточникПроверки), , Новый УникальныйИдентификатор);
Если ЗначениеЗаполнено(ФормаПроверки.Объект.Ссылка) Тогда ВызватьИсключение "UNSAVED_COPY_REQUIRED"; КонецЕсли;
ФормаПроверки.Объект.Комментарий = "STAGE3_POSTING_ERROR_CONTRACT";
ФормаПроверки.Объект.ДатаОтгрузки = НачалоДня(ТекущаяДата());
Для Каждого СтрокаПроверки Из ФормаПроверки.Объект.Товары Цикл
    СтрокаПроверки.ДатаОтгрузки = ФормаПроверки.Объект.ДатаОтгрузки;
КонецЦикла;
ФормаПроверки.Модифицированность = Истина;
ФормаПроверки.Заголовок = "Проверка отказа предоплаты — этап 3";
ФормаПроверки.Открыть();
ОшибкаВышлаНаружу = Ложь;
Попытка
    ФормаПроверки.Расш1_СоздатьЗадачу(Неопределено);
Исключение
    ОшибкаВышлаНаружу = Истина;
КонецПопытки;
Если ОшибкаВышлаНаружу Тогда ВызватьИсключение "STAGE3_POSTING_ERROR_RED: ошибка штатного проведения выходит из команды создания"; КонецЕсли;
// Проведение может продолжиться асинхронно: не закрывать форму и не объявлять Green.
// Завершение требует штатного отказа предоплаты, последующего чтения формы и журнала.
Результат = "STAGE3_POSTING_ERROR_COMMAND_RETURNED";
