// Два заказа претендуют на один подтверждённый ID. Без HTTP, полный откат.
Если Не ПравоДоступа("Администрирование", Метаданные)
    Или СтрНайти(НРег(СтрокаСоединенияИнформационнойБазы()), "ка демо") = 0 Тогда ВызватьИсключение "DEMO_ONLY"; КонецЕсли;
Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 2 Ссылка ИЗ Документ.ЗаказКлиента ГДЕ Проведен И НЕ ПометкаУдаления
    |И Ссылка НЕ В (ВЫБРАТЬ Заказ ИЗ РегистрСведений.Расш1_СостояниеЗаказовБ24)
    |И Ссылка НЕ В (ВЫБРАТЬ Заказ ИЗ РегистрСведений.Расш1_СвязиЗаказовБ24)");
Заказы = Запрос.Выполнить().Выгрузить();
Если Заказы.Количество() <> 2 Тогда ВызватьИсключение "Нужны два свободных демозаказа"; КонецЕсли;
Режим = ПривилегированныйРежим(); УстановитьПривилегированныйРежим(Истина); НачатьТранзакцию();
Попытка
    Настройка = РегистрыСведений.Расш1_НастройкиОбменаБ24.СоздатьМенеджерЗаписи();
    Настройка.Ключ = "stage2Enabled"; Настройка.Значение = "true"; Настройка.Записать();
    Первая = Расш1_ОперацииRESTБ24.Зарезервировать(Заказы[0].Ссылка, "conflict-first");
    Вторая = Расш1_ОперацииRESTБ24.Зарезервировать(Заказы[1].Ссылка, "conflict-second");
    Подтверждение = Новый Структура("Состояние,ЗадачаId", "ЗадачаИзвестна", "999999991");
    Расш1_ОперацииRESTБ24.СохранитьОтвет(Первая.ОперацияId, Подтверждение);
    Расш1_ОперацииRESTБ24.СохранитьОтвет(Вторая.ОперацияId, Подтверждение);
    Расш1_ОперацииRESTБ24.ЗаписатьСвязь(Первая.ОперацияId, Ложь);
    Исходная = Расш1_ОперацииRESTБ24.ПрочитатьСостояние(Заказы[0].Ссылка);
    Расш1_ОперацииRESTБ24.ЗаписатьСвязь(Вторая.ОперацияId, Ложь);
    Поздняя = Расш1_ОперацииRESTБ24.ПрочитатьСостояние(Заказы[1].Ссылка);
    Если Исходная.Состояние <> "Связана" Или Поздняя.Состояние <> "Конфликт" Тогда
        ВызватьИсключение "Занятый ID не остановил вторую связь";
    КонецЕсли;
    Перечитанная = Расш1_ОперацииRESTБ24.ПрочитатьСостояние(Заказы[0].Ссылка);
    Если Перечитанная.ОперацияId <> Исходная.ОперацияId Или Перечитанная.ЗадачаId <> Исходная.ЗадачаId
        Или Перечитанная.ВерсияСвязи <> Исходная.ВерсияСвязи Тогда ВызватьИсключение "Первая связь изменилась"; КонецЕсли;
    Запрос = Новый Запрос("ВЫБРАТЬ Заказ ИЗ РегистрСведений.Расш1_СвязиЗаказовБ24 ГДЕ ЗадачаId = &ID");
    Запрос.УстановитьПараметр("ID", "999999991");
    Если Запрос.Выполнить().Выгрузить().Количество() <> 1 Тогда ВызватьИсключение "Нарушена уникальность связи"; КонецЕсли;
    Расш1_ОперацииRESTБ24.СохранитьОтвет(Вторая.ОперацияId, Новый Структура("Состояние,ЗадачаId", "ЗадачаИзвестна", "999999992"));
    Расш1_ОперацииRESTБ24.ЗаписатьСвязь(Вторая.ОперацияId, Ложь);
    Повтор = Расш1_ОперацииRESTБ24.ПрочитатьСостояние(Заказы[1].Ссылка);
    Если Повтор.Состояние <> "Конфликт" Или Повтор.ЗадачаId <> "999999991" Тогда
        ВызватьИсключение "Поздний ответ перезаписал конфликт";
    КонецЕсли;
    ОтменитьТранзакцию(); УстановитьПривилегированныйРежим(Режим);
Исключение
    ОтменитьТранзакцию(); УстановитьПривилегированныйРежим(Режим); ВызватьИсключение;
КонецПопытки;
Результат = Новый Структура("success,cases", Истина, 4);
