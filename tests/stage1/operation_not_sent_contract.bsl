// Терминальная неотправка и история попыток: настоящий код 1С, полный откат, без HTTP.
Если Не ПравоДоступа("Администрирование", Метаданные) Или СтрНайти(НРег(СтрокаСоединенияИнформационнойБазы()), "ка демо") = 0 Тогда ВызватьИсключение "DEMO_ONLY"; КонецЕсли;
Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ.ЗаказКлиента ГДЕ Проведен И НЕ ПометкаУдаления И Ссылка НЕ В (ВЫБРАТЬ Заказ ИЗ РегистрСведений.Расш1_СостояниеЗаказовБ24) И Ссылка НЕ В (ВЫБРАТЬ Заказ ИЗ РегистрСведений.Расш1_СвязиЗаказовБ24)");
Строки = Запрос.Выполнить().Выбрать(); Если Не Строки.Следующий() Тогда ВызватьИсключение "Нет демозаказа"; КонецЕсли;
Заказ = Строки.Ссылка;
Режим = ПривилегированныйРежим(); УстановитьПривилегированныйРежим(Истина); НачатьТранзакцию();
Попытка
    Настройка = РегистрыСведений.Расш1_НастройкиОбменаБ24.СоздатьМенеджерЗаписи();
    Настройка.Ключ = "stage2Enabled"; Настройка.Значение = "true"; Настройка.Записать();
    Первая = Расш1_ОперацииRESTБ24.Зарезервировать(Заказ, "not-sent-test");
    Настройка.Значение = "false"; Настройка.Записать();
    Расш1_ОперацииRESTБ24.ОтправитьОперацию(Первая.ОперацияId);
    Если Расш1_ОперацииRESTБ24.ПрочитатьСостояние(Заказ).Состояние <> "НеОтправлена" Тогда ВызватьИсключение "Неотправка не завершена"; КонецЕсли;
    Настройка.Значение = "true"; Настройка.Записать();
    Расш1_ОперацииRESTБ24.ВосстановитьОперацию(Первая.ОперацияId);
    Если Расш1_ОперацииRESTБ24.ПрочитатьСостояние(Заказ).Состояние <> "НеОтправлена" Тогда ВызватьИсключение "Неотправка стала очередью"; КонецЕсли;
    Вторая = Расш1_ОперацииRESTБ24.Зарезервировать(Заказ, "new-click-test");
    Если Вторая.ОперацияId = Первая.ОперацияId Тогда ВызватьИсключение "Новый клик переписал прежнюю попытку"; КонецЕсли;
    Журнал = РегистрыСведений.Расш1_ЖурналОперацийБ24.СоздатьМенеджерЗаписи();
    Журнал.ОперацияId = Первая.ОперацияId; Журнал.Прочитать();
    Если Не Журнал.Выбран() Или Журнал.ОтправкаНачата Или Журнал.Состояние <> "НеОтправлена" Тогда ВызватьИсключение "История не сохранена"; КонецЕсли;
    Журнал.ОперацияId = Вторая.ОперацияId; Журнал.Прочитать(); Журнал.ОперацияId = Вторая.ОперацияId;
    Журнал.Состояние = "Неизвестно"; Журнал.ОтправкаНачата = Истина; Журнал.Записать();
    Повтор = Расш1_ОперацииRESTБ24.Зарезервировать(Заказ, "unknown-repeat");
    Если Повтор.ОперацияId <> Вторая.ОперацияId Или Повтор.Состояние <> "Неизвестно" Тогда ВызватьИсключение "Неизвестность разрешила новый резерв"; КонецЕсли;
    Отказано = Ложь;
    Попытка Расш1_ОперацииRESTБ24.ИзменитьСвязь(Заказ, "", 0); Исключение Отказано = Истина; КонецПопытки;
    Если Не Отказано Тогда ВызватьИсключение "Неизвестность разрешила удаление связи"; КонецЕсли;
    ОтменитьТранзакцию(); УстановитьПривилегированныйРежим(Режим);
Исключение
    ОтменитьТранзакцию(); УстановитьПривилегированныйРежим(Режим); ВызватьИсключение;
КонецПопытки;
Результат = Новый Структура("success,cases", Истина, 6);
