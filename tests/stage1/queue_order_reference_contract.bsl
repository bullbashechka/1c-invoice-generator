// Живая КА Демо: новый запрос должен сохранить точную ссылку заказа.
// Подстановка параметров — run_queue_order_reference.py. Все записи откатываются.
Заказ = Документы.ЗаказКлиента.ПолучитьСсылку(Новый УникальныйИдентификатор("__ORDER__"));
Если Не ЗначениеЗаполнено(Заказ) Или Не Заказ.Проведен Или Заказ.ПометкаУдаления Тогда
    ВызватьИсключение "QUEUE_REFERENCE_SETUP: требуется проведённый демозаказ";
КонецЕсли;
НачатьТранзакцию();
Попытка
    Операция = РегистрыСведений.Расш1_ОперацииБ24.СоздатьМенеджерЗаписи();
    Операция.Заказ = Заказ; Операция.Прочитать();
    Если Операция.Выбран() Тогда ВызватьИсключение "QUEUE_REFERENCE_SETUP: у заказа уже есть операция"; КонецЕсли;
    ОперацияId = Расш1_ОбменБ24Сервер.ПоставитьВОчередь(Заказ, "__COMPUTER__", "__SESSION__");
    Если ОперацияId = "disabled" Или ОперацияId = "ineligible" Тогда
        ВызватьИсключение "QUEUE_REFERENCE_SETUP: обмен не готов";
    КонецЕсли;
    Операция = РегистрыСведений.Расш1_ОперацииБ24.СоздатьМенеджерЗаписи();
    Операция.Заказ = Заказ; Операция.Прочитать();
    Если Не Операция.Выбран() Тогда
        ВызватьИсключение "QUEUE_REFERENCE_RED: новая операция не записана под исходным заказом";
    КонецЕсли;
    Если Операция.Заказ <> Заказ Или Операция.ОперацияId <> ОперацияId
        Или Операция.Состояние <> "queued" Или Операция.Опубликована <> "false" Тогда
        ВызватьИсключение "QUEUE_REFERENCE_RED: контекст новой операции повреждён";
    КонецЕсли;
    ОтменитьТранзакцию();
    Результат = "QUEUE_REFERENCE_CONTRACT_GREEN";
Исключение
    ОтменитьТранзакцию(); ВызватьИсключение;
КонецПопытки;
