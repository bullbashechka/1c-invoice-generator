// Серверный BSL-прогон через execute_code в КА Демо, без записи и REST-вызовов.
// Проверяется тело реальной процедуры из исходников; расширение не устанавливается.
// КаталогИсходников задаётся оболочкой как абсолютный путь к репозиторию.
ЧтениеИсходника = Новый ЧтениеТекста(КаталогИсходников
    + "/src/stage-1-prototype/CommonModules/Расш1_RESTБ24Сервер/Ext/Module.bsl", КодировкаТекста.UTF8);
Исходник = ЧтениеИсходника.Прочитать();
ЧтениеИсходника.Закрыть();
НачалоТела = СтрНайти(Исходник, "// REST_JSON_BODY_BEGIN");
КонецТела = СтрНайти(Исходник, "// REST_JSON_BODY_END");
Если НачалоТела = 0 Или КонецТела <= НачалоТела Тогда
    ВызватьИсключение "REST_JSON_RED: не найдено тело процедуры";
КонецЕсли;
ТелоПроцедуры = Сред(Исходник, НачалоТела, КонецТела - НачалоТела);
Разбор = Неопределено;

// Числовые ключи allowedActions встречаются в реальном ответе Б24.
ТекстОтвета = "{""result"":{""task"":{""id"":""10026"",""allowedActions"":{""2"":true}}}}";
Выполнить(ТелоПроцедуры);
Если Разбор.Состояние <> "Результат" Тогда
    ВызватьИсключение "REST_JSON_RED: корректная задача не прочитана";
КонецЕсли;
Данные = Разбор.Данные;
Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
    ВызватьИсключение "REST_JSON_RED: корень ответа не является соответствием";
КонецЕсли;
Задача = Данные.Получить("task");
Если Задача.Получить("id") <> "10026"
    Или Задача.Получить("allowedActions").Получить("2") <> Истина Тогда
    ВызватьИсключение "REST_JSON_RED: потеря ID или числового ключа";
КонецЕсли;

// Реальный пустой result нельзя читать как result.task и считать неотправкой.
ТекстОтвета = "{""result"":[]}";
Выполнить(ТелоПроцедуры);
Если Разбор.Состояние <> "Неизвестно" Или Разбор.Данные <> Неопределено Тогда
    ВызватьИсключение "REST_JSON_RED: пустой результат не распознан";
КонецЕсли;
ТекстОтвета = "{""result"":";
Выполнить(ТелоПроцедуры);
Если Разбор.Состояние <> "Неизвестно" Тогда
    ВызватьИсключение "REST_JSON_RED: оборванный ответ принят как результат";
КонецЕсли;
ТекстОтвета = "{""error"":""ACCESS_DENIED"",""error_description"":""Закрытые данные""}";
Выполнить(ТелоПроцедуры);
Если Разбор.Состояние <> "ОшибкаAPI" Или Разбор.КодОшибки <> "ACCESS_DENIED"
    Или Разбор.Данные <> Неопределено Тогда
    ВызватьИсключение "REST_JSON_RED: отказ API не отделён от результата";
КонецЕсли;
Результат = "REST_JSON_CONTRACT_GREEN";
