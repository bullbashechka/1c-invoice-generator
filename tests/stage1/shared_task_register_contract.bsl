// Настоящий регистр 1С, четыре синтетические ссылки, без документов и HTTP.
// Весь прогон откатывается. Запускать только в КА Демо.
Если Не ПравоДоступа("Администрирование", Метаданные)
    Или СтрНайти(НРег(СтрокаСоединенияИнформационнойБазы()), "ка демо") = 0 Тогда
    ВызватьИсключение "DEMO_ONLY";
КонецЕсли;
Заказы = Новый Массив;
Операции = Новый Массив;
ID = "2100000799";
// ID ресурса не обязан быть реальной задачей: этот контракт проверяет запись регистра.
НачатьТранзакцию();
Попытка
    Для Номер = 1 По 4 Цикл
        Заказ = Документы.ЗаказКлиента.ПолучитьСсылку(Новый УникальныйИдентификатор);
        Операция = Строка(Новый УникальныйИдентификатор);
        Заказы.Добавить(Заказ); Операции.Добавить(Операция);
        Набор = РегистрыСведений.Расш1_СвязиЗаказовБ24.СоздатьНаборЗаписей();
        Набор.Отбор.Заказ.Установить(Заказ);
        Запись = Набор.Добавить();
        Запись.Заказ = Заказ; Запись.ЗадачаId = ID; Запись.ОперацияId = Операция;
        Набор.Записать();
    КонецЦикла;
    Запрос = Новый Запрос("ВЫБРАТЬ Заказ, ЗадачаId, ОперацияId
        |ИЗ РегистрСведений.Расш1_СвязиЗаказовБ24 ГДЕ Заказ В (&Заказы)");
    Запрос.УстановитьПараметр("Заказы", Заказы);
    Строки = Запрос.Выполнить().Выгрузить();
    Если Строки.Количество() <> 4 Тогда ВызватьИсключение "SHARED_TASK_RED: сохранены не четыре связи"; КонецЕсли;
    Для Каждого Строка Из Строки Цикл
        Если Строка.ЗадачаId <> ID Или Операции.Найти(Строка.ОперацияId) = Неопределено Тогда
            ВызватьИсключение "SHARED_TASK_RED: изменены данные связи";
        КонецЕсли;
    КонецЦикла;
    // Точная повторная доставка не изменяет остальные связи.
    Набор = РегистрыСведений.Расш1_СвязиЗаказовБ24.СоздатьНаборЗаписей();
    Набор.Отбор.Заказ.Установить(Заказы[0]);
    Запись = Набор.Добавить();
    Запись.Заказ = Заказы[0]; Запись.ЗадачаId = ID; Запись.ОперацияId = Операции[0];
    Набор.Записать();
    Если Запрос.Выполнить().Выгрузить().Количество() <> 4 Тогда ВызватьИсключение "SHARED_TASK_RED: повтор изменил связи"; КонецЕсли;
    // Один пакет также допускает общий ID; операции у всех строк независимы.
    Пакет = РегистрыСведений.Расш1_СвязиЗаказовБ24.СоздатьНаборЗаписей();
    ЗаказыПакета = Новый Массив;
    Для Номер = 1 По 4 Цикл
        Запись = Пакет.Добавить();
        Запись.Заказ = Документы.ЗаказКлиента.ПолучитьСсылку(Новый УникальныйИдентификатор);
        ЗаказыПакета.Добавить(Запись.Заказ);
        Запись.ЗадачаId = ID; Запись.ОперацияId = Строка(Новый УникальныйИдентификатор);
    КонецЦикла;
    Пакет.Записать(Ложь);
    Запрос.УстановитьПараметр("Заказы", ЗаказыПакета);
    Если Запрос.Выполнить().Выгрузить().Количество() <> 4 Тогда ВызватьИсключение "SHARED_TASK_RED: пакет не сохранён"; КонецЕсли;
    ОтменитьТранзакцию();
Исключение
    ОтменитьТранзакцию(); ВызватьИсключение;
КонецПопытки;
Результат = "SHARED_TASK_REGISTER_GREEN";
