// Только чтение документированной старой демооперации с обрезанным маркером.
ЗаказПроверки = ПолучитьСсылкуПоТипуИUUID("Документ", "ЗаказКлиента", "109e05b5-fdd2-11e6-b139-0050568b35ac");
Состояние = Расш1_СервисRESTБ24.СостояниеЗаказа(ЗаказПроверки);
Если Состояние.Состояние <> "Неизвестно" Или Состояние.ОперацияId <> "a75ba748-104a-4735-951d-8554c96e2b9b" Тогда
    ВызватьИсключение "KNOWN_UNKNOWN_DEMO_OPERATION_REQUIRED";
КонецЕсли;
Для НомерПроверки = 1 По 2 Цикл
    ФормаПроверки = ПолучитьФорму("Документ.ЗаказКлиента.Форма.ФормаДокумента",
        Новый Структура("Ключ", ЗаказПроверки), , Новый УникальныйИдентификатор);
    ФормаПроверки.Открыть();
    ФормаПроверки.Расш1_ОбновитьБ24(Неопределено);
    Если ФормаПроверки.Расш1_СостояниеБ24 <> "Неизвестно"
        Или ФормаПроверки.Расш1_ТекстБ24 <> "Проверяем, создана ли задача"
        Или Не ФормаПроверки.Элементы.Расш1_ТекстБ24.Видимость
        Или ФормаПроверки.Расш1_ЗадачаСоздана
        Или ФормаПроверки.Расш1_НомерЗадачиБ24 <> ""
        Или ФормаПроверки.Модифицированность Тогда
        ВызватьИсключение "STAGE3_UNKNOWN_FORM_RED: неизвестность показана неверно";
    КонецЕсли;
    ФормаПроверки.Закрыть();
КонецЦикла;
Результат = "STAGE3_UNKNOWN_FORM_GREEN";
