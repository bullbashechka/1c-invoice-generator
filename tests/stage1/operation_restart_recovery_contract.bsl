// Только чтение после отдельного живого сбоя и перезапуска 1С.
// ДиагностическийСеанс — уникальная метка уже выполненного прогона; add не вызывается.
Если Не ПравоДоступа("Администрирование", Метаданные)
    Или СтрНайти(НРег(СтрокаСоединенияИнформационнойБазы()), "ка демо") = 0 Тогда ВызватьИсключение "DEMO_ONLY"; КонецЕсли;
Режим = ПривилегированныйРежим(); УстановитьПривилегированныйРежим(Истина);
Запрос = Новый Запрос("ВЫБРАТЬ ОперацияId, Заказ, Состояние, ЗадачаId, СнимокJSON, Портал
    |ИЗ РегистрСведений.Расш1_ЖурналОперацийБ24 ГДЕ СеансId = &Сеанс");
Запрос.УстановитьПараметр("Сеанс", ДиагностическийСеанс);
Строки = Запрос.Выполнить().Выгрузить();
Если Строки.Количество() <> 1 Тогда ВызватьИсключение "Нет единственной диагностической операции"; КонецЕсли;
Операция = Строки[0];
Настройка = РегистрыСведений.Расш1_НастройкиОбменаБ24.СоздатьМенеджерЗаписи();
Настройка.Ключ = "stage2Enabled"; Настройка.Прочитать();
ДопускВыключен = Настройка.Значение = "false";
УстановитьПривилегированныйРежим(Режим);
Если Не ДопускВыключен Тогда ВызватьИсключение "Создание должно оставаться выключенным"; КонецЕсли;
Если Операция.Состояние <> "Завершена" Или ПустаяСтрока(Операция.ЗадачаId) Тогда
    ВызватьИсключение "Фоновое восстановление после входа не завершилось";
КонецЕсли;
Снимок = Расш1_RESTБ24Сервер.ДанныеJSON(Операция.СнимокJSON);
Поля = Снимок.Получить("fields"); Маркер = Поля.Получить("XML_ID");
Если Маркер <> "KA2:" + Операция.ОперацияId Или СтрДлина(Маркер) <> 40 Тогда
    ВызватьИсключение "Неверный полный маркер операции";
КонецЕсли;
Найдена = Расш1_RESTБ24Сервер.НайтиПоМаркеру(Операция.Портал, Маркер);
Если Найдена.Состояние <> "ЗадачаИзвестна" Или Найдена.ЗадачаId <> Операция.ЗадачаId Тогда
    ВызватьИсключение "Единственная исходная задача по полному маркеру не подтверждена";
КонецЕсли;
Связь = Расш1_ОперацииRESTБ24.ПрочитатьСостояние(Операция.Заказ);
Если Связь.Состояние <> "Связана" Или Связь.ЗадачаId <> Операция.ЗадачаId Тогда
    ВызватьИсключение "Восстановленная задача не связана с исходным заказом";
КонецЕсли;
Ответ = Расш1_RESTБ24Сервер.ПрочитатьЗадачуREST(Число(Операция.ЗадачаId));
Если Ответ.Состояние <> "Результат" Тогда ВызватьИсключение "Не удалось перечитать задачу"; КонецЕсли;
Задача = Ответ.Данные.Получить("task");
Если Задача.Получить("title") <> Поля.Получить("TITLE") Или Задача.Получить("description") <> Поля.Получить("DESCRIPTION") Тогда
    ВызватьИсключение "Название или описание не совпадает со снимком";
КонецЕсли;
Если Число(Задача.Получить("createdBy")) <> Поля.Получить("CREATED_BY")
    Или Число(Задача.Получить("responsibleId")) <> Поля.Получить("RESPONSIBLE_ID")
    Или Число(Задача.Получить("groupId")) <> Поля.Получить("GROUP_ID") Тогда ВызватьИсключение "Роли или проект не совпадают"; КонецЕсли;
Наблюдатели = Задача.Получить("auditors");
Если ТипЗнч(Наблюдатели) <> Тип("Массив") Или Наблюдатели.Количество() <> 2
    Или Наблюдатели.Найти("10") = Неопределено Или Наблюдатели.Найти("30") = Неопределено Тогда
    ВызватьИсключение "Наблюдатели не совпадают";
КонецЕсли;
СрокСнимка = Поля.Получить("DEADLINE");
СрокUTC = Дата(Число(Лев(СрокСнимка, 4)), Число(Сред(СрокСнимка, 6, 2)), Число(Сред(СрокСнимка, 9, 2)), 14, 0, 0);
Если Расш1_RESTБ24Сервер.СрокЗадачиИстек(Задача, СрокUTC)
    Или Не Расш1_RESTБ24Сервер.СрокЗадачиИстек(Задача, СрокUTC + 1) Тогда
    ВызватьИсключение "Срок задачи не совпадает с неизменным сроком операции";
КонецЕсли;
Результат = Новый Структура("success,taskId,operationId,cases,deadline,snapshotDeadline",
    Истина, Операция.ЗадачаId, Операция.ОперацияId, 8, Задача.Получить("deadline"), СрокСнимка);
