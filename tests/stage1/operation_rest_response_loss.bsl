// Живой REST-прогон: создаёт ОДНУ настоящую демозадачу и сохраняет её связь.
// Запуск только после сверки fingerprint и с явным РазрешенЖивойПрогон = Истина.
// Это управляемое отбрасывание настоящего ответа до записи ID, не обрыв TCP.
Если Не РазрешенЖивойПрогон Или Не ПравоДоступа("Администрирование", Метаданные)
    Или СтрНайти(НРег(СтрокаСоединенияИнформационнойБазы()), "ка демо") = 0 Тогда ВызватьИсключение "DEMO_LIVE_ONLY"; КонецЕсли;
Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ.ЗаказКлиента
    |ГДЕ Проведен И НЕ ПометкаУдаления И Ссылка НЕ В (ВЫБРАТЬ Заказ ИЗ РегистрСведений.Расш1_СвязиЗаказовБ24)
    |И Ссылка НЕ В (ВЫБРАТЬ Заказ ИЗ РегистрСведений.Расш1_СостояниеЗаказовБ24)");
Строки = Запрос.Выполнить().Выбрать(); Если Не Строки.Следующий() Тогда ВызватьИсключение "Нет проведённого несвязанного демозаказа"; КонецЕсли;
Заказ = Строки.Ссылка;
Режим = ПривилегированныйРежим(); УстановитьПривилегированныйРежим(Истина);
Настройка = РегистрыСведений.Расш1_НастройкиОбменаБ24.СоздатьМенеджерЗаписи();
Настройка.Ключ = "stage2Enabled"; Настройка.Значение = "true"; Настройка.Записать();
УстановитьПривилегированныйРежим(Режим);
Попытка
    Попытка1 = Расш1_ОперацииRESTБ24.Зарезервировать(Заказ, "response-loss-test");
    Если Попытка1.Состояние <> "Резерв" Тогда ВызватьИсключение "Заказ уже занят операцией"; КонецЕсли;
    Сбой = Ложь;
    Попытка Расш1_ОперацииRESTБ24.ОтправитьОперацию(Попытка1.ОперацияId, "after-response"); Исключение
        Сбой = СтрНайти(ОписаниеОшибки(), "KA2_DIAGNOSTIC_RESPONSE_DISCARDED") > 0;
    КонецПопытки;
    Если Не Сбой Тогда ВызватьИсключение "Потеря результата не воспроизведена"; КонецЕсли;
    Состояние = Расш1_ОперацииRESTБ24.ПрочитатьСостояние(Заказ);
    Если Не ПустаяСтрока(Состояние.ЗадачаId) Тогда ВызватьИсключение "ID сохранился несмотря на сбой"; КонецЕсли;
    УстановитьПривилегированныйРежим(Истина);
    Журнал = РегистрыСведений.Расш1_ЖурналОперацийБ24.СоздатьМенеджерЗаписи();
    Журнал.ОперацияId = Попытка1.ОперацияId; Журнал.Прочитать(); СнимокДо = Журнал.СнимокJSON;
    Портал = Журнал.Портал;
    Маркер = Расш1_RESTБ24Сервер.ДанныеJSON(Журнал.СнимокJSON).Получить("fields").Получить("XML_ID");
    УстановитьПривилегированныйРежим(Режим);
    Найдена = Расш1_RESTБ24Сервер.НайтиПоМаркеру(Портал, Маркер);
    Если Найдена.Состояние <> "ЗадачаИзвестна" Тогда ВызватьИсключение "Единственная задача по точному маркеру не подтверждена"; КонецЕсли;
    Расш1_ОперацииRESTБ24.ВосстановитьОперацию(Попытка1.ОперацияId);
    После = Расш1_ОперацииRESTБ24.ПрочитатьСостояние(Заказ);
    Если После.Состояние <> "Связана" Или После.ЗадачаId <> Найдена.ЗадачаId Тогда ВызватьИсключение "Не восстановлена та же задача"; КонецЕсли;
    // Повторный вызов отправки для завершённой операции должен быть безопасным.
    Расш1_ОперацииRESTБ24.ОтправитьОперацию(Попытка1.ОперацияId);
    ПовторныйПоиск = Расш1_RESTБ24Сервер.НайтиПоМаркеру(Портал, Маркер);
    Если ПовторныйПоиск.Состояние <> "ЗадачаИзвестна" Или ПовторныйПоиск.ЗадачаId <> Найдена.ЗадачаId Тогда ВызватьИсключение "Повтор изменил задачу или создал дубль"; КонецЕсли;
    УстановитьПривилегированныйРежим(Истина); Журнал.ОперацияId = Попытка1.ОперацияId; Журнал.Прочитать();
    Если Журнал.СнимокJSON <> СнимокДо Или Журнал.Состояние <> "Завершена" Тогда ВызватьИсключение "Снимок изменился при восстановлении"; КонецЕсли;
    Настройка.Ключ = "stage2Enabled"; Настройка.Значение = "false"; Настройка.Записать();
    УстановитьПривилегированныйРежим(Режим);
    Результат = Новый Структура("success,taskId,operationId,cases", Истина, После.ЗадачаId, Попытка1.ОперацияId, 6);
Исключение
    УстановитьПривилегированныйРежим(Истина);
    Настройка.Ключ = "stage2Enabled"; Настройка.Значение = "false"; Настройка.Записать();
    УстановитьПривилегированныйРежим(Режим); ВызватьИсключение;
КонецПопытки;
