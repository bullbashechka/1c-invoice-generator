// Проверяет подтверждённую замену без изменения соседней связи. Настоящий REST get, полный откат.
Если Не ПравоДоступа("Администрирование", Метаданные)
    Или СтрНайти(НРег(СтрокаСоединенияИнформационнойБазы()), "ка демо") = 0 Тогда ВызватьИсключение "DEMO_ONLY"; КонецЕсли;
Запрос = Новый Запрос("ВЫБРАТЬ Связи.Заказ КАК Заказ, Связи.ЗадачаId КАК ЗадачаId
    |ИЗ РегистрСведений.Расш1_СвязиЗаказовБ24 КАК Связи
    |ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Расш1_СостояниеЗаказовБ24 КАК Состояния ПО Связи.Заказ = Состояния.Заказ
    |ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Расш1_ЖурналОперацийБ24 КАК Операции ПО Состояния.ОперацияId = Операции.ОперацияId
    |ГДЕ Связи.Заказ.Комментарий ПОДОБНО &Тест И Операции.Состояние = &Завершена
    |УПОРЯДОЧИТЬ ПО Связи.ЗадачаId");
Запрос.УстановитьПараметр("Тест", "STAGE3_%"); Запрос.УстановитьПараметр("Завершена", "Завершена");
Пары = Запрос.Выполнить().Выгрузить();
А = Неопределено; Б = Неопределено; ID = "10072";
Для Каждого Пара Из Пары Цикл
    Если Пара.ЗадачаId = ID Тогда Б = Пара.Заказ;
    ИначеЕсли А = Неопределено Тогда А = Пара.Заказ; КонецЕсли;
КонецЦикла;
Если А = Неопределено Или Б = Неопределено Тогда ВызватьИсключение "OWN_TWO_COMPLETED_TASKS_REQUIRED"; КонецЕсли;
ДоА = Расш1_СервисRESTБ24.СостояниеЗаказа(А); ДоБ = Расш1_СервисRESTБ24.СостояниеЗаказа(Б);
НачатьТранзакцию();
Попытка
    Кандидат = Расш1_СервисRESTБ24.ПроверитьКандидата(А, ID, ДоА.ВерсияСвязи);
    Если Не Кандидат.ТребуетсяЗамена Или Кандидат.ПрежняяЗадачаId <> ДоА.ЗадачаId Тогда
        ВызватьИсключение "REPLACE_LIVE_RED: нет прежнего ID для подтверждения";
    КонецЕсли;
    Расш1_СервисRESTБ24.ПодтвердитьПривязку(А, Кандидат, Ложь, Ложь, Истина);
    ПослеА = Расш1_СервисRESTБ24.СостояниеЗаказа(А); ПослеБ = Расш1_СервисRESTБ24.СостояниеЗаказа(Б);
    Если ПослеА.ЗадачаId <> ID Или ПослеА.ВерсияСвязи <> ДоА.ВерсияСвязи + 1 Тогда ВызватьИсключение "REPLACE_LIVE_RED: подтверждённая замена не сохранена"; КонецЕсли;
    Если ПослеБ.ЗадачаId <> ДоБ.ЗадачаId Или ПослеБ.ВерсияСвязи <> ДоБ.ВерсияСвязи Тогда ВызватьИсключение "REPLACE_LIVE_RED: соседняя связь изменена"; КонецЕсли;
    ОтменитьТранзакцию();
Исключение Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли; ВызватьИсключение; КонецПопытки;
ПослеА = Расш1_СервисRESTБ24.СостояниеЗаказа(А); ПослеБ = Расш1_СервисRESTБ24.СостояниеЗаказа(Б);
Если ПослеА.ЗадачаId <> ДоА.ЗадачаId Или ПослеА.ВерсияСвязи <> ДоА.ВерсияСвязи
    Или ПослеБ.ЗадачаId <> ДоБ.ЗадачаId Или ПослеБ.ВерсияСвязи <> ДоБ.ВерсияСвязи Тогда ВызватьИсключение "REPLACE_LIVE_RED: исходные связи не восстановлены"; КонецЕсли;
Результат = "SHARED_TASK_REPLACE_LIVE_GREEN";
