// Только КА Демо: конфликт операции внутри одного набора записей.
// Ссылки синтетические; заказов и задач Б24 нет. Транзакция всегда откатывается.
Заказ1 = Документы.ЗаказКлиента.ПолучитьСсылку(Новый УникальныйИдентификатор);
Заказ2 = Документы.ЗаказКлиента.ПолучитьСсылку(Новый УникальныйИдентификатор);
Операция = Строка(Новый УникальныйИдентификатор);
КонфликтОперации = Ложь;
ТекстНеожиданнойОшибки = "";
НачатьТранзакцию();
Попытка
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Заказ
        |ИЗ РегистрСведений.Расш1_СвязиЗаказовБ24
        |ГДЕ ЗадачаId = &Задача1 ИЛИ ЗадачаId = &Задача2");
    Запрос.УстановитьПараметр("Задача1", "2100000031");
    Запрос.УстановитьПараметр("Задача2", "2100000032");
    Если Не Запрос.Выполнить().Пустой() Тогда
        ВызватьИсключение "STAGE1_TEST_PRECONDITION: тестовые ID уже заняты";
    КонецЕсли;
    Набор = РегистрыСведений.Расш1_СвязиЗаказовБ24.СоздатьНаборЗаписей();
    Связь1 = Набор.Добавить();
    Связь1.Заказ = Заказ1;
    Связь1.ЗадачаId = "2100000031";
    Связь1.ОперацияId = Операция;
    Связь2 = Набор.Добавить();
    Связь2.Заказ = Заказ2;
    Связь2.ЗадачаId = "2100000032";
    Связь2.ОперацияId = Операция;
    Набор.Записать(Ложь);
Исключение
    Если СтрНайти(ОписаниеОшибки(), "STAGE1_OPERATION_CONFLICT") > 0 Тогда
        КонфликтОперации = Истина;
    Иначе
        ТекстНеожиданнойОшибки = ОписаниеОшибки();
    КонецЕсли;
КонецПопытки;
ОтменитьТранзакцию();
Если ТекстНеожиданнойОшибки <> "" Тогда
    ВызватьИсключение ТекстНеожиданнойОшибки;
КонецЕсли;
Если Не КонфликтОперации Тогда
    ВызватьИсключение "STAGE1_RED: один пакет принял две связи с одинаковой операцией";
КонецЕсли;
Результат = "STAGE1_BATCH_OPERATION_GREEN";
