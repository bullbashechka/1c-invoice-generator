Перем Расш1_СеансБ24 Экспорт;
Перем Расш1_ОшибкаОбменаБ24 Экспорт;
Перем Расш1_ОбменБ24Занят;
Перем Расш1_HeartbeatБ24;
Перем Расш1_КурсорСтатусовБ24;

&После("ПриНачалеРаботыСистемы")
Процедура Расш1_ПриНачалеРаботыСистемы()
    Расш1_СеансБ24 = Строка(Новый УникальныйИдентификатор);
    Расш1_ОшибкаОбменаБ24 = "";
    Расш1_КурсорСтатусовБ24 = "";
    Расш1_ОбменБ24Занят = Ложь;
    Расш1_HeartbeatБ24 = Истина;
    ПодключитьОбработчикОжидания("Расш1_ОпросОбменаБ24", 5);
    Расш1_ОпросОбменаБ24();
КонецПроцедуры

Процедура Расш1_ОпросОбменаБ24() Экспорт
    Если Расш1_ОбменБ24Занят Тогда Возврат; КонецЕсли;
    Расш1_ОбменБ24Занят = Истина;
    Попытка
        Если Расш1_ОбменБ24Сервер.Опрос(ИмяКомпьютера(), Расш1_СеансБ24, Расш1_HeartbeatБ24) Тогда
            Оповестить("Расш1_СвязьБ24");
        КонецЕсли;
        Расш1_КурсорСтатусовБ24 = Расш1_ОбменБ24Сервер.ОбновитьСостояния(ИмяКомпьютера(), Расш1_КурсорСтатусовБ24);
        Расш1_ОшибкаОбменаБ24 = "";
        Расш1_HeartbeatБ24 = Не Расш1_HeartbeatБ24;
    Исключение
        // Следующий опрос повторяет обмен. Тела HTTP, настройки и секреты не журналируются.
        Расш1_HeartbeatБ24 = Истина;
        Расш1_ОшибкаОбменаБ24 = "service_unavailable";
    КонецПопытки;
    Расш1_ОбменБ24Занят = Ложь;
    // Обновляется и доставка, и ошибка обмена; сохранение связи не является
    // единственным событием изменения блока.
    Оповестить("Расш1_СостояниеБ24");
КонецПроцедуры
