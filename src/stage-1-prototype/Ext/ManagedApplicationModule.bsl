            // Подтверждение после вызова показа. При аварии между ними сообщение повторится.
            ПоказатьОповещениеПользователя("Битрикс24", , Сообщение.Текст);
            Расш1_СервисRESTБ24.ПодтвердитьПоказ(Сообщение.СообщениеId);
        КонецЦикла;
