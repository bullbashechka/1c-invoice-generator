// Демопрототип: очередь и связь без изменения сохранённого заказа.
&НаСервере
&После("ПриСозданииНаСервере")
Процедура Расш1_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Блок = Элементы.Добавить("Расш1_БлокЗадачаБ24", Тип("ГруппаФормы"));
	Блок.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Блок.Заголовок = "Задача Битрикс24";
	Блок.ОтображатьЗаголовок = Истина;

	Реквизиты = Новый Массив;
	Для Каждого Имя Из СтрРазделить("Расш1_СостояниеБ24,Расш1_ОшибкаБ24,Расш1_НомерЗадачиБ24,Расш1_СсылкаЗадачиБ24,Расш1_ОперацияБ24", ",") Цикл
		Реквизиты.Добавить(Новый РеквизитФормы(Имя, Новый ОписаниеТипов("Строка")));
	КонецЦикла;
	ИзменитьРеквизиты(Реквизиты);
	Расш1_ДобавитьПолеБ24("Расш1_СостояниеБ24", "Состояние", Блок);
	Расш1_ДобавитьПолеБ24("Расш1_ОшибкаБ24", "Ошибка обмена", Блок);
	Расш1_ДобавитьПолеБ24("Расш1_НомерЗадачиБ24", "Номер задачи", Блок);
	Расш1_ДобавитьПолеБ24("Расш1_СсылкаЗадачиБ24", "Ссылка на задачу Б24", Блок);
	Расш1_ДобавитьПолеБ24("Расш1_ОперацияБ24", "Операция обмена", Блок);
	Команда = Команды.Добавить("Расш1_ОбновитьБ24");
	Команда.Заголовок = "Обновить состояние Б24";
	Команда.Действие = "Расш1_ОбновитьБ24";
	Кнопка = Элементы.Добавить("Расш1_ОбновитьБ24", Тип("КнопкаФормы"), Блок);
	Кнопка.ИмяКоманды = Команда.Имя;
	Расш1_ОбновитьСтатусНаСервере("", "");

КонецПроцедуры

&НаСервере
Процедура Расш1_ДобавитьПолеБ24(Имя, Заголовок, Блок)
    Поле = Элементы.Добавить(Имя, Тип("ПолеФормы"), Блок);
    Поле.Вид = ВидПоляФормы.ПолеВвода;
    Поле.ПутьКДанным = Имя;
    Поле.Заголовок = Заголовок;
    Поле.ТолькоПросмотр = Истина;
    Поле.Ширина = 70;
    Поле.РастягиватьПоГоризонтали = Истина;
    Если Имя = "Расш1_ОшибкаБ24" Или Имя = "Расш1_СостояниеБ24" Тогда
        Поле.МногострочныйРежим = Истина;
        Поле.Высота = 2;
    КонецЕсли;
КонецПроцедуры

// Очередь создаётся только после успешного штатного проведения с закрытием.
&НаКлиенте
&После("ПослеЗаписи")
Процедура Расш1_ПослеЗаписи(ПараметрыЗаписи)
	// Обычная запись обновляет блок, но не создаёт заявку.
	Расш1_ОбновитьБ24(Неопределено);

	РежимЗаписи = Неопределено;
	ЗакрытьПослеЗаписи = Ложь;
	Если Не ПараметрыЗаписи.Свойство("РежимЗаписи", РежимЗаписи)
		Или РежимЗаписи <> РежимЗаписиДокумента.Проведение Тогда
		Возврат;
	КонецЕсли;
	Если Не ПараметрыЗаписи.Свойство("ПринудительноЗакрытьФорму", ЗакрытьПослеЗаписи)
		Или ЗакрытьПослеЗаписи <> Истина Тогда
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Расш1_ЗафиксироватьПроведениеИЗакрытие(Объект.Ссылка, ИмяКомпьютера(), Расш1_СеансБ24);
	Исключение
		// Ошибка прототипа не отменяет успешную штатную запись документа.
		Сообщить("Не удалось поставить запрос Б24 в очередь. Заказ проведён.");
	КонецПопытки;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура Расш1_ЗафиксироватьПроведениеИЗакрытие(СсылкаЗаказа, Компьютер, СеансId)

	Если Не СсылкаЗаказа.Проведен Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1 Заказ
		|ИЗ РегистрСведений.Расш1_СвязиЗаказовБ24
		|ГДЕ Заказ = &Заказ");
	Запрос.УстановитьПараметр("Заказ", СсылкаЗаказа);
	Если Не Запрос.Выполнить().Пустой() Тогда
		Возврат;
	КонецЕсли;

	Расш1_ОбменБ24Сервер.ПоставитьВОчередь(СсылкаЗаказа, Компьютер, СеансId);
	ЗаписьЖурналаРегистрации("STAGE1_POST_CLOSE",
		УровеньЖурналаРегистрации.Информация,
		Метаданные.Документы.ЗаказКлиента, СсылкаЗаказа,
		"Демопрототип: успешное проведение с закрытием без связи; постановка в очередь зависит от настроек.");

КонецПроцедуры

&НаКлиенте
&После("ОбработкаОповещения")
Процедура Расш1_ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
    Если ИмяСобытия = "Расш1_СвязьБ24" Или ИмяСобытия = "Расш1_СостояниеБ24" Тогда
        Расш1_ОбновитьБ24(Неопределено);
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
&После("ПриОткрытии")
Процедура Расш1_ПриОткрытии(Отказ)
    Если Отказ Тогда Возврат; КонецЕсли;
    Расш1_ОбновитьБ24(Истина);
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ОбновитьБ24(Команда)
    Попытка
        Расш1_ОбновитьСтатусНаСервере(ИмяКомпьютера(), Расш1_ОшибкаОбменаБ24, Команда <> Неопределено);
    Исключение
        // Последний номер и адрес сохраняются. Ошибка не отменяет запись заказа.
        ЭтотОбъект.Расш1_ОшибкаБ24 = "Не удалось обновить состояние Б24 в 1С. Показаны последние прочитанные данные.";
        Элементы.Расш1_ОшибкаБ24.Видимость = Истина;
    КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура Расш1_ОбновитьСтатусНаСервере(Компьютер, ОшибкаСеанса, ОбновитьИзСервиса = Ложь)
    Попытка
        Данные = Расш1_ОбменБ24Сервер.ДанныеЗаказа(Объект.Ссылка, Компьютер, ОшибкаСеанса, ОбновитьИзСервиса);
        ЭтотОбъект.Расш1_СостояниеБ24 = Данные.Состояние;
        ЭтотОбъект.Расш1_ОшибкаБ24 = Данные.Ошибка;
        ЭтотОбъект.Расш1_НомерЗадачиБ24 = Данные.ЗадачаId;
        ЭтотОбъект.Расш1_СсылкаЗадачиБ24 = Данные.Ссылка;
        ЭтотОбъект.Расш1_ОперацияБ24 = Данные.ОперацияId;
    Исключение
        ЭтотОбъект.Расш1_ОшибкаБ24 = "Не удалось прочитать состояние Б24 в 1С. Показаны последние прочитанные данные.";
    КонецПопытки;
    Элементы.Расш1_ОшибкаБ24.Видимость = Не ПустаяСтрока(ЭтотОбъект.Расш1_ОшибкаБ24);
КонецПроцедуры
