// Этап 3: запись и проведение сами не создают задачи.
&НаКлиенте
Перем Расш1_ПродолжениеЗакрытия;
&НаКлиенте
Перем Расш1_КликСоздания;

&НаСервере
&После("ПриСозданииНаСервере")
Процедура Расш1_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    Если Отказ Тогда Возврат; КонецЕсли;
    Расш1_ПодготовитьВерхБ24();
    Расш1_ОбновитьСтатусНаСервере();
КонецПроцедуры

&НаСервере
Процедура Расш1_ПодготовитьВерхБ24()
    Если Элементы.Найти("Расш1_ВерхБ24") <> Неопределено Тогда Возврат; КонецЕсли;
    Реквизиты = Новый Массив;
    Для Каждого Имя Из СтрРазделить("Расш1_СостояниеБ24,Расш1_ОшибкаБ24,Расш1_НомерЗадачиБ24,Расш1_СсылкаЗадачиБ24,Расш1_ОперацияБ24,Расш1_НазваниеБ24,Расш1_ТекстБ24", ",") Цикл
        Реквизиты.Добавить(Новый РеквизитФормы(Имя, Новый ОписаниеТипов("Строка")));
    КонецЦикла;
    Реквизиты.Добавить(Новый РеквизитФормы("Расш1_ЗадачаСоздана", Новый ОписаниеТипов("Булево")));
    Реквизиты.Добавить(Новый РеквизитФормы("Расш1_ВерсияСвязи", Новый ОписаниеТипов("Число")));
    ИзменитьРеквизиты(Реквизиты);
    Верх = Элементы.Вставить("Расш1_ВерхБ24", Тип("ГруппаФормы"), , Элементы.ГруппаСтатусПриоритет);
    Верх.Вид = ВидГруппыФормы.ОбычнаяГруппа; Верх.ОтображатьЗаголовок = Ложь;
    Для Каждого Имя Из СтрРазделить("Расш1_КомандыБ24,Расш1_СведенияБ24", ",") Цикл
        Группа = Элементы.Добавить(Имя, Тип("ГруппаФормы"), Верх);
        Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
        Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
        Группа.ОтображатьЗаголовок = Ложь;
    КонецЦикла;
    Расш1_КнопкаБ24("Расш1_СоздатьЗадачу", "Создать задачу в Битрикс24", Элементы.Расш1_КомандыБ24);
    Расш1_ПолеБ24("Расш1_ЗадачаСоздана", "Задача создана", Элементы.Расш1_СведенияБ24, 12);
    Расш1_ПолеБ24("Расш1_НомерЗадачиБ24", "ID задачи Б24", Элементы.Расш1_СведенияБ24, 10);
    Расш1_ПолеБ24("Расш1_НазваниеБ24", "Название задачи Б24", Элементы.Расш1_СведенияБ24, 40);
    Элементы["Расш1_НазваниеБ24"].МногострочныйРежим = Ложь;
    Элементы["Расш1_НазваниеБ24"].РастягиватьПоГоризонтали = Истина;
    Расш1_ПолеБ24("Расш1_ТекстБ24", "", Верх, 70);
    Элементы["Расш1_ТекстБ24"].МногострочныйРежим = Истина;
    Элементы["Расш1_ТекстБ24"].РастягиватьПоГоризонтали = Истина;
    Расш1_КнопкаБ24("Расш1_ПривязатьЗадачу", "Привязать существующую задачу", Элементы.ФормаКоманднаяПанель, Истина);
    Расш1_КнопкаБ24("Расш1_ИзменитьСвязь", "Изменить связь с задачей Б24", Элементы.ФормаКоманднаяПанель, Истина);
    Расш1_КнопкаБ24("Расш1_УдалитьСвязь", "Удалить связь с задачей Б24", Элементы.ФормаКоманднаяПанель, Истина);
КонецПроцедуры

&НаСервере
Процедура Расш1_КнопкаБ24(Имя, Заголовок, Родитель, ВЕщё = Ложь)
    Команда = Команды.Добавить(Имя); Команда.Заголовок = Заголовок; Команда.Действие = Имя;
    Кнопка = Элементы.Добавить(Имя, Тип("КнопкаФормы"), Родитель); Кнопка.ИмяКоманды = Имя;
    Если ВЕщё Тогда
        Кнопка.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
        Кнопка.ПоложениеВКоманднойПанели = ПоложениеКнопкиВКоманднойПанели.ВДополнительномПодменю;
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура Расш1_ПолеБ24(Имя, Заголовок, Родитель, Ширина)
    Поле = Элементы.Добавить(Имя, Тип("ПолеФормы"), Родитель);
    Поле.ПутьКДанным = Имя; Поле.Заголовок = Заголовок; Поле.ТолькоПросмотр = Истина; Поле.Ширина = Ширина;
    Если Имя = "Расш1_ЗадачаСоздана" Тогда Поле.Вид = ВидПоляФормы.ПолеФлажка;
    Иначе Поле.Вид = ВидПоляФормы.ПолеВвода; КонецЕсли;
КонецПроцедуры

&НаКлиенте
&Вместо("ПровестиИЗакрыть")
Процедура Расш1_ПровестиИЗакрыть(Команда)
    Если Расш1_ПродолжениеЗакрытия = Истина Тогда
        Расш1_ПродолжениеЗакрытия = Ложь; ПродолжитьВызов(Команда); Возврат;
    КонецЕсли;
    ПоказатьВопрос(Новый ОписаниеОповещения("Расш1_ОтветНапоминания", ЭтотОбъект),
        "Вы создали задачу в Битрикс24?", РежимДиалогаВопрос.ДаНетОтмена);
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ОтветНапоминания(Ответ, Параметры) Экспорт
    Если Ответ <> КодВозвратаДиалога.Да И Ответ <> КодВозвратаДиалога.Нет Тогда Возврат; КонецЕсли;
    Расш1_ПродолжениеЗакрытия = Истина;
    Попытка ПровестиИЗакрыть(Неопределено); Исключение
        Расш1_ПродолжениеЗакрытия = Ложь; ВызватьИсключение;
    КонецПопытки;
    Расш1_ПродолжениеЗакрытия = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура Расш1_СоздатьЗадачу(Команда) Экспорт
    Ответ = Расш1_ДоСозданияНаСервере();
    Если Не Ответ.Успех Тогда Сообщить(Ответ.Ошибка); Возврат; КонецЕсли;
    Данные = Ответ.Данные;
    Если Расш1_СообщитьПрепятствие(Данные) Тогда Возврат; КонецЕсли;
    Если Данные.Действие = "Подтверждение" Тогда
        ПоказатьВопрос(Новый ОписаниеОповещения("Расш1_ОтветНовогоСоздания", ЭтотОбъект, Данные),
            "Ранее заказ был связан с задачей №" + Данные.ПоследняяУдаленнаяЗадача + ". Создать новую?", РежимДиалогаВопрос.ДаНет);
    Иначе Расш1_ПровестиДляСоздания(Данные); КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция Расш1_СообщитьПрепятствие(Данные)
    Если Данные.Действие = "Провести" Или Данные.Действие = "Подтверждение" Тогда Возврат Ложь; КонецЕсли;
    Если Данные.Действие = "Связана" Тогда
        Текст = "Заказ уже связан с задачей №" + Данные.ЗадачаId + ".";
        Если Модифицированность Тогда Текст = Текст + " Изменения заказа этой командой не сохранены. Задача не обновлена."; КонецЕсли;
    ИначеЕсли Данные.Действие = "ПометкаУдаления" Тогда Текст = "Заказ помечен на удаление. Создание задачи запрещено.";
    ИначеЕсли Данные.Действие = "Отменен" Тогда Текст = "Заказ отменён. Создание задачи запрещено.";
    ИначеЕсли Данные.Действие = "Неизвестно" Тогда Текст = "Проверяем, создана ли задача";
    ИначеЕсли Данные.Действие = "Конфликт" Тогда Текст = "Конфликт операции; требуется программист";
    ИначеЕсли Данные.Действие = "ЗадачаИзвестна" Тогда Текст = "Задача №" + Данные.ЗадачаId + " создана. Связь с заказом ещё не сохранена";
    Иначе Текст = "Задача уже создаётся"; КонецЕсли;
    Сообщить(Текст); Расш1_ОбновитьБ24(Неопределено); Возврат Истина;
КонецФункции

&НаКлиенте
Процедура Расш1_ОтветНовогоСоздания(Ответ, Данные) Экспорт
    Если Ответ = КодВозвратаДиалога.Да Тогда Расш1_ПровестиДляСоздания(Данные); КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ПровестиДляСоздания(Подтверждение)
    Ответ = Расш1_ДоСозданияНаСервере();
    Если Не Ответ.Успех Тогда Сообщить(Ответ.Ошибка); Возврат; КонецЕсли;
    Данные = Ответ.Данные;
    Если Расш1_СообщитьПрепятствие(Данные) Тогда Возврат; КонецЕсли;
    Если Данные.ВерсияСвязи <> Подтверждение.ВерсияСвязи Или Данные.ПоследняяУдаленнаяЗадача <> Подтверждение.ПоследняяУдаленнаяЗадача Тогда
        Сообщить("Связь с задачей изменилась. Повторите команду."); Расш1_ОбновитьБ24(Неопределено); Возврат;
    КонецЕсли;
    Расш1_КликСоздания = Строка(Новый УникальныйИдентификатор);
    ПараметрыДействия = Новый Структура("Клик,ВерсияСвязи,ПоследняяУдаленнаяЗадача", Расш1_КликСоздания, Данные.ВерсияСвязи, Данные.ПоследняяУдаленнаяЗадача);
    ОбщегоНазначенияУТКлиент.Провести(ЭтаФорма, Истина, Новый ОписаниеОповещения("Расш1_ПослеУспешногоПроведения", ЭтотОбъект, ПараметрыДействия));
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ПослеУспешногоПроведения(РезультатЗаписи, Параметры) Экспорт
    Если РезультатЗаписи <> Истина Или Параметры.Клик <> Расш1_КликСоздания Тогда Возврат; КонецЕсли;
    Расш1_КликСоздания = "";
    Ответ = Расш1_НачатьПослеПроведенияНаСервере(Объект.Ссылка, Расш1_СеансБ24, Параметры);
    Если Не Ответ.Успех Тогда Сообщить(Ответ.Ошибка); КонецЕсли;
    Расш1_ОбновитьБ24(Неопределено);
КонецПроцедуры

&НаСервере
Функция Расш1_ДоСозданияНаСервере()
    Попытка
        Всего = Объект.Товары.Количество(); Отменено = 0;
        Для Каждого СтрокаТовара Из Объект.Товары Цикл Если СтрокаТовара.Отменено Тогда Отменено = Отменено + 1; КонецЕсли; КонецЦикла;
        Отмена = Расш1_ОперацииRESTБ24.ЗаказОтменен(Объект.Статус = Перечисления["СтатусыЗаказовКлиентов"].Закрыт, Всего, Отменено);
        Возврат Новый Структура("Успех,Данные,Ошибка", Истина, Расш1_СервисRESTБ24.ДоСоздания(Объект.Ссылка, Объект.ПометкаУдаления, Отмена), "");
    Исключение
        Возврат Новый Структура("Успех,Данные,Ошибка", Ложь, Неопределено, Расш1_СервисRESTБ24.БезопаснаяОшибка(ОписаниеОшибки()));
    КонецПопытки;
КонецФункции

&НаСервереБезКонтекста
Функция Расш1_НачатьПослеПроведенияНаСервере(Заказ, Сеанс, Параметры)
    Попытка
        Данные = Расш1_СервисRESTБ24.НачатьПослеПроведения(Заказ, Сеанс, Параметры.ПоследняяУдаленнаяЗадача, Параметры.ВерсияСвязи);
        Возврат Новый Структура("Успех,Данные,Ошибка", Истина, Данные, "");
    Исключение
        Причина = Расш1_СервисRESTБ24.БезопаснаяОшибка(ОписаниеОшибки());
        Попытка
            Данные = Расш1_СервисRESTБ24.СостояниеЗаказа(Заказ);
            Если Данные.Состояние = "Нет" Или Данные.Состояние = "НеОтправлена" Или Данные.Состояние = "ОтказAPI" Тогда
                Причина = "Заказ проведён. Создание задачи не запущено. Повторите команду позже. " + Причина;
            Иначе Причина = "Заказ проведён. Проверяем состояние прежней операции Битрикс24."; КонецЕсли;
        Исключение
            Причина = "Заказ проведён. Не удалось определить состояние создания задачи. Повторная отправка без проверки запрещена.";
        КонецПопытки;
        Возврат Новый Структура("Успех,Данные,Ошибка", Ложь, Неопределено, Причина);
    КонецПопытки;
КонецФункции

&НаКлиенте
Процедура Расш1_ПривязатьЗадачу(Команда)
    Если ЭтаФорма["Расш1_ЗадачаСоздана"] Тогда Сообщить("Заказ уже связан с задачей. Используйте «Изменить связь»."); Возврат; КонецЕсли;
    Расш1_ВвестиСвязь();
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ИзменитьСвязь(Команда)
    Если Не ЭтаФорма["Расш1_ЗадачаСоздана"] Тогда Сообщить("Связь с задачей отсутствует. Обновите сведения."); Расш1_ОбновитьБ24(Неопределено); Возврат; КонецЕсли;
    Расш1_ВвестиСвязь();
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ВвестиСвязь()
    Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда Сообщить("Для привязки задачи сначала запишите заказ"); Возврат; КонецЕсли;
    ПараметрыДействия = Новый Структура("ВерсияСвязи,Заказ", ЭтаФорма["Расш1_ВерсияСвязи"], Объект.Ссылка);
    ПоказатьВводСтроки(Новый ОписаниеОповещения("Расш1_ВводСвязиЗавершен", ЭтотОбъект, ПараметрыДействия), "", "Ссылка или ID существующей задачи Битрикс24", 2048, Ложь);
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ВводСвязиЗавершен(Ввод, Параметры) Экспорт
    Если Ввод = Неопределено Или ПустаяСтрока(Ввод) Тогда Возврат; КонецЕсли;
    Ответ = Расш1_ПроверитьКандидатаНаСервере(Параметры.Заказ, Ввод, Параметры.ВерсияСвязи);
    Если Не Ответ.Успех Тогда Сообщить(Ответ.Ошибка); Расш1_ОбновитьБ24(Неопределено); Возврат; КонецЕсли;
    Кандидат = Ответ.Данные;
    Текст = "Привязать к заказу №" + Кандидат.НомерЗаказа + " задачу №" + Кандидат.ЗадачаId + "?" + Символы.ПС + Кандидат.Название;
    Если Кандидат.Завершена Тогда Текст = Текст + Символы.ПС + "Задача уже завершена. Её статус не изменится."; КонецЕсли;
    Кнопки = Новый СписокЗначений;
    Кнопки.Добавить(КодВозвратаДиалога.Да, "Привязать"); Кнопки.Добавить(КодВозвратаДиалога.Нет, "Отмена");
    Кандидат.Вставить("Заказ", Параметры.Заказ);
    ПоказатьВопрос(Новый ОписаниеОповещения("Расш1_ПодтверждениеПривязки", ЭтотОбъект, Кандидат), Текст, Кнопки);
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ПодтверждениеПривязки(Ответ, Кандидат) Экспорт
    Если Ответ <> КодВозвратаДиалога.Да Тогда Возврат; КонецЕсли;
    Итог = Расш1_СвязьНаСервере(Кандидат.Заказ, Кандидат, Кандидат.ВерсияСвязи, Ложь);
    Если Не Итог.Успех Тогда Сообщить(Итог.Ошибка); КонецЕсли;
    Расш1_ОбновитьБ24(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура Расш1_УдалитьСвязь(Команда)
    Если Не ЭтаФорма["Расш1_ЗадачаСоздана"] Тогда Сообщить("Связь с задачей отсутствует."); Возврат; КонецЕсли;
    ПараметрыДействия = Новый Структура("Заказ,ВерсияСвязи", Объект.Ссылка, ЭтаФорма["Расш1_ВерсияСвязи"]);
    ПоказатьВопрос(Новый ОписаниеОповещения("Расш1_ПодтверждениеУдаления", ЭтотОбъект, ПараметрыДействия),
        "Удалить связь заказа с задачей №" + ЭтаФорма["Расш1_НомерЗадачиБ24"] + "? Сама задача Битрикс24 останется.", РежимДиалогаВопрос.ДаНет);
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ПодтверждениеУдаления(Ответ, Параметры) Экспорт
    Если Ответ <> КодВозвратаДиалога.Да Тогда Возврат; КонецЕсли;
    Итог = Расш1_СвязьНаСервере(Параметры.Заказ, Неопределено, Параметры.ВерсияСвязи, Истина);
    Если Не Итог.Успех Тогда Сообщить(Итог.Ошибка); КонецЕсли;
    Расш1_ОбновитьБ24(Неопределено);
КонецПроцедуры

&НаСервереБезКонтекста
Функция Расш1_ПроверитьКандидатаНаСервере(Заказ, Ввод, Версия)
    Попытка Возврат Новый Структура("Успех,Данные,Ошибка", Истина, Расш1_СервисRESTБ24.ПроверитьКандидата(Заказ, Ввод, Версия), "");
    Исключение Возврат Новый Структура("Успех,Данные,Ошибка", Ложь, Неопределено, Расш1_СервисRESTБ24.БезопаснаяОшибка(ОписаниеОшибки())); КонецПопытки;
КонецФункции

&НаСервереБезКонтекста
Функция Расш1_СвязьНаСервере(Заказ, Кандидат, Версия, Удаление)
    Попытка
        Если Удаление Тогда Расш1_СервисRESTБ24.ИзменитьСвязь(Заказ, "", Версия);
        Иначе Расш1_СервисRESTБ24.ПодтвердитьПривязку(Заказ, Кандидат, Кандидат.Завершена); КонецЕсли;
        Возврат Новый Структура("Успех,Данные,Ошибка", Истина, Неопределено, "");
