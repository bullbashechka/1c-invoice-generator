// Прототип колонки: стандартный запрос и штатные поля списка не меняются.
&НаСервере
&После("ПриСозданииНаСервере")
Процедура Расш1_ПриСозданииСпискаНаСервере(Отказ, СтандартнаяОбработка)
    Если Отказ Тогда
        Возврат;
    КонецЕсли;
    ПолеЗадачи = ЭтаФорма["Список"].ВычисляемыеПоля.Добавить();
    ПолеЗадачи.ПутьКДанным = "Расш1_ЗадачаId";
    ПолеЗадачи.Выражение = """""";
    ПолеЗадачи.ТипЗначения = Новый ОписаниеТипов("Строка");
    ПолеЗадачи.Заголовок = "Задача Б24";
    Колонка = Элементы.Вставить("Расш1_ЗадачаБ24", Тип("ПолеФормы"), Элементы.Список, Элементы.СписокПриоритет);
    Колонка.Вид = ВидПоляФормы.ПолеНадписи;
    Колонка.ПутьКДанным = "Список.Расш1_ЗадачаId";
    Колонка.Заголовок = "Задача Б24";
    Колонка.ТолькоПросмотр = Истина;
    Колонка.Ширина = 15;
    Элементы.Список.УстановитьДействие("ПриПолученииДанныхНаСервере", "Расш1_СписокПриПолученииДанныхНаСервере");
КонецПроцедуры

&НаСервереБезКонтекста
Процедура Расш1_СписокПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
    Ключи = Строки.ПолучитьКлючи();
    Связи = Новый Соответствие;
    Запрос = Новый Запрос("ВЫБРАТЬ Заказ, ЗадачаId
        |ИЗ РегистрСведений.Расш1_СвязиЗаказовБ24
        |ГДЕ Заказ В (&Заказы)");
    Запрос.УстановитьПараметр("Заказы", Ключи);
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Связи.Вставить(Выборка.Заказ, Выборка.ЗадачаId);
    КонецЦикла;
    Для Каждого Ключ Из Ключи Цикл
        ЗадачаId = Связи.Получить(Ключ);
        ТекстЗадачи = "";
        Если ЗадачаId <> Неопределено Тогда
            ТекстЗадачи = "Задача №" + ЗадачаId;
        КонецЕсли;
        СтрокаСписка = Строки.Получить(Ключ);
        ОформлениеЗадачи = СтрокаСписка.Оформление.Получить("Расш1_ЗадачаId");
        ОформлениеЗадачи.УстановитьЗначениеПараметра("Текст", ТекстЗадачи);
    КонецЦикла;
КонецПроцедуры
