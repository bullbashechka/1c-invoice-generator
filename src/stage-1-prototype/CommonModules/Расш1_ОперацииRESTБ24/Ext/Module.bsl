// Серверная основа этапа 2. Не вызывается непосредственно с клиента.
// Все блокировки короткие; HTTP и запуск заданий только после фиксации транзакций.

Функция ПользовательId() Экспорт
    Возврат Строка(ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор);
КонецФункции

Процедура ПроверитьДоступ(Заказ, Изменение = Ложь) Экспорт
    Если ТипЗнч(Заказ) <> Тип("ДокументСсылка.ЗаказКлиента") Или Не ЗначениеЗаполнено(Заказ) Тогда
        ВызватьИсключение "Не выбран заказ клиента.";
    КонецЕсли;
    Если Не ПравоДоступа("Чтение", Метаданные.Документы.ЗаказКлиента) Тогда
        ВызватьИсключение "Недостаточно прав на заказ.";
    КонецЕсли;
    Если Изменение И Не ПравоДоступа("Изменение", Метаданные.Документы.ЗаказКлиента) Тогда
        ВызватьИсключение "Недостаточно прав на изменение заказа.";
    КонецЕсли;
    // Без привилегированного режима: запрос применяет ограничения доступа к записи.
    Запрос = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Документ.ЗаказКлиента ГДЕ Ссылка = &Заказ");
    Запрос.УстановитьПараметр("Заказ", Заказ);
    Если Запрос.Выполнить().Пустой() Тогда ВызватьИсключение "Заказ недоступен."; КонецЕсли;
КонецПроцедуры

Процедура Блокировать()
    Блокировка = Новый БлокировкаДанных;
    // Одинаковый порядок во всех пишущих сервисах. Объём небольшой: создание по одной задаче.
    Для Каждого Имя Из СтрРазделить("Расш1_СостояниеЗаказовБ24,Расш1_ЖурналОперацийБ24,Расш1_СвязиЗаказовБ24", ",") Цикл
        Область = Блокировка.Добавить("РегистрСведений." + Имя);
        Область.Режим = РежимБлокировкиДанных.Исключительный;
    КонецЦикла;
    Блокировка.Заблокировать();
КонецПроцедуры

Функция ЗаписьСостояния(Заказ)
    Запись = РегистрыСведений.Расш1_СостояниеЗаказовБ24.СоздатьМенеджерЗаписи();
    Запись.Заказ = Заказ; Запись.Прочитать(); Запись.Заказ = Заказ;
    Возврат Запись;
КонецФункции

Функция ЗаписьОперации(ОперацияId)
    Запись = РегистрыСведений.Расш1_ЖурналОперацийБ24.СоздатьМенеджерЗаписи();
    Запись.ОперацияId = ОперацияId; Запись.Прочитать(); Запись.ОперацияId = ОперацияId;
    Возврат Запись;
КонецФункции

Функция СвязьЗаказа(Заказ)
    Запись = РегистрыСведений.Расш1_СвязиЗаказовБ24.СоздатьМенеджерЗаписи();
    Запись.Заказ = Заказ; Запись.Прочитать(); Запись.Заказ = Заказ;
    Возврат Запись;
КонецФункции

Функция Незавершена(Состояние) Экспорт
    Возврат Не ПустаяСтрока(Состояние) И Состояние <> "Завершена"
        И Состояние <> "НеОтправлена" И Состояние <> "ОтказAPI";
КонецФункции

Функция РазрешеноСоздание()
    Настройка = РегистрыСведений.Расш1_НастройкиОбменаБ24.СоздатьМенеджерЗаписи();
    Настройка.Ключ = "stage2Enabled"; Настройка.Прочитать();
    Возврат Настройка.Выбран() И Настройка.Значение = "true";
КонецФункции

Функция БазаId()
    Настройка = РегистрыСведений.Расш1_НастройкиОбменаБ24.СоздатьМенеджерЗаписи();
    Настройка.Ключ = "baseId"; Настройка.Прочитать();
    Если Не Настройка.Выбран() Тогда
        Настройка.Ключ = "baseId";
        Настройка.Значение = Строка(Новый УникальныйИдентификатор); Настройка.Записать();
    КонецЕсли;
    Возврат Строка(Новый УникальныйИдентификатор(Настройка.Значение));
КонецФункции

Функция ДанныеЗаказа(Заказ)
    Запрос = Новый Запрос("ВЫБРАТЬ Проведен, ПометкаУдаления, Номер, Дата,
        |ПРЕДСТАВЛЕНИЕ(Контрагент) КАК Контрагент, ПРЕДСТАВЛЕНИЕ(Партнер) КАК Клиент,
        |СуммаДокумента, Валюта.Наименование КАК Валюта
        |ИЗ Документ.ЗаказКлиента ГДЕ Ссылка = &Заказ");
    Запрос.УстановитьПараметр("Заказ", Заказ);
    Выборка = Запрос.Выполнить().Выбрать();
    Если Не Выборка.Следующий() Тогда ВызватьИсключение "Заказ недоступен."; КонецЕсли;
    Данные = Новый Структура("Проведен,ПометкаУдаления,Номер,Дата,Контрагент,Клиент,Сумма,Валюта,Ссылка");
    ЗаполнитьЗначенияСвойств(Данные, Выборка);
    Данные.Дата = Формат(Выборка.Дата, "ДФ=dd.MM.yyyy");
    Данные.Сумма = Формат(Выборка.СуммаДокумента, "ЧГ=0; ЧДЦ=2; ЧРД=.");
    Данные.Ссылка = ПолучитьНавигационнуюСсылку(Заказ);
    Возврат Данные;
КонецФункции

Функция НазваниеНовойЗадачи(Данные, ПределДлины = Неопределено) Экспорт
    // Каноническая сумма снимка остаётся прежней для сравнения старых операций.
    Сумма = СтрЗаменить(Формат(Число(Данные.Сумма), "ЧДЦ=2; ЧРД=,; ЧГ=3; ЧРГ= ; ЧН=0,00"), Символ(160), " ");
    Название = Данные.Контрагент + ". Счета на Оплату №" + Данные.Номер + " от " + Данные.Дата
        + " на " + Сумма + " " + Данные.Валюта;
    // Предел задаёт администратор только после проверки портала. Не угадывать его.
    Если ПределДлины <> Неопределено И СтрДлина(Название) > ПределДлины Тогда
        ВызватьИсключение "Название задачи превышает проверенный предел Битрикс24. Заказ проведён; задача не отправлена.";
    КонецЕсли;
    Возврат Название;
КонецФункции

Функция Зарезервировать(Заказ, СеансId, ПодтвержденнаяУдаленнаяЗадача = "", ОжидаемаяВерсия = -1) Экспорт
    ПроверитьДоступ(Заказ, Истина);
    Если Не ПравоДоступа("Проведение", Метаданные.Документы.ЗаказКлиента) Тогда
        ВызватьИсключение "Недостаточно прав на проведение заказа.";
    КонецЕсли;
    Данные = ДанныеЗаказа(Заказ);
    Если Не Данные.Проведен Или Данные.ПометкаУдаления Тогда ВызватьИсключение "Сначала успешно проведите заказ."; КонецЕсли;
    Параметры = Расш1_RESTБ24Сервер.ПараметрыНовойОперации();
    Инициатор = ПользовательId();
    ИсходныйРежим = ПривилегированныйРежим();
    УстановитьПривилегированныйРежим(Истина);
    НачатьТранзакцию();
    Попытка
        // Порядок как при записи документа: заказ, затем собственные регистры.
        БлокировкаЗаказа = Новый БлокировкаДанных;
        ОбластьЗаказа = БлокировкаЗаказа.Добавить("Документ.ЗаказКлиента");
        ОбластьЗаказа.УстановитьЗначение("Ссылка", Заказ);
        ОбластьЗаказа.Режим = РежимБлокировкиДанных.Исключительный;
        БлокировкаЗаказа.Заблокировать();
        Блокировать();
        УстановитьПривилегированныйРежим(ИсходныйРежим);
        Данные = ДанныеЗаказа(Заказ);
        Жизнь = ПрочитатьЖизненныйЦикл(Заказ);
        Если Жизнь.ПометкаУдаления Тогда ВызватьИсключение "Заказ помечен на удаление. Создание задачи запрещено."; КонецЕсли;
        Если Жизнь.Отменен Тогда ВызватьИсключение "Заказ отменён. Создание задачи запрещено."; КонецЕсли;
        Если Не Данные.Проведен Тогда ВызватьИсключение "Сначала успешно проведите заказ."; КонецЕсли;
        УстановитьПривилегированныйРежим(Истина);
        Если Не РазрешеноСоздание() Тогда ВызватьИсключение "Создание задач отключено программистом."; КонецЕсли;
        Связь = СвязьЗаказа(Заказ);
        Если Связь.Выбран() Тогда
            Итог = Новый Структура("Состояние,ОперацияId,ЗадачаId", "Связана", Связь.ОперацияId, Связь.ЗадачаId);
        Иначе
            Состояние = ЗаписьСостояния(Заказ);
            Операция = ЗаписьОперации(Состояние.ОперацияId);
            Если Операция.Выбран() И Незавершена(Операция.Состояние) Тогда
                Итог = Новый Структура("Состояние,ОперацияId,ЗадачаId", Операция.Состояние, Операция.ОперацияId, Операция.ЗадачаId);
            Иначе
                Если Не ПустаяСтрока(Состояние.ПоследняяУдаленнаяЗадача)
                    И (ПодтвержденнаяУдаленнаяЗадача <> Состояние.ПоследняяУдаленнаяЗадача Или ОжидаемаяВерсия <> Состояние.ВерсияСвязи) Тогда
                    ВызватьИсключение "Требуется отдельное подтверждение нового создания после удаления связи.";
                КонецЕсли;
                ОперацияId = Строка(Новый УникальныйИдентификатор);
                Операция = ЗаписьОперации(ОперацияId);
                Операция.Заказ = Заказ; Операция.БазаId = БазаId(); Операция.Портал = Параметры.Портал;
                Операция.ИнициаторId = Инициатор; Операция.СеансId = Лев(СеансId, 128);
                Операция.НачалоUTC = ТекущаяУниверсальнаяДата();
                Операция.СледующаяПроверкаUTC = Операция.НачалоUTC + 30;
                Операция.Состояние = "Резерв"; Операция.ВерсияСвязи = Состояние.ВерсияСвязи;
                Операция.Название = НазваниеНовойЗадачи(Данные, Параметры.Данные.Получить("maxTitleLength"));
                Поля = Новый Соответствие;
                Поля.Вставить("TITLE", Операция.Название);
                Поля.Вставить("DESCRIPTION", "Заказ №" + Данные.Номер + " от " + Данные.Дата + Символы.ПС
                    + "Клиент: " + Данные.Клиент + Символы.ПС + "Сумма: " + Данные.Сумма + " " + Данные.Валюта
                    + Символы.ПС + "Документ 1С: " + Данные.Ссылка);
                Поля.Вставить("GROUP_ID", Параметры.Данные.Получить("groupId"));
                Поля.Вставить("CREATED_BY", Параметры.Данные.Получить("creatorId"));
                Поля.Вставить("RESPONSIBLE_ID", Параметры.Данные.Получить("responsibleId"));
                Поля.Вставить("AUDITORS", Параметры.Данные.Получить("auditors"));
                Поля.Вставить("ACCOMPLICES", Параметры.Данные.Получить("accomplices"));
                Поля.Вставить("DEADLINE", Расш1_RESTБ24Сервер.РассчитатьСрокREST(Операция.НачалоUTC));
                // Полный UUID операции помещается в XML_ID без обрезания в Б24.
                Поля.Вставить("XML_ID", "KA2:" + ОперацияId);
                Операция.СнимокJSON = Расш1_RESTБ24Сервер.JSONСтрока(Новый Структура("fields,order", Поля, Данные));
                Операция.Записать(); Состояние.ОперацияId = ОперацияId; Состояние.Записать();
                Итог = Новый Структура("Состояние,ОперацияId,ЗадачаId", "Резерв", ОперацияId, "");
            КонецЕсли;
        КонецЕсли;
        ЗафиксироватьТранзакцию();
        УстановитьПривилегированныйРежим(ИсходныйРежим);
    Исключение
        ОтменитьТранзакцию(); УстановитьПривилегированныйРежим(ИсходныйРежим); ВызватьИсключение;
    КонецПопытки;
    Возврат Итог;
КонецФункции

Процедура Уведомление(Операция, Вид, Текст)
    Запись = РегистрыСведений.Расш1_УведомленияБ24.СоздатьМенеджерЗаписи();
    Ключ = Операция.ОперацияId + ":" + Вид;
    Запись.СообщениеId = Ключ; Запись.Прочитать();
    Если Запись.Выбран() Тогда Возврат; КонецЕсли;
    Запись.СообщениеId = Ключ; Запись.Заказ = Операция.Заказ; Запись.ИнициаторId = Операция.ИнициаторId;
    Запись.ОперацияId = Операция.ОперацияId; Запись.ВерсияСвязи = Операция.ВерсияСвязи;
    Запись.Текст = Текст; Запись.Записать();
КонецПроцедуры

Процедура Аудит(Заказ, Инициатор, Действие, Прежняя, Новая, Портал, ОперацияId)
    Запись = РегистрыСведений.Расш1_АудитСвязейБ24.СоздатьМенеджерЗаписи();
    Запись.СобытиеId = Строка(Новый УникальныйИдентификатор); Запись.Заказ = Заказ;
    Запись.ИнициаторId = Инициатор; Запись.МоментUTC = ТекущаяУниверсальнаяДата(); Запись.Действие = Действие;
    Запись.ПрежняяЗадача = Прежняя; Запись.НоваяЗадача = Новая; Запись.Портал = Портал;
    Запись.ОперацияId = ОперацияId; Запись.Записать();
КонецПроцедуры

// Вызывается только фоновым заданием с UUID. Отправка может произойти один раз.
Процедура ОтправитьОперацию(ОперацияId, ДиагностическийСбой = "") Экспорт
    Если Не ПустаяСтрока(ДиагностическийСбой) Тогда
        Если ДиагностическийСбой <> "after-response" Или Не ПравоДоступа("Администрирование", Метаданные)
            Или СтрНайти(НРег(СтрокаСоединенияИнформационнойБазы()), "ка демо") = 0 Тогда
            ВызватьИсключение "Диагностический сбой доступен только администратору КА Демо.";
        КонецЕсли;
    КонецЕсли;
    ИсходныйРежим = ПривилегированныйРежим(); УстановитьПривилегированныйРежим(Истина);
    НачатьТранзакцию();
    Попытка
        Блокировать(); Операция = ЗаписьОперации(ОперацияId);
        Отправлять = Операция.Выбран() И Операция.Состояние = "Резерв" И Не Операция.ОтправкаНачата;
        Если Отправлять Тогда
            Если Не РазрешеноСоздание() Тогда
                Операция.Состояние = "НеОтправлена";
                Уведомление(Операция, "not-sent", "Задача не создана. Повторите позже");
                Отправлять = Ложь;
            Иначе
                Операция.ОтправкаНачата = Истина; Операция.Состояние = "ОтправкаНачата";
            КонецЕсли;
            Операция.Записать();
        КонецЕсли;
        ЗафиксироватьТранзакцию(); УстановитьПривилегированныйРежим(ИсходныйРежим);
    Исключение
        ОтменитьТранзакцию(); УстановитьПривилегированныйРежим(ИсходныйРежим); ВызватьИсключение;
    КонецПопытки;
    Если Не Отправлять Тогда Возврат; КонецЕсли;
    Ответ = Расш1_RESTБ24Сервер.СоздатьПоСнимку(Операция.Портал, Операция.СнимокJSON);
    Если ДиагностическийСбой = "after-response" И Ответ.Состояние = "ЗадачаИзвестна" Тогда
        // Управляемая потеря настоящего ответа до фиксации ID. Рабочее задание этот параметр не передаёт.
        ВызватьИсключение "KA2_DIAGNOSTIC_RESPONSE_DISCARDED";
    КонецЕсли;
    СохранитьОтвет(ОперацияId, Ответ);
    Если Ответ.Состояние = "ЗадачаИзвестна" Тогда ЗаписатьСвязь(ОперацияId); КонецЕсли;
КонецПроцедуры

Процедура СохранитьОтвет(ОперацияId, Ответ) Экспорт
    ИсходныйРежим = ПривилегированныйРежим(); УстановитьПривилегированныйРежим(Истина);
    НачатьТранзакцию();
    Попытка
        Блокировать(); Операция = ЗаписьОперации(ОперацияId);
        Если Операция.Выбран() И Незавершена(Операция.Состояние) И Операция.Состояние <> "Конфликт" И ПустаяСтрока(Операция.ЗадачаId) Тогда
            Если Ответ.Состояние = "ЗадачаИзвестна" Тогда
                Операция.ЗадачаId = Ответ.ЗадачаId; Операция.Состояние = "ЗадачаИзвестна";
                Снимок = Расш1_RESTБ24Сервер.ДанныеJSON(Операция.СнимокJSON);
                Исполнитель = Расш1_RESTБ24Сервер.НормализоватьID(Снимок.Получить("fields").Получить("RESPONSIBLE_ID"));
                Операция.Ссылка = "https://" + Операция.Портал + "/company/personal/user/" + Исполнитель + "/tasks/task/view/" + Ответ.ЗадачаId + "/";
                Уведомление(Операция, "known", "Задача №" + Ответ.ЗадачаId + " создана. Связь с заказом ещё не сохранена");
            Иначе
                Операция.Состояние = Ответ.Состояние;
                Если Ответ.Состояние = "ОтказAPI" Тогда
                    Уведомление(Операция, "refusal", "Битрикс24 отказал в создании задачи. Проверьте доступ интеграции.");
                КонецЕсли;
                Если Ответ.Состояние = "НеОтправлена" Тогда Уведомление(Операция, "not-sent", "Задача не создана. Повторите позже"); КонецЕсли;
            КонецЕсли;
            Операция.СледующаяПроверкаUTC = ТекущаяУниверсальнаяДата() + 5; Операция.Записать();
        КонецЕсли;
        ЗафиксироватьТранзакцию(); УстановитьПривилегированныйРежим(ИсходныйРежим);
    Исключение
        ОтменитьТранзакцию(); УстановитьПривилегированныйРежим(ИсходныйРежим); ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры

// Отдельная транзакция ПОСЛЕ фиксации известного ID. При сбое add не повторяется.
Процедура ЗаписатьСвязь(ОперацияId, ПроверитьСрок = Истина) Экспорт
    ИсходныйРежим = ПривилегированныйРежим(); УстановитьПривилегированныйРежим(Истина);
    Попытка
        ПредварительнаяОперация = ЗаписьОперации(ОперацияId);
        УстановитьПривилегированныйРежим(ИсходныйРежим);
    Исключение
        УстановитьПривилегированныйРежим(ИсходныйРежим); ВызватьИсключение;
    КонецПопытки;
    Просрочена = Ложь;
    Если ПроверитьСрок И ПредварительнаяОперация.Состояние = "ЗадачаИзвестна" Тогда
        Попытка
            Настройки = Расш1_RESTБ24Сервер.ПараметрыНовойОперации(Ложь);
            Если Настройки.Портал = ПредварительнаяОперация.Портал Тогда
                Ответ = Расш1_RESTБ24Сервер.ПрочитатьЗадачуREST(Число(ПредварительнаяОперация.ЗадачаId));
                Если Ответ.Состояние = "Результат" Тогда
                    Задача = Ответ.Данные.Получить("task");
                    Если ТипЗнч(Задача) = Тип("Соответствие") И Расш1_RESTБ24Сервер.НормализоватьID(Задача.Получить("id")) = ПредварительнаяОперация.ЗадачаId Тогда
                        Просрочена = Расш1_RESTБ24Сервер.СрокЗадачиИстек(Задача, ТекущаяУниверсальнаяДата());
                    КонецЕсли;
                КонецЕсли;
            КонецЕсли;
        Исключение
            // Недоступность чтения не препятствует сохранению уже подтверждённого ID.
        КонецПопытки;
    КонецЕсли;
    УстановитьПривилегированныйРежим(Истина);
    // Не читать документ под блокировками собственных регистров: его ПриЗаписи берёт
    // блокировки в противоположном направлении (документ → регистры).
    ТекущиеДанные = Неопределено; ЗаказОтменен = Ложь; ОтмененОстаток = Ложь;
    Если ПредварительнаяОперация.Состояние = "ЗадачаИзвестна" Тогда
        Попытка
            ТекущиеДанные = ДанныеЗаказа(ПредварительнаяОперация.Заказ);
            Жизнь = ПрочитатьЖизненныйЦикл(ПредварительнаяОперация.Заказ);
            ЗаказОтменен = Жизнь.Отменен; ОтмененОстаток = Жизнь.ЧастичноВыполненСОтменой;
        Исключение
            // Отказ сравнения не отменяет запись уже подтверждённой связи.
        КонецПопытки;
    КонецЕсли;
    НачатьТранзакцию();
    Попытка
        Блокировать(); Операция = ЗаписьОперации(ОперацияId);
        Если Операция.Выбран() И Операция.Состояние = "ЗадачаИзвестна" И Не ПустаяСтрока(Операция.ЗадачаId) Тогда
            Состояние = ЗаписьСостояния(Операция.Заказ); Связь = СвязьЗаказа(Операция.Заказ);
            Запрос = Новый Запрос("ВЫБРАТЬ Заказ ИЗ РегистрСведений.Расш1_СвязиЗаказовБ24 ГДЕ ЗадачаId = &ID И Заказ <> &Заказ");
            Запрос.УстановитьПараметр("ID", Операция.ЗадачаId); Запрос.УстановитьПараметр("Заказ", Операция.Заказ);
            Конфликт = Состояние.ОперацияId <> ОперацияId Или Состояние.ВерсияСвязи <> Операция.ВерсияСвязи
                Или Связь.Выбран() Или Не Запрос.Выполнить().Пустой();
            Если Конфликт Тогда
                Операция.Состояние = "Конфликт";
                Уведомление(Операция, "conflict", "Задача №" + Операция.ЗадачаId + " создана. Связь не изменена из-за конфликта; требуется программист.");
            Иначе
                Связь.ЗадачаId = Операция.ЗадачаId; Связь.ОперацияId = ОперацияId;
                Связь.Портал = Операция.Портал; Связь.Ссылка = Операция.Ссылка; Связь.Название = Операция.Название; Связь.Записать();
                Состояние.ВерсияСвязи = Состояние.ВерсияСвязи + 1; Состояние.Записать();
                Операция.ВерсияСвязи = Состояние.ВерсияСвязи; Операция.Состояние = "Завершена";
                Снимок = Расш1_RESTБ24Сервер.ДанныеJSON(Операция.СнимокJSON).Получить("order");
                Текст = "По заказу №" + Снимок.Получить("Номер") + " от " + Снимок.Получить("Дата") + " создана задача №" + Операция.ЗадачаId;
                Если ТекущиеДанные <> Неопределено Тогда
                    Для Каждого Поле Из СтрРазделить("Номер,Дата,Контрагент,Клиент,Сумма,Валюта,Ссылка", ",") Цикл
                        Если ТекущиеДанные[Поле] <> Снимок.Получить(Поле) Тогда
                            Текст = Текст + Символы.ПС + "Данные заказа изменились после начала создания. Проверьте данные задачи №" + Операция.ЗадачаId;
                            Прервать;
                        КонецЕсли;
                    КонецЦикла;
                    Если ТекущиеДанные.ПометкаУдаления Тогда
                        Текст = Текст + Символы.ПС + "Заказ помечен на удаление. Проверьте связанную задачу; задача и связь сохранены.";
                    КонецЕсли;
                Иначе
                    Текст = Текст + Символы.ПС + "Не удалось сверить актуальные данные заказа. Проверьте заказ и задачу.";
                КонецЕсли;
                Если ЗаказОтменен Тогда
                    Текст = Текст + Символы.ПС + "Заказ отменён. Проверьте связанную задачу; задача и связь сохранены.";
                ИначеЕсли ОтмененОстаток Тогда
                    Текст = Текст + Символы.ПС + "Часть позиций отменена. Проверьте связанную задачу №" + Операция.ЗадачаId + " в Битрикс24";
                КонецЕсли;
                Если Просрочена Тогда Текст = Текст + Символы.ПС + "Срок задачи уже истёк. Проверьте задачу в Битрикс24."; КонецЕсли;
                Уведомление(Операция, "success", Текст);
                Известно = РегистрыСведений.Расш1_УведомленияБ24.СоздатьМенеджерЗаписи();
                Известно.СообщениеId = ОперацияId + ":known"; Известно.Прочитать();
                Если Известно.Выбран() Тогда Известно.Доставлено = Истина; Известно.Записать(); КонецЕсли;
                Аудит(Операция.Заказ, Операция.ИнициаторId, "Создание", "", Операция.ЗадачаId, Операция.Портал, ОперацияId);
            КонецЕсли;
            Операция.Записать();
        КонецЕсли;
        ЗафиксироватьТранзакцию(); УстановитьПривилегированныйРежим(ИсходныйРежим);
    Исключение
        ОтменитьТранзакцию(); УстановитьПривилегированныйРежим(ИсходныйРежим);
        // ID уже устойчиво сохранён. Следующий запуск/опрос повторяет только запись связи.
    КонецПопытки;
КонецПроцедуры

// В КА 2.4.5.18 выполнение подтверждает проведённая реализация по строке заказа.
// Закрытие с отменённым остатком не является полной отменой, включая единственную
// отменённую строку, часть количества которой уже реализована.
Функция ПрочитатьЖизненныйЦикл(Заказ) Экспорт
    Итог = Новый Структура("ПометкаУдаления,Отменен,ЧастичноВыполненСОтменой", Ложь, Ложь, Ложь);
    Если Не ЗначениеЗаполнено(Заказ) Тогда Возврат Итог; КонецЕсли;
    Запрос = Новый Запрос("ВЫБРАТЬ ПометкаУдаления, Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовКлиентов.Закрыт) КАК Закрыт ИЗ Документ.ЗаказКлиента ГДЕ Ссылка = &Заказ");
    Запрос.УстановитьПараметр("Заказ", Заказ); Строки = Запрос.Выполнить().Выбрать();
    Закрыт = Ложь;
    Если Строки.Следующий() Тогда Итог.ПометкаУдаления = Строки.ПометкаУдаления; Закрыт = Строки.Закрыт; КонецЕсли;
    Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего,
        |СУММА(ВЫБОР КОГДА Отменено ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК Отменено
        |ИЗ Документ.ЗаказКлиента.Товары ГДЕ Ссылка = &Заказ");
    Запрос.УстановитьПараметр("Заказ", Заказ); Строки = Запрос.Выполнить().Выбрать();
    Если Строки.Следующий() Тогда
        Выполнен = ЕстьВыполнениеЗаказа(Заказ);
        Итог.Отменен = ЗаказОтменен(Закрыт, Строки.Всего, Строки.Отменено, Выполнен);
        Итог.ЧастичноВыполненСОтменой = Закрыт И Строки.Отменено > 0 И Выполнен;
    КонецЕсли;
    Возврат Итог;
КонецФункции

Функция ЕстьВыполнениеЗаказа(Заказ) Экспорт
    Если Не ЗначениеЗаполнено(Заказ) Тогда Возврат Ложь; КонецЕсли;
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 ЗаказКлиента
        |ИЗ Документ.РеализацияТоваровУслуг.Товары
        |ГДЕ ЗаказКлиента = &Заказ И Ссылка.Проведен И НЕ Ссылка.ПометкаУдаления И Количество > 0");
    Запрос.УстановитьПараметр("Заказ", Заказ);
    Возврат Не Запрос.Выполнить().Пустой();
КонецФункции

Функция ЗаказОтменен(Закрыт, Всего, Отменено, ЕстьВыполнение = Ложь) Экспорт
    Возврат Всего > 0 И Отменено = Всего И Не ЕстьВыполнение;
КонецФункции

// Вызывается после штатного ПриЗаписи внутри той же транзакции: сообщение становится
// видимым только после успешной фиксации заказа. HTTP и повторного проведения нет.
Процедура ЗафиксироватьЖизненныйЦикл(Заказ, Прежнее, Текущее) Экспорт
    Удаление = Не Прежнее.ПометкаУдаления И Текущее.ПометкаУдаления;
    Отмена = Не Прежнее.Отменен И Текущее.Отменен;
    Остаток = Не Прежнее.ЧастичноВыполненСОтменой И Текущее.ЧастичноВыполненСОтменой;
    Если Не Удаление И Не Отмена И Не Остаток Тогда Возврат; КонецЕсли;
    Инициатор = ПользовательId();
    ИсходныйРежим = ПривилегированныйРежим(); УстановитьПривилегированныйРежим(Истина);
    Попытка
        Блокировать(); Связь = СвязьЗаказа(Заказ);
        Если Связь.Выбран() Тогда
            Состояние = ЗаписьСостояния(Заказ);
            Сообщение = РегистрыСведений.Расш1_УведомленияБ24.СоздатьМенеджерЗаписи();
            Сообщение.СообщениеId = Строка(Новый УникальныйИдентификатор) + ":lifecycle";
            Сообщение.Заказ = Заказ; Сообщение.ИнициаторId = Инициатор;
            Сообщение.ОперацияId = Связь.ОперацияId; Сообщение.ВерсияСвязи = Состояние.ВерсияСвязи;
            Если Удаление Тогда
                Сообщение.Текст = "Заказ помечен на удаление. Проверьте связанную задачу №" + Связь.ЗадачаId + " в Битрикс24";
            ИначеЕсли Отмена Тогда
                Сообщение.Текст = "Заказ отменён. Проверьте связанную задачу №" + Связь.ЗадачаId + " в Битрикс24";
            Иначе
                Сообщение.Текст = "Часть позиций отменена. Проверьте связанную задачу №" + Связь.ЗадачаId + " в Битрикс24";
            КонецЕсли;
            Сообщение.Записать();
        КонецЕсли;
        УстановитьПривилегированныйРежим(ИсходныйРежим);
    Исключение
        УстановитьПривилегированныйРежим(ИсходныйРежим);
        // Ошибка интеграции не отменяет штатную запись заказа.
    КонецПопытки;
КонецПроцедуры

Процедура ВосстановитьОперацию(ОперацияId) Экспорт
    ИсходныйРежим = ПривилегированныйРежим(); УстановитьПривилегированныйРежим(Истина);
    НачатьТранзакцию();
    Попытка
        Блокировать(); Операция = ЗаписьОперации(ОперацияId);
        Если Операция.Выбран() И Операция.Состояние = "Резерв" И Не Операция.ОтправкаНачата Тогда
            // Не запущенная попытка не становится очередью отправки.
            Операция.Состояние = "НеОтправлена";
            Уведомление(Операция, "not-sent", "Задача не создана. Повторите позже"); Операция.Записать();
        КонецЕсли;
        Если Операция.Выбран() И Операция.Состояние = "ОтправкаНачата" Тогда
            Операция.Состояние = "Неизвестно"; Операция.Записать();
        КонецЕсли;
        Состояние = Операция.Состояние;
        Если Состояние = "Неизвестно" Тогда
            Операция.СледующаяПроверкаUTC = ТекущаяУниверсальнаяДата() + 5; Операция.Записать();
        КонецЕсли;
        ЗафиксироватьТранзакцию(); УстановитьПривилегированныйРежим(ИсходныйРежим);
    Исключение
        ОтменитьТранзакцию(); УстановитьПривилегированныйРежим(ИсходныйРежим); ВызватьИсключение;
    КонецПопытки;
    Если Состояние = "Неизвестно" Тогда
        Снимок = Расш1_RESTБ24Сервер.ДанныеJSON(Операция.СнимокJSON);
        Ответ = Расш1_RESTБ24Сервер.НайтиПоМаркеру(Операция.Портал, Снимок.Получить("fields").Получить("XML_ID"));
        СохранитьОтвет(ОперацияId, Ответ);
        Если Ответ.Состояние = "ЗадачаИзвестна" Тогда ЗаписатьСвязь(ОперацияId); КонецЕсли;
    ИначеЕсли Состояние = "ЗадачаИзвестна" Тогда
        ЗаписатьСвязь(ОперацияId);
    КонецЕсли;
КонецПроцедуры

Процедура ВыполнитьОперацию(ОперацияId, Отправка) Экспорт
    Если Отправка Тогда ОтправитьОперацию(ОперацияId); Иначе ВосстановитьОперацию(ОперацияId); КонецЕсли;
КонецПроцедуры

Процедура ЗапуститьЗадание(ОперацияId, Отправка = Ложь) Экспорт
    Параметры = Новый Массив; Параметры.Добавить(ОперацияId); Параметры.Добавить(Отправка);
    // Одинаковые метод и ключ для отправки/восстановления: единая защита платформы от параллельных заданий.
    ФоновыеЗадания.Выполнить("Расш1_ОперацииRESTБ24.ВыполнитьОперацию", Параметры, "KA2:" + ОперацияId, "Битрикс24: заказ");
КонецПроцедуры

Процедура ЗапуститьВосстановление() Экспорт
    Если Не ПравоДоступа("Чтение", Метаданные.Документы.ЗаказКлиента) Тогда Возврат; КонецЕсли;
    ИсходныйРежим = ПривилегированныйРежим(); УстановитьПривилегированныйРежим(Истина);
    Попытка
        Запрос = Новый Запрос("ВЫБРАТЬ ОперацияId ИЗ РегистрСведений.Расш1_ЖурналОперацийБ24
            |ГДЕ Состояние В (""Резерв"", ""ОтправкаНачата"", ""Неизвестно"", ""ЗадачаИзвестна"")
            |И СледующаяПроверкаUTC <= &Сейчас");
        Запрос.УстановитьПараметр("Сейчас", ТекущаяУниверсальнаяДата()); Строки = Запрос.Выполнить().Выгрузить();
        УстановитьПривилегированныйРежим(ИсходныйРежим);
    Исключение
        УстановитьПривилегированныйРежим(ИсходныйРежим); ВызватьИсключение;
    КонецПопытки;
    Для Каждого Строка Из Строки Цикл
        Попытка ЗапуститьЗадание(Строка.ОперацияId); Исключение КонецПопытки;
    КонецЦикла;
КонецПроцедуры

Функция ПрочитатьСостояние(Заказ) Экспорт
    ПроверитьДоступ(Заказ);
    ИсходныйРежим = ПривилегированныйРежим(); УстановитьПривилегированныйРежим(Истина);
    Попытка
        Связь = СвязьЗаказа(Заказ); Состояние = ЗаписьСостояния(Заказ); Операция = ЗаписьОперации(Состояние.ОперацияId);
        Итог = Новый Структура("Состояние,ОперацияId,ЗадачаId,Название,Ссылка,ВерсияСвязи,ПоследняяУдаленнаяЗадача", "Нет", "", "", "", "", Состояние.ВерсияСвязи, Состояние.ПоследняяУдаленнаяЗадача);
        Если Связь.Выбран() Тогда
            Итог.Состояние = "Связана"; ЗаполнитьЗначенияСвойств(Итог, Связь);
        ИначеЕсли Операция.Выбран() И Операция.Состояние <> "Завершена" Тогда
            ЗаполнитьЗначенияСвойств(Итог, Операция);
        КонецЕсли;
        УстановитьПривилегированныйРежим(ИсходныйРежим);
    Исключение
        УстановитьПривилегированныйРежим(ИсходныйРежим); ВызватьИсключение;
    КонецПопытки;
    Возврат Итог;
КонецФункции

Функция ПолучитьУведомления() Экспорт
    Инициатор = ПользовательId();
    ИсходныйРежим = ПривилегированныйРежим(); УстановитьПривилегированныйРежим(Истина);
    Попытка
        Запрос = Новый Запрос("ВЫБРАТЬ СообщениеId, Заказ, Текст, ВерсияСвязи
            |ИЗ РегистрСведений.Расш1_УведомленияБ24 ГДЕ ИнициаторId = &Инициатор И НЕ Доставлено");
        Запрос.УстановитьПараметр("Инициатор", Инициатор); Строки = Запрос.Выполнить().Выгрузить();
        УстановитьПривилегированныйРежим(ИсходныйРежим);
    Исключение
        УстановитьПривилегированныйРежим(ИсходныйРежим); ВызватьИсключение;
    КонецПопытки;
    Итог = Новый Массив;
    Для Каждого Строка Из Строки Цикл
        Попытка
            Состояние = ПрочитатьСостояние(Строка.Заказ);
            Текст = Строка.Текст;
            Если Состояние.ВерсияСвязи <> Строка.ВерсияСвязи Тогда
                Текст = Текст + Символы.ПС + "После создания связь изменили или удалили. Текущее состояние смотрите в заказе.";
            КонецЕсли;
            Итог.Добавить(Новый Структура("СообщениеId,Текст", Строка.СообщениеId, Текст));
        Исключение
            // Отсутствие доступа к исходному заказу не раскрывает его данные и не подтверждает показ.
        КонецПопытки;
    КонецЦикла;
    Возврат Итог;
КонецФункции

Процедура ПодтвердитьПоказ(СообщениеId) Экспорт
    Инициатор = ПользовательId();
    ИсходныйРежим = ПривилегированныйРежим(); УстановитьПривилегированныйРежим(Истина);
    НачатьТранзакцию();
    Попытка
        Блокировка = Новый БлокировкаДанных;
        Область = Блокировка.Добавить("РегистрСведений.Расш1_УведомленияБ24");
        Область.Режим = РежимБлокировкиДанных.Исключительный; Область.УстановитьЗначение("СообщениеId", СообщениеId);
        Блокировка.Заблокировать();
        Запись = РегистрыСведений.Расш1_УведомленияБ24.СоздатьМенеджерЗаписи();
        Запись.СообщениеId = СообщениеId; Запись.Прочитать();
        Если Запись.Выбран() И Запись.ИнициаторId = Инициатор Тогда
            Запись.Доставлено = Истина; Запись.Записать();
        КонецЕсли;
        ЗафиксироватьТранзакцию(); УстановитьПривилегированныйРежим(ИсходныйРежим);
    Исключение
        ОтменитьТранзакцию(); УстановитьПривилегированныйРежим(ИсходныйРежим); ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры

// Ручные действия остаются отдельными от проведения и создания.
// Ожидаемая версия обязательна: устаревшая форма не заменяет более новую связь.
Процедура ИзменитьСвязь(Заказ, ЗадачаId, ОжидаемаяВерсия, Кандидат = Неопределено, ПодтвержденаЗавершенная = Ложь, ПодтвержденДругойЗаказ = Ложь) Экспорт
    ПроверитьДоступ(Заказ, Истина);
    Если ТипЗнч(ОжидаемаяВерсия) <> Тип("Число") Тогда ВызватьИсключение "Обновите состояние заказа."; КонецЕсли;
    // Ранний отказ без сети и без начала вложенной транзакции. Под блокировкой проверить повторно.
    Предварительное = ПрочитатьСостояние(Заказ);
    Если Предварительное.ВерсияСвязи <> ОжидаемаяВерсия Тогда ВызватьИсключение "Связь уже изменена. Обновите заказ."; КонецЕсли;
    Если Предварительное.Состояние = "Резерв" Или Предварительное.Состояние = "ОтправкаНачата"
        Или Предварительное.Состояние = "Неизвестно" Или Предварительное.Состояние = "ЗадачаИзвестна" Или Предварительное.Состояние = "Конфликт" Тогда
        ВызватьИсключение "Дождитесь завершения проверки создания задачи.";
    КонецЕсли;
    Инициатор = ПользовательId();
    Портал = ""; Название = ""; Ссылка = ""; Маркер = "";
    Если Не ПустаяСтрока(ЗадачаId) Тогда
        Если Расш1_RESTБ24Сервер.НормализоватьID(ЗадачаId) <> ЗадачаId Тогда ВызватьИсключение "Неверный ID задачи."; КонецЕсли;
        Параметры = Расш1_RESTБ24Сервер.ПараметрыНовойОперации(Ложь); Портал = Параметры.Портал;
        Ответ = Расш1_RESTБ24Сервер.ПрочитатьЗадачуREST(Число(ЗадачаId));
        Если Ответ.Состояние <> "Результат" Тогда ВызватьИсключение "Не удалось проверить задачу. Связь не изменена."; КонецЕсли;
        Задача = Ответ.Данные.Получить("task");
        Если ТипЗнч(Задача) <> Тип("Соответствие") Тогда ВызватьИсключение "Не удалось проверить задачу."; КонецЕсли;
        Если Расш1_RESTБ24Сервер.НормализоватьID(Задача.Получить("id")) <> ЗадачаId Тогда ВызватьИсключение "Неверный ответ Битрикс24."; КонецЕсли;
        Название = Строка(Задача.Получить("title")); Маркер = Строка(Задача.Получить("xmlId"));
        Если Кандидат <> Неопределено Тогда
            ПрежнийМаркер = "";
            Если Не Кандидат.Свойство("Маркер", ПрежнийМаркер) Или ПрежнийМаркер <> Маркер Тогда
                ВызватьИсключение "Данные задачи изменились. Проверьте её повторно.";
            КонецЕсли;
            Статус = Строка(Задача.Получить("status"));
            Если ТипЗнч(Задача.Получить("title")) <> Тип("Строка") Или ПустаяСтрока(Название)
                Или СтрНайти("|1|2|3|4|5|6|7|", "|" + Статус + "|") = 0 Тогда
                ВызватьИсключение "Не удалось проверить задачу. Связь не изменена.";
            КонецЕсли;
            Завершена = Статус = "5";
            Если Кандидат.ЗадачаId <> ЗадачаId Или Кандидат.Портал <> Портал
                Или Кандидат.Название <> Название Или Кандидат.Завершена <> Завершена Тогда
                ВызватьИсключение "Данные задачи изменились. Проверьте её повторно.";
            КонецЕсли;
            Если Завершена И Не ПодтвержденаЗавершенная Тогда ВызватьИсключение "Требуется подтверждение завершённой задачи."; КонецЕсли;
        КонецЕсли;
        Исполнитель = Расш1_RESTБ24Сервер.НормализоватьID(Задача.Получить("responsibleId"));
        Если ПустаяСтрока(Исполнитель) Тогда ВызватьИсключение "Неверный ответ Битрикс24."; КонецЕсли;
        Ссылка = "https://" + Портал + "/company/personal/user/" + Исполнитель + "/tasks/task/view/" + ЗадачаId + "/";
    КонецЕсли;
    // Повторная проверка после сети, до блокировки собственных регистров:
    // чтение документа под их блокировкой инвертировало бы порядок записи заказа.
    ПроверитьДоступ(Заказ, Истина);
    ИсходныйРежим = ПривилегированныйРежим(); УстановитьПривилегированныйРежим(Истина);
    НачатьТранзакцию();
    Попытка
        Блокировать();
        Состояние = ЗаписьСостояния(Заказ); Операция = ЗаписьОперации(Состояние.ОперацияId);
        Если Состояние.ВерсияСвязи <> ОжидаемаяВерсия Тогда ВызватьИсключение "Связь уже изменена. Обновите заказ."; КонецЕсли;
        Если Операция.Выбран() И Незавершена(Операция.Состояние) Тогда
            ВызватьИсключение "Дождитесь завершения проверки создания задачи.";
        КонецЕсли;
        Если Лев(Маркер, 4) = "KA2:" Тогда
            Если СтрДлина(Маркер) <> 40 И СтрДлина(Маркер) <> 77 Тогда ВызватьИсключение "Задача имеет непроверенный маркер интеграции."; КонецЕсли;
            Чужая = ЗаписьОперации(Прав(Маркер, 36));
            Если Не Чужая.Выбран() Тогда
                ВызватьИсключение "Задача относится к непроверенной операции интеграции.";
            КонецЕсли;
            ЧужойСнимок = Расш1_RESTБ24Сервер.ДанныеJSON(Чужая.СнимокJSON);
            Если Маркер <> ЧужойСнимок.Получить("fields").Получить("XML_ID") Тогда
                ВызватьИсключение "Задача относится к непроверенной операции интеграции.";
            КонецЕсли;
            Если Чужая.ЗадачаId <> ЗадачаId Тогда ВызватьИсключение "Задача относится к непроверенной операции интеграции."; КонецЕсли;
            Если Чужая.Заказ <> Заказ И Незавершена(Чужая.Состояние) Тогда
                ВызватьИсключение "Задача относится к незавершённой операции другого заказа.";
            КонецЕсли;
            Если Чужая.Заказ <> Заказ Тогда
                Происхождение = Ложь;
                Если Кандидат = Неопределено Тогда ВызватьИсключение "Требуется подтверждение привязки задачи другого заказа."; КонецЕсли;
                Если Не Кандидат.Свойство("ИзДругогоЗаказа", Происхождение) Или Не Происхождение Или Не ПодтвержденДругойЗаказ Тогда
                    ВызватьИсключение "Требуется подтверждение привязки задачи другого заказа.";
                КонецЕсли;
                Если Чужая.Состояние <> "Завершена" Тогда ВызватьИсключение "Задача относится к непроверенной операции интеграции."; КонецЕсли;
            КонецЕсли;
        КонецЕсли;
        Связь = СвязьЗаказа(Заказ); Прежняя = Связь.ЗадачаId;
        Если Не Связь.Выбран() И ПустаяСтрока(ЗадачаId) Тогда
            ЗафиксироватьТранзакцию(); УстановитьПривилегированныйРежим(ИсходныйРежим); Возврат;
        КонецЕсли;
        Если Связь.Выбран() И Прежняя = ЗадачаId И Связь.Портал = Портал Тогда
            ЗафиксироватьТранзакцию(); УстановитьПривилегированныйРежим(ИсходныйРежим); Возврат;
        КонецЕсли;
        Если Не ПустаяСтрока(ЗадачаId) Тогда
            Запрос = Новый Запрос("ВЫБРАТЬ Заказ ИЗ РегистрСведений.Расш1_СвязиЗаказовБ24 ГДЕ ЗадачаId = &ID И Заказ <> &Заказ");
            Запрос.УстановитьПараметр("ID", ЗадачаId); Запрос.УстановитьПараметр("Заказ", Заказ);
            Если Не Запрос.Выполнить().Пустой() Тогда ВызватьИсключение "Задача уже связана с другим заказом."; КонецЕсли;
        КонецЕсли;
        Если Связь.Выбран() Тогда Связь.Удалить(); КонецЕсли;
        Действие = "РучнаяПривязка";
        Если ПустаяСтрока(ЗадачаId) Тогда
            Действие = "УдалениеСвязи";
            Если Не ПустаяСтрока(Прежняя) Тогда Состояние.ПоследняяУдаленнаяЗадача = Прежняя; КонецЕсли;
        Иначе
            Связь = СвязьЗаказа(Заказ); Связь.ЗадачаId = ЗадачаId; Связь.Портал = Портал;
            Связь.Название = Название; Связь.Ссылка = Ссылка;
            Связь.ОперацияId = Строка(Новый УникальныйИдентификатор); Связь.Записать();
        КонецЕсли;
        Состояние.ВерсияСвязи = Состояние.ВерсияСвязи + 1; Состояние.Записать();
        Аудит(Заказ, Инициатор, Действие, Прежняя, ЗадачаId, Портал, Состояние.ОперацияId);
        ЗафиксироватьТранзакцию(); УстановитьПривилегированныйРежим(ИсходныйРежим);
    Исключение
        ОтменитьТранзакцию(); УстановитьПривилегированныйРежим(ИсходныйРежим); ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры

Процедура ПроверитьРучноеДействие(Состояние, ОжидаемаяВерсия) Экспорт
    Если ТипЗнч(ОжидаемаяВерсия) <> Тип("Число") Или Состояние.ВерсияСвязи <> ОжидаемаяВерсия Тогда
        ВызватьИсключение "Связь уже изменена. Обновите заказ.";
    КонецЕсли;
    Если Состояние.Состояние <> "Нет" И Состояние.Состояние <> "Связана"
        И Незавершена(Состояние.Состояние) Тогда
        ВызватьИсключение "Дождитесь завершения проверки создания задачи.";
    КонецЕсли;
КонецПроцедуры

Функция ПрочитатьКандидатаСвязи(ID, Портал, Заказ = Неопределено) Экспорт
    Если Расш1_RESTБ24Сервер.НормализоватьID(ID) <> ID Тогда ВызватьИсключение "Неверный ID или ссылка задачи."; КонецЕсли;
    Ответ = Расш1_RESTБ24Сервер.ПрочитатьЗадачуREST(Число(ID));
    Если Ответ.Состояние <> "Результат" Тогда ВызватьИсключение "Не удалось проверить задачу. Связь не изменена."; КонецЕсли;
    Задача = Ответ.Данные.Получить("task");
    Если ТипЗнч(Задача) <> Тип("Соответствие") Тогда ВызватьИсключение "Не удалось проверить задачу. Связь не изменена."; КонецЕсли;
    Исполнитель = Расш1_RESTБ24Сервер.НормализоватьID(Задача.Получить("responsibleId"));
    Статус = Строка(Задача.Получить("status"));
    Если Расш1_RESTБ24Сервер.НормализоватьID(Задача.Получить("id")) <> ID Или ПустаяСтрока(Исполнитель)
        Или СтрНайти("|1|2|3|4|5|6|7|", "|" + Статус + "|") = 0 Тогда
        ВызватьИсключение "Не удалось проверить задачу. Связь не изменена.";
    КонецЕсли;
    Если ТипЗнч(Задача.Получить("title")) <> Тип("Строка") Или ПустаяСтрока(Задача.Получить("title")) Тогда
        ВызватьИсключение "Не удалось проверить задачу. Связь не изменена.";
    КонецЕсли;
    Маркер = Строка(Задача.Получить("xmlId")); ИзДругогоЗаказа = Ложь;
    Если Заказ <> Неопределено Тогда ИзДругогоЗаказа = ПроверитьЗанятостьКандидата(Заказ, ID, Маркер); КонецЕсли;
    Возврат Новый Структура("ЗадачаId,Портал,Название,Ссылка,Завершена,Маркер,ИзДругогоЗаказа", ID, Портал,
        Строка(Задача.Получить("title")), "https://" + Портал + "/company/personal/user/" + Исполнитель + "/tasks/task/view/" + ID + "/", Статус = "5", Маркер, ИзДругогоЗаказа);
КонецФункции

Функция ПроверитьЗанятостьКандидата(Заказ, ID, Маркер)
    // Предпросмотр не резервирует задачу. При сохранении проверки повторяются под блокировкой.
    ИсходныйРежим = ПривилегированныйРежим(); УстановитьПривилегированныйРежим(Истина);
    ИзДругогоЗаказа = Ложь;
    Попытка
        Запрос = Новый Запрос("ВЫБРАТЬ Заказ ИЗ РегистрСведений.Расш1_СвязиЗаказовБ24 ГДЕ ЗадачаId = &ID И Заказ <> &Заказ");
        Запрос.УстановитьПараметр("ID", ID); Запрос.УстановитьПараметр("Заказ", Заказ);
        Если Не Запрос.Выполнить().Пустой() Тогда ВызватьИсключение "Задача уже связана с другим заказом."; КонецЕсли;
        Если Лев(Маркер, 4) = "KA2:" Тогда
            Если СтрДлина(Маркер) <> 40 И СтрДлина(Маркер) <> 77 Тогда ВызватьИсключение "Задача имеет непроверенный маркер интеграции."; КонецЕсли;
            Чужая = ЗаписьОперации(Прав(Маркер, 36));
            Если Не Чужая.Выбран() Тогда ВызватьИсключение "Задача относится к непроверенной операции интеграции."; КонецЕсли;
            Снимок = Расш1_RESTБ24Сервер.ДанныеJSON(Чужая.СнимокJSON);
            Если Маркер <> Снимок.Получить("fields").Получить("XML_ID") Тогда
                ВызватьИсключение "Задача относится к непроверенной операции интеграции.";
            КонецЕсли;
            Если Чужая.ЗадачаId <> ID Тогда ВызватьИсключение "Задача относится к непроверенной операции интеграции."; КонецЕсли;
            Если Чужая.Заказ <> Заказ И Незавершена(Чужая.Состояние) Тогда
                ВызватьИсключение "Задача относится к незавершённой операции другого заказа.";
            КонецЕсли;
            ИзДругогоЗаказа = Чужая.Заказ <> Заказ;
            Если ИзДругогоЗаказа И Чужая.Состояние <> "Завершена" Тогда ВызватьИсключение "Задача относится к непроверенной операции интеграции."; КонецЕсли;
        КонецЕсли;
        УстановитьПривилегированныйРежим(ИсходныйРежим);
    Исключение
        УстановитьПривилегированныйРежим(ИсходныйРежим); ВызватьИсключение;
    КонецПопытки;
    Возврат ИзДругогоЗаказа;
КонецФункции
