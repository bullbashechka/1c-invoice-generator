// Клиентский контракт. Ни секрет, ни исходное тело REST-ответа наружу не возвращаются.
// Подключение к успешному штатному проведению явной кнопки — отдельная T51.
Функция НачатьПослеПроведения(Заказ, СеансId, ПодтвержденнаяУдаленнаяЗадача = "", ВерсияСвязи = -1) Экспорт
    Если ТранзакцияАктивна() Тогда ВызватьИсключение "Проведение заказа ещё не зафиксировано."; КонецЕсли;
    Итог = Расш1_ОперацииRESTБ24.Зарезервировать(Заказ, СеансId, ПодтвержденнаяУдаленнаяЗадача, ВерсияСвязи);
    Если Итог.Состояние = "Резерв" Тогда
        Попытка Расш1_ОперацииRESTБ24.ЗапуститьЗадание(Итог.ОперацияId, Истина); Исключение
            // Устойчивый резерв будет признан неотправкой. Автоматической отправки позже нет.
        КонецПопытки;
    КонецЕсли;
    Возврат Итог;
КонецФункции

