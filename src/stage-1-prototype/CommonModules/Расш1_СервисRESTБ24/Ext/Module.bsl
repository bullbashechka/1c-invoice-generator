// Решение не записывает заказ и не вызывает HTTP.
Функция ДействиеСоздания(Состояние, Жизнь) Экспорт
    Если Состояние.Состояние = "Связана" Тогда Возврат "Связана"; КонецЕсли;
    Если Расш1_ОперацииRESTБ24.Незавершена(Состояние.Состояние) И Состояние.Состояние <> "Нет" Тогда
        Возврат Состояние.Состояние;
    КонецЕсли;
    Если Жизнь.ПометкаУдаления Тогда Возврат "ПометкаУдаления"; КонецЕсли;
    Если Жизнь.Отменен Тогда Возврат "Отменен"; КонецЕсли;
    Если Не ПустаяСтрока(Состояние.ПоследняяУдаленнаяЗадача) Тогда Возврат "Подтверждение"; КонецЕсли;
    Возврат "Провести";
КонецФункции

Функция ПредставлениеСостояния(Данные) Экспорт
    Вид = Новый Структура("Создана,ЗадачаId,Название,Текст", Ложь, "", "", "");
    Если Данные.Состояние = "Связана" Тогда
        Вид.Создана = Истина; Вид.ЗадачаId = Данные.ЗадачаId; Вид.Название = Данные.Название;
    ИначеЕсли Данные.Состояние = "ЗадачаИзвестна" Или (Данные.Состояние = "Конфликт" И Не ПустаяСтрока(Данные.ЗадачаId)) Тогда
        Вид.Текст = "Задача №" + Данные.ЗадачаId + " создана. Связь с заказом ещё не сохранена";
        Если Данные.Состояние = "Конфликт" Тогда Вид.Текст = Вид.Текст + ". Конфликт связи; требуется программист"; КонецЕсли;
    ИначеЕсли Данные.Состояние = "Резерв" Или Данные.Состояние = "ОтправкаНачата" Тогда
        Вид.Текст = "Создаём задачу";
    ИначеЕсли Данные.Состояние = "Неизвестно" Тогда
        Вид.Текст = "Проверяем, создана ли задача";
    ИначеЕсли Данные.Состояние = "НеОтправлена" Тогда
        Вид.Текст = "Задача не создана. Повторите позже";
    ИначеЕсли Данные.Состояние = "ОтказAPI" Тогда
        Вид.Текст = "Битрикс24 отказал в создании задачи. Проверьте настройки и права";
    ИначеЕсли Данные.Состояние = "Конфликт" Тогда
        Вид.Текст = "Конфликт операции; требуется программист";
    КонецЕсли;
    Возврат Вид;
КонецФункции


Функция ПустоеСостояние() Экспорт
    Возврат Новый Структура("Состояние,ОперацияId,ЗадачаId,Название,Ссылка,ВерсияСвязи,ПоследняяУдаленнаяЗадача", "Нет", "", "", "", "", 0, "");
КонецФункции

Функция ДоСоздания(Заказ, ПометкаФормы, ОтменаФормы) Экспорт
    Данные = ПустоеСостояние(); Жизнь = Новый Структура("ПометкаУдаления,Отменен", ПометкаФормы, ОтменаФормы);
    Если ЗначениеЗаполнено(Заказ) Тогда
        Данные = СостояниеЗаказа(Заказ);
        Сохранено = Расш1_ОперацииRESTБ24.ПрочитатьЖизненныйЦикл(Заказ);
        Жизнь.ПометкаУдаления = Жизнь.ПометкаУдаления Или Сохранено.ПометкаУдаления;
        Жизнь.Отменен = Жизнь.Отменен Или Сохранено.Отменен;
    КонецЕсли;
    Данные.Вставить("Действие", ДействиеСоздания(Данные, Жизнь));
    Возврат Данные;
КонецФункции

Функция IDИзВвода(Ввод, Портал) Экспорт
    Если ТипЗнч(Ввод) <> Тип("Строка") Тогда ВызватьИсключение "Неверный ID или ссылка задачи."; КонецЕсли;
    Текст = СокрЛП(Ввод);
    ID = Расш1_RESTБ24Сервер.НормализоватьID(Текст);
    Если Не ПустаяСтрока(ID) Тогда Возврат ID; КонецЕсли;
    Префикс = "https://" + НРег(Портал) + "/";
    Если НРег(Лев(Текст, СтрДлина(Префикс))) <> Префикс Тогда ВызватьИсключение "Ссылка должна относиться к настроенному порталу Битрикс24."; КонецЕсли;
    Путь = Сред(Текст, СтрДлина(Префикс) + 1);
    Для Каждого Разделитель Из СтрРазделить("?|#", "|") Цикл
        Позиция = СтрНайти(Путь, Разделитель);
        Если Позиция > 0 Тогда Путь = Лев(Путь, Позиция - 1); КонецЕсли;
    КонецЦикла;
    Маркер = "/tasks/task/view/"; Позиция = СтрНайти("/" + Путь, Маркер);
    Если Позиция = 0 Тогда ВызватьИсключение "Нужна ссылка на существующую задачу."; КонецЕсли;
    Хвост = Сред("/" + Путь, Позиция + СтрДлина(Маркер));
    Если Прав(Хвост, 1) = "/" Тогда Хвост = Лев(Хвост, СтрДлина(Хвост) - 1); КонецЕсли;
    ID = Расш1_RESTБ24Сервер.НормализоватьID(Хвост);
    Если ПустаяСтрока(ID) Тогда ВызватьИсключение "Неверный ID или ссылка задачи."; КонецЕсли;
    Возврат ID;
КонецФункции

Функция ПроверитьКандидата(Заказ, Ввод, ВерсияСвязи) Экспорт
    Расш1_ОперацииRESTБ24.ПроверитьДоступ(Заказ, Истина);
    Состояние = СостояниеЗаказа(Заказ);
    Расш1_ОперацииRESTБ24.ПроверитьРучноеДействие(Состояние, ВерсияСвязи);
    Параметры = Расш1_RESTБ24Сервер.ПараметрыНовойОперации(Ложь);
    ID = IDИзВвода(Ввод, Параметры.Портал);
    Кандидат = Расш1_ОперацииRESTБ24.ПрочитатьКандидатаСвязи(ID, Параметры.Портал, Заказ);
    Кандидат.Вставить("ВерсияСвязи", ВерсияСвязи);
    Кандидат.Вставить("НомерЗаказа", Заказ.Номер);
    Возврат Кандидат;
КонецФункции

Процедура ПодтвердитьПривязку(Заказ, Кандидат, ПодтвержденаЗавершенная = Ложь, ПодтвержденДругойЗаказ = Ложь) Экспорт
    Если ТипЗнч(Кандидат) <> Тип("Структура") Тогда ВызватьИсключение "Сначала проверьте задачу."; КонецЕсли;
    Если Кандидат.Завершена И Не ПодтвержденаЗавершенная Тогда ВызватьИсключение "Требуется подтверждение завершённой задачи."; КонецЕсли;
    Расш1_ОперацииRESTБ24.ИзменитьСвязь(Заказ, Кандидат.ЗадачаId, Кандидат.ВерсияСвязи, Кандидат, ПодтвержденаЗавершенная, ПодтвержденДругойЗаказ);
КонецПроцедуры

Функция БезопаснаяОшибка(Описание) Экспорт
    Для Каждого Причина Из СтрРазделить("Недостаточно прав на заказ.|Недостаточно прав на изменение заказа.|Заказ недоступен.|Недостаточно прав на проведение заказа.|Создание задач отключено программистом.|Заказ отменён. Создание задачи запрещено.|Заказ помечен на удаление. Создание задачи запрещено.|Связь уже изменена. Обновите заказ.|Дождитесь завершения проверки создания задачи.|Задача уже связана с другим заказом.|Задача относится к незавершённой операции другого заказа.|Задача относится к непроверенной операции интеграции.|Задача имеет непроверенный маркер интеграции.|Не удалось проверить задачу. Связь не изменена.|Данные задачи изменились. Проверьте её повторно.|Ссылка должна относиться к настроенному порталу Битрикс24.|Неверный ID или ссылка задачи.|Нужна ссылка на существующую задачу.|Требуется подтверждение завершённой задачи.|Требуется подтверждение привязки задачи другого заказа.|Название задачи превышает проверенный предел Битрикс24. Заказ проведён; задача не отправлена.", "|") Цикл
        Если СтрНайти(Описание, Причина) > 0 Тогда Возврат Причина; КонецЕсли;
    КонецЦикла;
    Возврат "Операция Битрикс24 не выполнена. Проверьте состояние заказа.";
КонецФункции

Функция ТекстКонфликтаСвязи(Состояние) Экспорт
    ID = Расш1_RESTБ24Сервер.НормализоватьID(Состояние.ЗадачаId);
    Если ПустаяСтрока(ID) Тогда
        Текст = "Связь уже изменена. Сейчас связь с задачей отсутствует.";
    Иначе
        Текст = "Связь уже изменена. Сейчас заказ связан с задачей №" + ID + ".";
    КонецЕсли;
    Возврат Текст + " Для изменения заново запустите команду.";
КонецФункции
