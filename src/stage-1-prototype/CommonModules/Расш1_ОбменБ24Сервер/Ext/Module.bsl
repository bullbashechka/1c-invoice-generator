// Демопрототип. Настройки и секреты задаются в данных базы, не в исходниках CFE.
Функция СостояниеПрототипа() Экспорт
    Возврат Новый Структура("РегистрОпераций,РегистрНастроек,Включен",
        "Расш1_ОперацииБ24", "Расш1_НастройкиОбменаБ24", Настройка("enabled").Значение = "true");
КонецФункции

Функция Настройка(Ключ)
    Запрос = Новый Запрос("ВЫБРАТЬ Значение, Секрет ИЗ РегистрСведений.Расш1_НастройкиОбменаБ24 ГДЕ Ключ = &Ключ");
    Запрос.УстановитьПараметр("Ключ", Ключ);
    Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда
        Возврат Новый Структура("Значение,Секрет", Выборка.Значение, Выборка.Секрет);
    КонецЕсли;
    Возврат Новый Структура("Значение,Секрет", "", "");
КонецФункции

Процедура ЗаписатьНастройку(Ключ, Значение, Секрет = "")
    Запись = РегистрыСведений.Расш1_НастройкиОбменаБ24.СоздатьМенеджерЗаписи();
    Запись.Ключ = Ключ;
    Запись.Значение = Значение;
    Запись.Секрет = Секрет;
    Запись.Записать();
КонецПроцедуры

Функция БазаId()
    НачатьТранзакцию();
    Попытка
        Заблокировать("РегистрСведений.Расш1_НастройкиОбменаБ24");
        Значение = Настройка("baseId").Значение;
        Если ПустаяСтрока(Значение) Тогда
            Значение = Строка(Новый УникальныйИдентификатор);
            ЗаписатьНастройку("baseId", Значение);
        КонецЕсли;
        ЗафиксироватьТранзакцию();
        Возврат Значение;
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
КонецФункции

Функция JSONСтрока(Значение)
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Значение);
    Возврат Запись.Закрыть();
КонецФункции

Функция JSONЗначение(СтрокаJSON)
    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(СтрокаJSON);
    Значение = ПрочитатьJSON(Чтение);
    Чтение.Закрыть();
    Возврат Значение;
КонецФункции

Функция ПараметрыОбмена(Компьютер)
    Если Настройка("enabled").Значение <> "true" Тогда
        Возврат Неопределено;
    КонецЕсли;
    ПользовательId = Строка(ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор);
    Привязка = Настройка("profile|" + ПользовательId + "|" + Компьютер);
    Сервис = Настройка("service");
    Если ПустаяСтрока(Привязка.Значение) Или ПустаяСтрока(Сервис.Значение) Или СтрДлина(Сервис.Секрет) < 32 Тогда
        Возврат Неопределено;
    КонецЕсли;
    Настройки = JSONЗначение(Сервис.Значение);
    Настройки.Вставить("clientToken", Сервис.Секрет);
    Профиль = JSONЗначение(Привязка.Значение);
    Настройки.Вставить("initiatorId", Профиль.initiatorId);
    Настройки.Вставить("workplaceId", Профиль.workplaceId);
    Настройки.Вставить("baseId", БазаId());
    // Прототип слушает локальный HTTP; сетевой listener службы требует TLS.
    Если Настройки.host <> "127.0.0.1" Или Настройки.port < 1 Или Настройки.port > 65535 Тогда
        ВызватьИсключение "STAGE1_INVALID_LOCAL_ENDPOINT";
    КонецЕсли;
    Если Лев(Настройки.portal, 8) <> "https://" Или СтрНайти(Настройки.portal, "?") > 0
        Или СтрНайти(Настройки.portal, "#") > 0 Тогда
        ВызватьИсключение "STAGE1_INVALID_PORTAL";
    КонецЕсли;
    Возврат Настройки;
КонецФункции

Процедура Заблокировать(ИмяРегистра)
    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить(ИмяРегистра);
    Элемент.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
КонецПроцедуры

Функция СнимокЗаказа(Заказ)
    Если Не ПравоДоступа("Изменение", Метаданные.Документы.ЗаказКлиента) Тогда
        Возврат Неопределено;
    КонецЕсли;
    Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ Проведен, ПометкаУдаления,
        |ПРЕДСТАВЛЕНИЕ(Контрагент) КАК Контрагент, Номер, Дата, СуммаДокумента,
        |ПРЕДСТАВЛЕНИЕ(Валюта) КАК Валюта ИЗ Документ.ЗаказКлиента ГДЕ Ссылка = &Заказ");
    Запрос.УстановитьПараметр("Заказ", Заказ);
    Выборка = Запрос.Выполнить().Выбрать();
    Если Не Выборка.Следующий() Или Не Выборка.Проведен Или Выборка.ПометкаУдаления Тогда
        Возврат Неопределено;
    КонецЕсли;
    Связь = РегистрыСведений.Расш1_СвязиЗаказовБ24.СоздатьМенеджерЗаписи();
    Связь.Заказ = Заказ;
    Связь.Прочитать();
    Если Связь.Выбран() Тогда Возврат Неопределено; КонецЕсли;
    Описание = "Заказ клиента №" + Выборка.Номер + " от " + Формат(Выборка.Дата, "ДФ=dd.MM.yyyy")
        + Символы.ПС + "Сумма: " + Строка(Выборка.СуммаДокумента) + " " + Выборка.Валюта
        + Символы.ПС + ПолучитьНавигационнуюСсылку(Заказ);
    Возврат Новый Структура("TITLE,DESCRIPTION,GROUP_ID", Выборка.Контрагент + ".", Описание, 36);
КонецФункции

Функция ПоставитьВОчередь(Заказ, Компьютер, СеансId) Экспорт
    Настройки = ПараметрыОбмена(Компьютер);
    Если Настройки = Неопределено Тогда Возврат "disabled"; КонецЕсли;
    НачатьТранзакцию();
    Попытка
        Заблокировать("РегистрСведений.Расш1_СвязиЗаказовБ24");
        Заблокировать("РегистрСведений.Расш1_ОперацииБ24");
        Снимок = СнимокЗаказа(Заказ);
        Если Снимок = Неопределено Тогда
            ЗафиксироватьТранзакцию();
            Возврат "ineligible";
        КонецЕсли;
        Запись = РегистрыСведений.Расш1_ОперацииБ24.СоздатьМенеджерЗаписи();
        Запись.Заказ = Заказ;
        Запись.Прочитать();
        Если Не Запись.Выбран() Тогда
            Запись.ОперацияId = Строка(Новый УникальныйИдентификатор);
            Запись.Состояние = "queued";
            Запись.ИнициаторId = Настройки.initiatorId;
            Запись.РабочееМестоId = Настройки.workplaceId;
            Запись.СеансId = СеансId;
            Запись.СнимокJSON = JSONСтрока(Снимок);
            Запись.Опубликована = "false";
            Запись.Записать();
        КонецЕсли;
        ОперацияId = Запись.ОперацияId;
        ЗафиксироватьТранзакцию();
        Возврат ОперацияId;
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
КонецФункции

Функция HTTPОбмен(Настройки, Метод, Путь, Данные = Неопределено)
    Соединение = Новый HTTPСоединение(Настройки.host, Настройки.port,,,, 2);
    Запрос = Новый HTTPЗапрос(Путь);
    Запрос.Заголовки.Вставить("Authorization", "Bearer " + Настройки.clientToken);
    Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Если Метод = "POST" Тогда
        Запрос.УстановитьТелоИзСтроки(JSONСтрока(Данные), КодировкаТекста.UTF8);
        Ответ = Соединение.ОтправитьДляОбработки(Запрос);
    Иначе
        Ответ = Соединение.Получить(Запрос);
    КонецЕсли;
    Если Ответ.КодСостояния <> 200 Тогда ВызватьИсключение "STAGE1_HTTP_REJECTED"; КонецЕсли;
    Возврат JSONЗначение(Ответ.ПолучитьТелоКакСтроку());
КонецФункции

Функция Опрос(Компьютер, СеансId, ОтправитьHeartbeat) Экспорт
    Настройки = ПараметрыОбмена(Компьютер);
    Если Настройки = Неопределено Тогда Возврат Ложь; КонецЕсли;
    Контекст = Новый Структура("baseId,initiatorId,workplaceId,sessionId",
        Настройки.baseId, Настройки.initiatorId, Настройки.workplaceId, СеансId);
    Если ОтправитьHeartbeat Тогда HTTPОбмен(Настройки, "POST", "/v1/1c/heartbeat", Контекст); КонецЕсли;
    Запрос = Новый Запрос("ВЫБРАТЬ Заказ, ОперацияId, СнимокJSON ИЗ РегистрСведений.Расш1_ОперацииБ24
        |ГДЕ ИнициаторId = &Инициатор И РабочееМестоId = &Место И Опубликована <> &Опубликована");
    Запрос.УстановитьПараметр("Инициатор", Настройки.initiatorId);
    Запрос.УстановитьПараметр("Место", Настройки.workplaceId);
    Запрос.УстановитьПараметр("Опубликована", "true");
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Данные = Новый Структура("baseId,orderId,operationId,initiatorId,workplaceId,sessionId,payload",
            Настройки.baseId, Строка(Выборка.Заказ.УникальныйИдентификатор()), Выборка.ОперацияId,
            Настройки.initiatorId, Настройки.workplaceId, СеансId, JSONЗначение(Выборка.СнимокJSON));
        HTTPОбмен(Настройки, "POST", "/v1/task-requests", Данные);
        Запись = РегистрыСведений.Расш1_ОперацииБ24.СоздатьМенеджерЗаписи();
        Запись.Заказ = Выборка.Заказ; Запись.Прочитать();
        Запись.Опубликована = "true"; Запись.СеансId = СеансId; Запись.Записать();
    КонецЦикла;
    Проверки = HTTPОбмен(Настройки, "POST", "/v1/1c/checks", Контекст);
    Для Каждого Проверка Из Проверки.checks Цикл
        Заказ = Документы.ЗаказКлиента.ПолучитьСсылку(Новый УникальныйИдентификатор(Проверка.orderId));
        НачатьТранзакцию();
        Попытка
            Заблокировать("РегистрСведений.Расш1_СвязиЗаказовБ24");
            Заблокировать("РегистрСведений.Расш1_ОперацииБ24");
            Запись = РегистрыСведений.Расш1_ОперацииБ24.СоздатьМенеджерЗаписи();
            Запись.Заказ = Заказ; Запись.Прочитать();
            Снимок = Неопределено;
            Если Запись.Выбран() И Запись.ОперацияId = Проверка.operationId
                И Запись.ИнициаторId = Настройки.initiatorId И Запись.РабочееМестоId = Настройки.workplaceId Тогда
                Снимок = СнимокЗаказа(Заказ);
            КонецЕсли;
            ЗафиксироватьТранзакцию();
        Исключение
            ОтменитьТранзакцию(); ВызватьИсключение;
        КонецПопытки;
        Данные = Новый Структура("baseId,orderId,operationId,initiatorId,workplaceId,sessionId,checkId,eligible,payload",
            Настройки.baseId, Проверка.orderId, Проверка.operationId, Настройки.initiatorId,
            Настройки.workplaceId, СеансId, Проверка.checkId, Снимок <> Неопределено,
            ?(Снимок = Неопределено, Новый Структура, Снимок));
        HTTPОбмен(Настройки, "POST", "/v1/1c/validate", Данные);
    КонецЦикла;
    Результаты = HTTPОбмен(Настройки, "GET", "/v1/results");
    ИзмененаСвязь = Ложь;
    Для Каждого Результат Из Результаты.results Цикл
        Если ПринятьРезультат(Настройки, Результат) Тогда
            ИзмененаСвязь = Истина;
            Подтверждение = Новый Структура("baseId,orderId,operationId,taskId",
                Настройки.baseId, Результат.orderId, Результат.operationId, Результат.taskId);
            HTTPОбмен(Настройки, "POST", "/v1/acknowledgments", Подтверждение);
        КонецЕсли;
    КонецЦикла;
    Возврат ИзмененаСвязь;
КонецФункции

Функция ПринятьРезультат(Настройки, Результат)
    Заказ = Документы.ЗаказКлиента.ПолучитьСсылку(Новый УникальныйИдентификатор(Результат.orderId));
    НачатьТранзакцию();
    Попытка
        Заблокировать("РегистрСведений.Расш1_СвязиЗаказовБ24");
        Заблокировать("РегистрСведений.Расш1_ОперацииБ24");
        Операция = РегистрыСведений.Расш1_ОперацииБ24.СоздатьМенеджерЗаписи();
        Операция.Заказ = Заказ; Операция.Прочитать();
        Если Не Операция.Выбран() Или Операция.ОперацияId <> Результат.operationId
            Или Операция.ИнициаторId <> Настройки.initiatorId Или Операция.РабочееМестоId <> Настройки.workplaceId Тогда
            ЗафиксироватьТранзакцию(); Возврат Ложь;
        КонецЕсли;
        Если ТипЗнч(Результат.taskId) <> Тип("Число") Или Результат.taskId <= 0
            Или Результат.taskId <> Цел(Результат.taskId) Тогда ВызватьИсключение "STAGE1_INVALID_TASK_ID"; КонецЕсли;
        Связь = РегистрыСведений.Расш1_СвязиЗаказовБ24.СоздатьМенеджерЗаписи();
        Связь.Заказ = Заказ; Связь.Прочитать();
        ЗадачаId = Формат(Результат.taskId, "ЧГ=0;ЧДЦ=0");
        Если Связь.Выбран() И (Связь.ЗадачаId <> ЗадачаId Или Связь.ОперацияId <> Результат.operationId) Тогда
            ЗафиксироватьТранзакцию(); Возврат Ложь;
        КонецЕсли;
        Связь.ЗадачаId = ЗадачаId; Связь.ОперацияId = Результат.operationId; Связь.Записать();
        Операция.Состояние = "created"; Операция.Ошибка = ""; Операция.Записать();
        ЗафиксироватьТранзакцию();
        Возврат Истина;
    Исключение
        ОтменитьТранзакцию();
        // Поздний конфликт не заменяет связь и не подтверждается службе.
        Возврат Ложь;
    КонецПопытки;
КонецФункции

Функция СтатусЗаказа(Заказ) Экспорт
    Если Не ЗначениеЗаполнено(Заказ) Тогда Возврат "Заказ ещё не записан."; КонецЕсли;
    Связь = РегистрыСведений.Расш1_СвязиЗаказовБ24.СоздатьМенеджерЗаписи();
    Связь.Заказ = Заказ; Связь.Прочитать();
    Если Связь.Выбран() Тогда
        Адрес = Настройка("service").Значение;
        Ссылка = "";
        Если Не ПустаяСтрока(Адрес) Тогда
            Параметры = JSONЗначение(Адрес);
            Ссылка = Символы.ПС + Параметры.portal + "/company/personal/user/0/tasks/task/view/" + Связь.ЗадачаId + "/";
        КонецЕсли;
        Возврат "Задача №" + Связь.ЗадачаId + Ссылка;
    КонецЕсли;
    Операция = РегистрыСведений.Расш1_ОперацииБ24.СоздатьМенеджерЗаписи();
    Операция.Заказ = Заказ; Операция.Прочитать();
    Если Операция.Выбран() Тогда Возврат "Состояние: " + Операция.Состояние + Символы.ПС + Операция.Ошибка; КонецЕсли;
    Возврат "Связи и незавершённой операции нет.";
КонецФункции
