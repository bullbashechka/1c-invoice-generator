// Внутренний серверный модуль. Чтение ответа не отправляет запросы и не пишет связь.
// Ошибка API отделена от ошибки транспорта; решение о повторе здесь не принимается.
Процедура ПрочитатьОтвет(ТекстОтвета, Разбор) Экспорт
    // REST_JSON_BODY_BEGIN
    Разбор = Новый Структура("Состояние,Данные,КодОшибки", "Неизвестно", Неопределено, "");
    Чтение = Новый ЧтениеJSON;
    Попытка
        Чтение.УстановитьСтроку(ТекстОтвета);
        ДанныеОтвета = ПрочитатьJSON(Чтение, Истина);
        Чтение.Закрыть();
    Исключение
        Чтение.Закрыть();
        // Исходный ответ и текст исключения могут содержать данные портала.
        ДанныеОтвета = Неопределено;
    КонецПопытки;

    Если ТипЗнч(ДанныеОтвета) = Тип("Соответствие") Тогда
        КодОшибкиОтвета = ДанныеОтвета.Получить("error");
        Если ТипЗнч(КодОшибкиОтвета) = Тип("Строка")
            И Не ПустаяСтрока(КодОшибкиОтвета) Тогда
            Разбор.Состояние = "ОшибкаAPI";
            // Код остаётся внутри серверного разбора; не является текстом уведомления.
            Разбор.КодОшибки = КодОшибкиОтвета;
        Иначе
            ДанныеРезультата = ДанныеОтвета.Получить("result");
            Если ТипЗнч(ДанныеРезультата) = Тип("Соответствие") Тогда
                Разбор.Состояние = "Результат";
                Разбор.Данные = ДанныеРезультата;
            ИначеЕсли ТипЗнч(ДанныеРезультата) = Тип("Массив") Тогда
                Если ДанныеРезультата.Количество() > 0 Тогда
                    Разбор.Состояние = "Результат";
                    Разбор.Данные = ДанныеРезультата;
                КонецЕсли;
                // result:[] может означать отсутствие доступа к существующей задаче.
            КонецЕсли;
        КонецЕсли;
    КонецЕсли;
    // REST_JSON_BODY_END
КонецПроцедуры

Процедура ПроверитьНастройкиREST(Настройки, Вебхук, Проверка) Экспорт
    // REST_SETTINGS_BODY_BEGIN
    Проверка = Новый Структура("Ошибка,Хост,Путь", "", "", "");
    Проверка.Ошибка = "Проверьте настройки Битрикс24: портал, вебхук и ID участников.";
    Корректно = ТипЗнч(Настройки) = Тип("Соответствие") И ТипЗнч(Вебхук) = Тип("Строка");
    Если Корректно Тогда
        Портал = Настройки.Получить("portal");
        Корректно = ТипЗнч(Портал) = Тип("Строка");
        Если Корректно Тогда
            Корректно = Лев(Портал, 8) = "https://";
            Хост = Сред(Портал, 9);
            Корректно = Корректно И СтрНайти(Хост, ".") > 0
                И Лев(Хост, 1) <> "." И Прав(Хост, 1) <> "." И СтрНайти(Хост, "..") = 0;
            Для Позиция = 1 По СтрДлина(Хост) Цикл
                Если СтрНайти("abcdefghijklmnopqrstuvwxyz0123456789.-", Сред(Хост, Позиция, 1)) = 0 Тогда
                    Корректно = Ложь;
                КонецЕсли;
            КонецЦикла;
            Корректно = Корректно И Лев(Вебхук, СтрДлина(Портал + "/rest/")) = Портал + "/rest/";
            Если Корректно Тогда
                Путь = Сред(Вебхук, СтрДлина(Портал) + 1);
                Части = СтрРазделить(Путь, "/", Истина);
                Корректно = Части.Количество() = 5;
                Если Корректно Тогда
                    Корректно = Части[0] = "" И Части[1] = "rest" И Части[4] = ""
                        И Не ПустаяСтрока(Части[2]) И Не ПустаяСтрока(Части[3]);
                    Для Позиция = 1 По СтрДлина(Части[2]) Цикл
                        Если СтрНайти("0123456789", Сред(Части[2], Позиция, 1)) = 0 Тогда Корректно = Ложь; КонецЕсли;
                    КонецЦикла;
                    Для Позиция = 1 По СтрДлина(Части[3]) Цикл
                        Если СтрНайти("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789", Сред(Части[3], Позиция, 1)) = 0 Тогда
                            Корректно = Ложь;
                        КонецЕсли;
                    КонецЦикла;
                КонецЕсли;
            КонецЕсли;
        КонецЕсли;
        Для Каждого ИмяID Из СтрРазделить("groupId,creatorId,responsibleId", ",") Цикл
            ID = Настройки.Получить(ИмяID);
            Если ТипЗнч(ID) <> Тип("Число") Тогда
                Корректно = Ложь;
            ИначеЕсли ID <= 0 Или ID <> Цел(ID) Тогда
                Корректно = Ложь;
            КонецЕсли;
        КонецЦикла;
        Участники = Настройки.Получить("auditors");
        Если ТипЗнч(Участники) <> Тип("Массив") Тогда
            Корректно = Ложь;
        ИначеЕсли Участники.Количество() <> 2 Тогда
            Корректно = Ложь;
        Иначе
            Для Каждого ID Из Участники Цикл
                Если ТипЗнч(ID) <> Тип("Число") Тогда
                    Корректно = Ложь;
                ИначеЕсли ID <= 0 Или ID <> Цел(ID) Тогда
                    Корректно = Ложь;
                КонецЕсли;
            КонецЦикла;
            Корректно = Корректно И Участники[0] <> Участники[1];
        КонецЕсли;
    КонецЕсли;
    Если Корректно Тогда
        Проверка.Ошибка = ""; Проверка.Хост = Хост; Проверка.Путь = Путь;
    КонецЕсли;
    // REST_SETTINGS_BODY_END
КонецПроцедуры

// Временная приёмочная диагностика. Не создаёт задачи, не меняет права и заказы.
Функция ПроверитьДоступСотрудникаДемо(Этап = Неопределено) Экспорт
    Этап = "контекст сотрудника";
    Если ПривилегированныйРежим() Или ПравоДоступа("Администрирование", Метаданные) Тогда
        ВызватьИсключение "REST_EMPLOYEE: требуется обычный сотрудник без привилегированного режима.";
    КонецЕсли;
    Если Метаданные.Имя <> "КомплекснаяАвтоматизацияДляКазахстана"
        Или СтрНайти(НРег(СтрокаСоединенияИнформационнойБазы()), "ка демо") = 0 Тогда
        ВызватьИсключение "REST_EMPLOYEE: требуется КА Демо.";
    КонецЕсли;
    Если Не ПравоДоступа("Изменение", Метаданные.Документы.ЗаказКлиента) Тогда
        ВызватьИсключение "REST_EMPLOYEE: нет права изменения заказа.";
    КонецЕсли;
    Этап = "права на настройки";
    // Записи независимого регистра изменяются через право Изменение; Insert/Delete неприменимы.
    Для Каждого ИмяПрава Из СтрРазделить("Чтение,Просмотр,Изменение,Редактирование", ",") Цикл
        Если ПравоДоступа(ИмяПрава, Метаданные.РегистрыСведений.Расш1_НастройкиОбменаБ24) Тогда
            ВызватьИсключение "REST_EMPLOYEE: настройки доступны сотруднику; проверка не пройдена.";
        КонецЕсли;
    КонецЦикла;
    Этап = "отказ прямого чтения секрета";
    ЧтениеЗапрещено = Ложь;
    Попытка
        ЗапросСекрета = Новый Запрос("ВЫБРАТЬ Секрет ИЗ РегистрСведений.Расш1_НастройкиОбменаБ24 ГДЕ Ключ = &Ключ");
        ЗапросСекрета.УстановитьПараметр("Ключ", "rest");
        ЗапросСекрета.Выполнить();
    Исключение
        ЧтениеЗапрещено = СтрНайти(НРег(ОписаниеОшибки()), "прав") > 0;
    КонецПопытки;
    Если Не ЧтениеЗапрещено Тогда ВызватьИсключение "REST_EMPLOYEE: чтение секрета не отклонено ошибкой прав."; КонецЕсли;
    Этап = "отказ записи настройки";
    ЗаписьЗапрещена = Ложь;
    НачатьТранзакцию();
    Попытка
        ПробнаяНастройка = РегистрыСведений.Расш1_НастройкиОбменаБ24.СоздатьМенеджерЗаписи();
        ПробнаяНастройка.Ключ = "rest-access-test-" + Строка(Новый УникальныйИдентификатор);
        ПробнаяНастройка.Значение = "synthetic";
        ПробнаяНастройка.Записать();
    Исключение
        ЗаписьЗапрещена = СтрНайти(НРег(ОписаниеОшибки()), "прав") > 0;
    КонецПопытки;
    ОтменитьТранзакцию();
    Если Не ЗаписьЗапрещена Тогда ВызватьИсключение "REST_EMPLOYEE: запись настройки не отклонена ошибкой прав."; КонецЕсли;
    Этап = "серверное чтение Б24";
    Разбор = ПрочитатьЗадачуREST(10028);
    Если ПривилегированныйРежим() Тогда ВызватьИсключение "REST_EMPLOYEE: привилегированный режим не восстановлен."; КонецЕсли;
    Если Разбор.Состояние <> "Результат" Тогда ВызватьИсключение "REST_EMPLOYEE: Б24 не подтвердил чтение задачи 10028."; КонецЕсли;
    Задача = Разбор.Данные.Получить("task");
    Если ТипЗнч(Задача) <> Тип("Соответствие") Тогда ВызватьИсключение "REST_EMPLOYEE: неверный ответ Б24."; КонецЕсли;
    Если Строка(Задача.Получить("id")) <> "10028" Тогда ВызватьИсключение "REST_EMPLOYEE: неверный ID задачи."; КонецЕсли;
    Этап = "запись подтверждения в журнал";
    Подтверждение = "REST_EMPLOYEE_CONTRACT_GREEN; session=" + Строка(НомерСеансаИнформационнойБазы());
    ЗаписьЖурналаРегистрации("REST_EMPLOYEE_CONTRACT", УровеньЖурналаРегистрации.Информация, , , Подтверждение);
    Возврат Подтверждение;
КонецФункции

Функция НастройкиREST()
    Проверка = Неопределено;
    ИсходныйРежим = ПривилегированныйРежим();
    УстановитьПривилегированныйРежим(Истина);
    Попытка
        Запрос = Новый Запрос("ВЫБРАТЬ Значение, Секрет ИЗ РегистрСведений.Расш1_НастройкиОбменаБ24 ГДЕ Ключ = &Ключ");
        Запрос.УстановитьПараметр("Ключ", "rest");
        Строки = Запрос.Выполнить().Выбрать();
        Если Не Строки.Следующий() Тогда ВызватьИсключение "Нет настройки"; КонецЕсли;
        ЗначениеНастроек = Строки.Значение; Вебхук = Строки.Секрет;
        УстановитьПривилегированныйРежим(ИсходныйРежим);
        Чтение = Новый ЧтениеJSON; Чтение.УстановитьСтроку(ЗначениеНастроек);
        Настройки = ПрочитатьJSON(Чтение, Истина); Чтение.Закрыть();
        ПроверитьНастройкиREST(Настройки, Вебхук, Проверка);
        Если Не ПустаяСтрока(Проверка.Ошибка) Тогда ВызватьИсключение "Неверная настройка"; КонецЕсли;
    Исключение
        УстановитьПривилегированныйРежим(ИсходныйРежим);
        // Не возвращать секрет и детали исключения в вызывающий модуль/журнал.
        ВызватьИсключение "Проверьте настройки Битрикс24: портал, вебхук и ID участников.";
    КонецПопытки;
    Возврат Новый Структура("Хост,Путь,Данные", Проверка.Хост, Проверка.Путь, Настройки);
КонецФункции

// Только серверные данные без секрета. Вебхук никогда не входит в снимок операции.
Функция ПараметрыНовойОперации() Экспорт
    Настройки = НастройкиREST();
    Возврат Новый Структура("Портал,Данные", Настройки.Хост, Настройки.Данные);
КонецФункции

Функция JSONСтрока(Данные) Экспорт
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Данные);
    Возврат Запись.Закрыть();
КонецФункции

Функция ДанныеJSON(Текст) Экспорт
    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(Текст);
    Данные = ПрочитатьJSON(Чтение, Истина);
    Чтение.Закрыть();
    Возврат Данные;
КонецФункции

Функция НормализоватьID(Значение) Экспорт
    Если ТипЗнч(Значение) <> Тип("Строка") И ТипЗнч(Значение) <> Тип("Число") Тогда Возврат ""; КонецЕсли;
    Если ТипЗнч(Значение) = Тип("Число") Тогда
        Если Значение <= 0 Или Значение <> Цел(Значение) Тогда Возврат ""; КонецЕсли;
        Текст = Формат(Значение, "ЧГ=0; ЧДЦ=0");
    Иначе
        Текст = Значение;
    КонецЕсли;
    Если ПустаяСтрока(Текст) Или СтрДлина(Текст) > 20 Или Лев(Текст, 1) = "0" Тогда Возврат ""; КонецЕсли;
    Для Индекс = 1 По СтрДлина(Текст) Цикл
        Если СтрНайти("0123456789", Сред(Текст, Индекс, 1)) = 0 Тогда Возврат ""; КонецЕсли;
    КонецЦикла;
    Возврат Текст;
КонецФункции

Функция РазобратьСоздание(Текст, КодHTTP) Экспорт
    Итог = Новый Структура("Состояние,ЗадачаId", "Неизвестно", "");
    Попытка
        Данные = ДанныеJSON(Текст);
        Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда Возврат Итог; КонецЕсли;
        // Только явный отказ до выполнения метода. ERROR_CORE/5xx не доказывает неотправку.
        Если КодHTTP = 401 И Данные.Получить("error") = "insufficient_scope" Тогда
            Итог.Состояние = "ОтказAPI";
            Возврат Итог;
        КонецЕсли;
        Если КодHTTP <> 200 Или Данные.Получить("error") <> Неопределено Тогда Возврат Итог; КонецЕсли;
        РезультатМетода = Данные.Получить("result");
        Если ТипЗнч(РезультатМетода) <> Тип("Соответствие") Тогда Возврат Итог; КонецЕсли;
        Задача = РезультатМетода.Получить("task");
        Если ТипЗнч(Задача) <> Тип("Соответствие") Тогда Возврат Итог; КонецЕсли;
        Итог.ЗадачаId = НормализоватьID(Задача.Получить("id"));
        Если Не ПустаяСтрока(Итог.ЗадачаId) Тогда Итог.Состояние = "ЗадачаИзвестна"; КонецЕсли;
    Исключение
        // Не сохранять тело ответа или исключение: они могут содержать секрет и данные базы.
    КонецПопытки;
    Возврат Итог;
КонецФункции

Функция ПодготовитьREST(Метод, Параметры, Портал)
    Настройки = НастройкиREST();
    Если Настройки.Хост <> Портал Тогда ВызватьИсключение "Портал операции отличается от текущей настройки."; КонецЕсли;
    Соединение = Новый HTTPСоединение(Настройки.Хост, 443, , , , 20,
        Новый ЗащищенноеСоединениеOpenSSL(Неопределено, Новый СертификатыУдостоверяющихЦентровОС));
    Запрос = Новый HTTPЗапрос(Настройки.Путь + Метод + ".json");
    Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Запрос.УстановитьТелоИзСтроки(JSONСтрока(Параметры), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
    Возврат Новый Структура("Соединение,Запрос", Соединение, Запрос);
КонецФункции

Функция ВыполнитьREST(Метод, Параметры, Портал)
    Подготовленный = ПодготовитьREST(Метод, Параметры, Портал);
    Ответ = Подготовленный.Соединение.ОтправитьДляОбработки(Подготовленный.Запрос);
    Возврат Новый Структура("HTTP,Текст", Ответ.КодСостояния, Ответ.ПолучитьТелоКакСтроку());
КонецФункции

Функция СоздатьПоСнимку(Портал, СнимокJSON) Экспорт
    Итог = Новый Структура("Состояние,ЗадачаId", "Неизвестно", "");
    Попытка
        Снимок = ДанныеJSON(СнимокJSON);
        Если ТипЗнч(Снимок) <> Тип("Соответствие") Или ТипЗнч(Снимок.Получить("fields")) <> Тип("Соответствие") Тогда ВызватьИсключение "Неверный снимок"; КонецЕсли;
        Подготовленный = ПодготовитьREST("tasks.task.add", Новый Структура("fields", Снимок.Получить("fields")), Портал);
    Исключение
        // До вызова транспорта запрос не отправлялся: это достоверная неотправка.
        Итог.Состояние = "НеОтправлена"; Возврат Итог;
    КонецПопытки;
    Попытка
        HTTPОтвет = Подготовленный.Соединение.ОтправитьДляОбработки(Подготовленный.Запрос);
        Ответ = Новый Структура("HTTP,Текст", HTTPОтвет.КодСостояния, HTTPОтвет.ПолучитьТелоКакСтроку());
        Итог = РазобратьСоздание(Ответ.Текст, Ответ.HTTP);
    Исключение
        // Флаг возможной отправки уже зафиксирован вызывающим модулем. Повтор add запрещён.
    КонецПопытки;
    Возврат Итог;
КонецФункции

Функция НайтиПоМаркеру(Портал, Маркер) Экспорт
    Итог = Новый Структура("Состояние,ЗадачаId,Название", "Неизвестно", "", "");
    Если Лев(Маркер, 4) <> "KA2:" Или (СтрДлина(Маркер) <> 40 И СтрДлина(Маркер) <> 77) Тогда Возврат Итог; КонецЕсли;
    Попытка
        Фильтр = Новый Соответствие; Фильтр.Вставить("=XML_ID", Маркер);
        Поля = Новый Массив; Поля.Добавить("ID"); Поля.Добавить("XML_ID"); Поля.Добавить("TITLE");
        Ответ = ВыполнитьREST("tasks.task.list", Новый Структура("filter,select,start", Фильтр, Поля, 0), Портал);
        Если Ответ.HTTP <> 200 Тогда Возврат Итог; КонецЕсли;
        Данные = ДанныеJSON(Ответ.Текст);
        Если ТипЗнч(Данные) <> Тип("Соответствие") Или Данные.Получить("error") <> Неопределено Тогда Возврат Итог; КонецЕсли;
        ДанныеМетода = Данные.Получить("result");
        Если ТипЗнч(ДанныеМетода) <> Тип("Соответствие") Тогда Возврат Итог; КонецЕсли;
        НайденныеЗадачи = ДанныеМетода.Получить("tasks");
        Всего = Данные.Получить("total");
        Если ТипЗнч(НайденныеЗадачи) <> Тип("Массив") Или ТипЗнч(Всего) <> Тип("Число") Тогда Возврат Итог; КонецЕсли;
        Если Всего > 1 Или НайденныеЗадачи.Количество() > 1 Тогда Итог.Состояние = "Конфликт"; Возврат Итог; КонецЕсли;
        Если Всего <> 1 Или НайденныеЗадачи.Количество() <> 1 Или Данные.Получить("next") <> Неопределено Тогда Возврат Итог; КонецЕсли;
        Задача = НайденныеЗадачи[0];
        Если ТипЗнч(Задача) <> Тип("Соответствие") Или Задача.Получить("xmlId") <> Маркер Тогда Возврат Итог; КонецЕсли;
        Итог.ЗадачаId = НормализоватьID(Задача.Получить("id"));
        Если Не ПустаяСтрока(Итог.ЗадачаId) Тогда
            // Список — только кандидат. Перечитать точный ID и маркер перед принятием результата.
            Перечитывание = ВыполнитьREST("tasks.task.get", Новый Структура("taskId", Число(Итог.ЗадачаId)), Портал);
            Если Перечитывание.HTTP <> 200 Тогда Итог.ЗадачаId = ""; Возврат Итог; КонецЕсли;
            Разбор = Неопределено; ПрочитатьОтвет(Перечитывание.Текст, Разбор);
            Если Разбор.Состояние <> "Результат" Тогда Итог.ЗадачаId = ""; Возврат Итог; КонецЕсли;
            Подтвержденная = Разбор.Данные.Получить("task");
            Если ТипЗнч(Подтвержденная) <> Тип("Соответствие") Тогда Итог.ЗадачаId = ""; Возврат Итог; КонецЕсли;
            Если Подтвержденная.Получить("xmlId") <> Маркер Или НормализоватьID(Подтвержденная.Получить("id")) <> Итог.ЗадачаId Тогда
                Итог.ЗадачаId = ""; Возврат Итог;
            КонецЕсли;
            Итог.Состояние = "ЗадачаИзвестна";
            Итог.Название = Строка(Задача.Получить("title"));
        КонецЕсли;
    Исключение
    КонецПопытки;
    Возврат Итог;
КонецФункции

// Проверять фактический срок из Б24, а не первоначальный срок снимка.
Функция СрокЗадачиИстек(Задача, МоментUTC) Экспорт
    Если ТипЗнч(Задача) <> Тип("Соответствие") Тогда Возврат Ложь; КонецЕсли;
    Статус = Строка(Задача.Получить("status"));
    Если Статус <> "1" И Статус <> "2" И Статус <> "3" И Статус <> "4" И Статус <> "6" И Статус <> "7" Тогда Возврат Ложь; КонецЕсли;
    Срок = Задача.Получить("deadline");
    Если ТипЗнч(Срок) <> Тип("Строка") Или (СтрДлина(Срок) <> 25 И СтрДлина(Срок) <> 20) Тогда Возврат Ложь; КонецЕсли;
    Попытка
        Если Сред(Срок, 5, 1) <> "-" Или Сред(Срок, 8, 1) <> "-" Или Сред(Срок, 11, 1) <> "T"
            Или Сред(Срок, 14, 1) <> ":" Или Сред(Срок, 17, 1) <> ":" Тогда Возврат Ложь; КонецЕсли;
        Момент = Дата(Число(Лев(Срок, 4)), Число(Сред(Срок, 6, 2)), Число(Сред(Срок, 9, 2)),
            Число(Сред(Срок, 12, 2)), Число(Сред(Срок, 15, 2)), Число(Сред(Срок, 18, 2)));
        Если СтрДлина(Срок) = 20 Тогда
            Если Прав(Срок, 1) <> "Z" Тогда Возврат Ложь; КонецЕсли;
        Иначе
            Знак = Сред(Срок, 20, 1);
            Если (Знак <> "+" И Знак <> "-") Или Сред(Срок, 23, 1) <> ":" Тогда Возврат Ложь; КонецЕсли;
            Часы = Число(Сред(Срок, 21, 2)); Минуты = Число(Прав(Срок, 2));
            Если Часы > 14 Или Минуты > 59 Тогда Возврат Ложь; КонецЕсли;
            Смещение = Часы * 3600 + Минуты * 60;
            Если Знак = "+" Тогда Момент = Момент - Смещение; Иначе Момент = Момент + Смещение; КонецЕсли;
        КонецЕсли;
        Возврат Момент < МоментUTC;
    Исключение
        Возврат Ложь;
    КонецПопытки;
КонецФункции

// Начало новой попытки передаётся явно в UTC; ответ и восстановление срок не пересчитывают.
Функция РассчитатьСрокREST(МоментНачалаUTC) Экспорт
    Если ТипЗнч(МоментНачалаUTC) <> Тип("Дата") Тогда
        ВызватьИсключение "Неверный момент начала попытки Битрикс24.";
    КонецЕсли;
    МестноеНачало = МоментНачалаUTC + 5 * 60 * 60;
    ДеньСрока = НачалоДня(МестноеНачало);
    Если МестноеНачало >= ДеньСрока + 19 * 60 * 60 Тогда
        ДеньСрока = ДеньСрока + 24 * 60 * 60;
    КонецЕсли;
    Возврат Формат(ДеньСрока, "ДФ=yyyy-MM-dd") + "T19:00:00+05:00";
КонецФункции

Функция ПрочитатьЗадачуREST(ЗадачаID) Экспорт
    Разбор = Неопределено;
    Если ТипЗнч(ЗадачаID) <> Тип("Число") Тогда ВызватьИсключение "Неверный номер задачи Битрикс24."; КонецЕсли;
    Если ЗадачаID <= 0 Или ЗадачаID <> Цел(ЗадачаID) Тогда ВызватьИсключение "Неверный номер задачи Битрикс24."; КонецЕсли;
    Настройки = НастройкиREST();
    Запись = Новый ЗаписьJSON; Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Новый Структура("taskId", ЗадачаID)); Тело = Запись.Закрыть();
    Попытка
        Соединение = Новый HTTPСоединение(Настройки.Хост, 443, , , , 20,
            Новый ЗащищенноеСоединениеOpenSSL(Неопределено, Новый СертификатыУдостоверяющихЦентровОС));
        Запрос = Новый HTTPЗапрос(Настройки.Путь + "tasks.task.get.json");
        Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
        Запрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
        Ответ = Соединение.ОтправитьДляОбработки(Запрос);
        ПрочитатьОтвет(Ответ.ПолучитьТелоКакСтроку(), Разбор);
        Если Ответ.КодСостояния <> 200 Тогда
            Разбор = Новый Структура("Состояние,Данные,КодОшибки", "Неизвестно", Неопределено, "");
        КонецЕсли;
    Исключение
        Разбор = Новый Структура("Состояние,Данные,КодОшибки", "Неизвестно", Неопределено, "");
    КонецПопытки;
    Возврат Разбор;
КонецФункции

// Компонентный фоновый прогон: только чтение задачи, без операций и записи связи.
// Адрес результата принадлежит сеансу, а не форме заказа. Секрет не передаётся в параметры задания.
Процедура ПроверитьФоновоеЧтение(ЗадачаID, АдресРезультата) Экспорт
    ВыполнитьФоновоеЧтение(ЗадачаID, АдресРезультата, ТекущаяУниверсальнаяДата());
КонецПроцедуры

// Диагностика прототипа, не пользовательский поток. Настройка rest не меняется.
// Локальный тестовый слушатель задерживает TLS; секрет ему не передаётся.
Процедура ПроверитьДлительноеФоновоеЧтение(ЗадачаID, АдресРезультата) Экспорт
    Если Не ПравоДоступа("Администрирование", Метаданные)
        Или СтрНайти(НРег(СтрокаСоединенияИнформационнойБазы()), "ка демо") = 0 Тогда
        ВызватьИсключение "Длительная диагностика HTTPS доступна только администратору КА Демо.";
    КонецЕсли;
    Начало = ТекущаяУниверсальнаяДата();
    Попытка
        ТестовоеСоединение = Новый HTTPСоединение("127.0.0.1", 443, , , , 12,
            Новый ЗащищенноеСоединениеOpenSSL(Неопределено, Новый СертификатыУдостоверяющихЦентровОС));
        // Ожидаемый тайм-аут TLS обрабатывается только в этой диагностике.
        ТестовоеСоединение.ОтправитьДляОбработки(Новый HTTPЗапрос("/stage1-tls-wait-test"));
    Исключение
        // TLS-проверка не отключается; подробности локального отказа не возвращаются.
    КонецПопытки;
    Если ТекущаяУниверсальнаяДата() - Начало < 10 Тогда
        ВызватьИсключение "Для диагностики нужен локальный слушатель TLS с задержкой не менее 10 секунд.";
    КонецЕсли;
    // После контролируемой задержки выполняется реальное чтение Б24 из настройки базы.
    ВыполнитьФоновоеЧтение(ЗадачаID, АдресРезультата, Начало);
КонецПроцедуры

Процедура ВыполнитьФоновоеЧтение(ЗадачаID, АдресРезультата, Начало)
    Разбор = ПрочитатьЗадачуREST(ЗадачаID);
    РезультатЧтения = Новый Структура("Состояние,ЗадачаID,Начало,Конец", Разбор.Состояние, "", Начало, ТекущаяУниверсальнаяДата());
    Если Разбор.Состояние = "Результат" Тогда
        ДанныеЗадачи = Разбор.Данные.Получить("task");
        Если ТипЗнч(ДанныеЗадачи) = Тип("Соответствие") Тогда
            РезультатЧтения.ЗадачаID = Строка(ДанныеЗадачи.Получить("id"));
        КонецЕсли;
    КонецЕсли;
    ПоместитьВоВременноеХранилище(РезультатЧтения, АдресРезультата);
КонецПроцедуры
