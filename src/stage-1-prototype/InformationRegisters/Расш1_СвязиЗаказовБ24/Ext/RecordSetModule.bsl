// Прототип: защита любой записи в собственный регистр внутри транзакции платформы.
Процедура ПередЗаписью(Отказ, Замещение)
    Блокировка = Новый БлокировкаДанных;
    Область = Блокировка.Добавить("РегистрСведений.Расш1_СвязиЗаказовБ24");
    Область.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
    ЗадачиНабора = Новый Соответствие;
    ОперацииНабора = Новый Соответствие;
    Для Каждого Связь Из ЭтотОбъект Цикл
        Если Не ЗначениеЗаполнено(Связь.Заказ) Или Не ЗначениеЗаполнено(Связь.ЗадачаId) Тогда
            ВызватьИсключение "STAGE1_INVALID_LINK";
        КонецЕсли;
        Если ЗадачиНабора.Получить(Связь.ЗадачаId) <> Неопределено Тогда
            ВызватьИсключение "STAGE1_TASK_CONFLICT";
        КонецЕсли;
        ЗадачиНабора.Вставить(Связь.ЗадачаId, Связь.Заказ);
        Если ОперацииНабора.Получить(Связь.ОперацияId) <> Неопределено Тогда
            ВызватьИсключение "STAGE1_OPERATION_CONFLICT";
        КонецЕсли;
        ОперацииНабора.Вставить(Связь.ОперацияId, Связь.Заказ);
        Запрос = Новый Запрос;
        Запрос.Текст = "ВЫБРАТЬ Заказ, ЗадачаId, ОперацияId
            |ИЗ РегистрСведений.Расш1_СвязиЗаказовБ24
            |ГДЕ Заказ = &Заказ ИЛИ ЗадачаId = &ЗадачаId ИЛИ ОперацияId = &ОперацияId";
        Запрос.УстановитьПараметр("Заказ", Связь.Заказ);
        Запрос.УстановитьПараметр("ЗадачаId", Связь.ЗадачаId);
        Запрос.УстановитьПараметр("ОперацияId", Связь.ОперацияId);
        Выборка = Запрос.Выполнить().Выбрать();
        Пока Выборка.Следующий() Цикл
            Если Выборка.Заказ <> Связь.Заказ Или Выборка.ЗадачаId <> Связь.ЗадачаId
                Или Выборка.ОперацияId <> Связь.ОперацияId Тогда
                ВызватьИсключение "STAGE1_LINK_CONFLICT";
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;
КонецПроцедуры
