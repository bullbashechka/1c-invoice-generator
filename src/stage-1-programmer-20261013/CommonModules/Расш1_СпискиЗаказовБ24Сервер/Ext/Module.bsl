// Общая логика двух штатных списков. Не изменяет запрос списка и данные базы.
Процедура ПодготовитьФорму(Форма) Экспорт
    Если Форма.Элементы.Найти("Расш1_ЗадачаБ24") <> Неопределено Тогда Возврат; КонецЕсли;

    // Якорь — Клиент, а не Приоритет: порядок штатных колонок в формах различается.
    СледующаяКолонка = Неопределено;
    КлиентНайден = Ложь;
    Для Каждого Элемент Из Форма.Элементы.Список.ПодчиненныеЭлементы Цикл
        Если КлиентНайден Тогда СледующаяКолонка = Элемент; Прервать; КонецЕсли;
        КлиентНайден = Элемент.Имя = "СписокПартнер";
    КонецЦикла;
    Если Не КлиентНайден Тогда ВызватьИсключение "В списке заказов отсутствует колонка Клиент."; КонецЕсли;

    ПолеЗадачи = Неопределено;
    Для Каждого Поле Из Форма["Список"].ВычисляемыеПоля Цикл
        Если Поле.ПутьКДанным = "Расш1_ЗадачаId" Тогда ПолеЗадачи = Поле; Прервать; КонецЕсли;
    КонецЦикла;
    Если ПолеЗадачи = Неопределено Тогда
        ПолеЗадачи = Форма["Список"].ВычисляемыеПоля.Добавить();
        ПолеЗадачи.ПутьКДанным = "Расш1_ЗадачаId";
    КонецЕсли;
    ПолеЗадачи.Выражение = """""";
    ПолеЗадачи.ТипЗначения = Новый ОписаниеТипов("Строка");
    ПолеЗадачи.Заголовок = "Задача Б24";
    ПолеЗадачи.ОграничениеИспользования.Условие = Истина;
    ПолеЗадачи.ОграничениеИспользования.Порядок = Истина;
    ПолеЗадачи.ОграничениеИспользования.Группировка = Истина;

    Колонка = Форма.Элементы.Вставить("Расш1_ЗадачаБ24", Тип("ПолеФормы"), Форма.Элементы.Список, СледующаяКолонка);
    Колонка.Вид = ВидПоляФормы.ПолеНадписи;
    Колонка.ПутьКДанным = "Список.Расш1_ЗадачаId";
    Колонка.Заголовок = "Задача Б24";
    Колонка.ТолькоПросмотр = Истина;
    Колонка.Гиперссылка = Ложь;
    Колонка.Ширина = 15;
КонецПроцедуры

Процедура ЗаполнитьСтроки(Строки) Экспорт
    Ключи = Строки.ПолучитьКлючи();
    Если Ключи.Количество() = 0 Тогда Возврат; КонецЕсли;
    Связи = Новый Соответствие;
    Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ Связи.Заказ, Связи.ЗадачаId
        |ИЗ РегистрСведений.Расш1_СвязиЗаказовБ24 КАК Связи
        |ГДЕ Связи.Заказ В (&Заказы)");
    Запрос.УстановитьПараметр("Заказы", Ключи);
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Связи.Вставить(Выборка.Заказ, Выборка.ЗадачаId);
    КонецЦикла;
    Для Каждого Ключ Из Ключи Цикл
        Связь = Связи.Получить(Ключ);
        ТекстЗадачи = ""; ЗначениеСвязи = "";
        Если Связь <> Неопределено И Не ПустаяСтрока(Связь) Тогда
            ТекстЗадачи = "Задача №" + Связь;
            ЗначениеСвязи = Связь;
        КонецЕсли;
        СтрокаСписка = Строки.Получить(Ключ);
        СтрокаСписка.Данные.Расш1_ЗадачаId = ЗначениеСвязи;
        ОформлениеЗадачи = СтрокаСписка.Оформление.Получить("Расш1_ЗадачаId");
        ОформлениеЗадачи.УстановитьЗначениеПараметра("Текст", ТекстЗадачи);
    КонецЦикла;
КонецПроцедуры
