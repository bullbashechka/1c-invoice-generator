// Модуль управляемой формы Открытие_b24.
// Для КА Казахстан 2.4.5.18: стандартная форма ЗаказКлиента вызывает
// Оповестить("Запись_ЗаказКлиента", ПараметрыЗаписи, Объект.Ссылка)
// в клиентском ПослеЗаписи, после успешной записи документа.
// Обработка должна оставаться открытой в том же сеансе пользователя.

&НаКлиенте
Процедура ПриОткрытии(Отказ)
    ЭтаФорма.Заголовок = "Автооткрытие задач Б24 — обработка активна";
    Статус = "Ожидание успешного проведения и закрытия заказа клиента";
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

    Если Не НужноОткрытьБ24(ИмяСобытия, Параметр, Источник) Тогда
        Возврат;
    КонецЕсли;

    Попытка
        ПерейтиПоНавигационнойСсылке(
            "https://toofirmagem.bitrix24.kz/company/personal/user/30/tasks/task/edit/0/");
        ОткрытийБ24 = ОткрытийБ24 + 1;
        Статус = "Открыта форма задачи Б24. Заказ: " + Строка(Источник);
    Исключение
        Статус = "Заказ проведён, но открыть Б24 не удалось: " + ОписаниеОшибки();
        Сообщить(Статус);
    КонецПопытки;

КонецПроцедуры

&НаКлиенте
Функция НужноОткрытьБ24(ИмяСобытия, Параметр, Источник) Экспорт

    Перем РежимЗаписи, ПринудительноЗакрытьФорму;

    Если ИмяСобытия <> "Запись_ЗаказКлиента" Тогда
        Возврат Ложь;
    КонецЕсли;

    Если ТипЗнч(Параметр) <> Тип("Структура") Тогда
        Возврат Ложь;
    КонецЕсли;

    Если ТипЗнч(Источник) <> Тип("ДокументСсылка.ЗаказКлиента") Тогда
        Возврат Ложь;
    КонецЕсли;

    Если Не ЗначениеЗаполнено(Источник) Тогда
        Возврат Ложь;
    КонецЕсли;

    Если Не Параметр.Свойство("РежимЗаписи", РежимЗаписи) Тогда
        Возврат Ложь;
    КонецЕсли;

    Если Не Параметр.Свойство("ПринудительноЗакрытьФорму", ПринудительноЗакрытьФорму) Тогда
        Возврат Ложь;
    КонецЕсли;

    Возврат РежимЗаписи = РежимЗаписиДокумента.Проведение
        И ПринудительноЗакрытьФорму = Истина;

КонецФункции
